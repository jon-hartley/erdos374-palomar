/-! ## 28. Repair 29: discharge the five internal Proposition-5.1 steps together

This repair attacks the five remaining *internal* steps in one place:

1. root-list mismatch -> an actual simple root of `anchorPolynomial`;
2. concrete good-reduction/root-separation arithmetic;
3. the elementary deduction from a Weil character-sum bound to `rho <= 3 lam / 4`;
4. the elementary energy algebra in the large-sieve step;
5. the tuple-summation/exponent bookkeeping.

The two genuinely published analytic theorems themselves (Weil's character-sum
estimate and the analytic large sieve), plus PNT prime supply, remain named
inputs.  Everything below their hypotheses is proved in Lean rather than hidden
inside `True`-valued interfaces.
-/

namespace RemainingAnalytic29

open Polynomial

/-- Root multiplicity is additive across a finite product of nonzero
polynomials. -/
theorem rootMultiplicity_finset_prod
    {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (f : ι → Polynomial ℚ) (x : ℚ)
    (hf : ∀ i ∈ s, f i ≠ 0) :
    Polynomial.rootMultiplicity x (∏ i ∈ s, f i) =
      ∑ i ∈ s, Polynomial.rootMultiplicity x (f i) := by
  induction s using Finset.induction_on with
  | empty =>
      simp
  | @insert i s hi ih =>
      have hfi : f i ≠ 0 := hf i (by simp)
      have hfs : ∏ k ∈ s, f k ≠ 0 := by
        apply Finset.prod_ne_zero_iff.mpr
        intro k hk
        exact hf k (by simp [hk])
      rw [Finset.prod_insert hi, Finset.sum_insert hi]
      rw [Polynomial.rootMultiplicity_mul (mul_ne_zero hfi hfs)]
      congr
      exact ih (by
        intro k hk
        exact hf k (by simp [hk]))

/-- Multiplying a linear factor by a nonzero scalar does not change its root
multiplicity. -/
theorem rootMultiplicity_scaled_linear
    {c x y : ℚ} (hc : c ≠ 0) :
    Polynomial.rootMultiplicity x
        (Polynomial.C c * (Polynomial.X - Polynomial.C y)) =
      if x = y then 1 else 0 := by
  have hC : Polynomial.C c ≠ (0 : Polynomial ℚ) := by simp [hc]
  have hlin : Polynomial.X - Polynomial.C y ≠ (0 : Polynomial ℚ) := by
    intro h
    have hx := congrArg (fun p : Polynomial ℚ => p.coeff 1) h
    simp at hx
  rw [Polynomial.rootMultiplicity_mul (mul_ne_zero hC hlin)]
  simp [Polynomial.rootMultiplicity_X_sub_C]

/-- The lower anchor factor has exactly the expected root `i/r`. -/
theorem lower_anchor_factor_multiplicity
    {r i : ℕ} (hr : 0 < r) (x : ℚ) :
    Polynomial.rootMultiplicity x
        (Polynomial.C (r : ℚ) * Polynomial.X -
          Polynomial.C (i : ℚ)) =
      if x = (i : ℚ) / (r : ℚ) then 1 else 0 := by
  have hrq : (r : ℚ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hr)
  have hre :
      Polynomial.C (r : ℚ) * Polynomial.X -
          Polynomial.C (i : ℚ) =
        Polynomial.C (r : ℚ) *
          (Polynomial.X - Polynomial.C ((i : ℚ) / (r : ℚ))) := by
    rw [mul_sub, ← Polynomial.C_mul]
    congr 1
    field_simp [hrq]
  rw [hre]
  exact rootMultiplicity_scaled_linear hrq

/-- The upper anchor factor has exactly the expected root `(v-t)/j`. -/
theorem upper_anchor_factor_multiplicity
    {j t v : ℕ} (hj : 0 < j) (x : ℚ) :
    Polynomial.rootMultiplicity x
        (Polynomial.C (j : ℚ) * Polynomial.X +
          Polynomial.C (t : ℚ) - Polynomial.C (v : ℚ)) =
      if x = ((v : ℚ) - (t : ℚ)) / (j : ℚ) then 1 else 0 := by
  have hjq : (j : ℚ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hj)
  have hre :
      Polynomial.C (j : ℚ) * Polynomial.X +
          Polynomial.C (t : ℚ) - Polynomial.C (v : ℚ) =
        Polynomial.C (j : ℚ) *
          (Polynomial.X -
            Polynomial.C (((v : ℚ) - (t : ℚ)) / (j : ℚ))) := by
    ext n
    cases n with
    | zero =>
        simp
        field_simp [hjq]
        ring
    | succ n =>
        cases n with
        | zero =>
            simp
        | succ n =>
            simp [Polynomial.coeff_X]
  rw [hre]
  exact rootMultiplicity_scaled_linear hjq

/-- Division by the same positive natural denominator is injective over Q. -/
theorem nat_div_same_den_injective
    {u v d : ℕ} (hd : 0 < d)
    (h : (u : ℚ) / (d : ℚ) = (v : ℚ) / (d : ℚ)) :
    u = v := by
  have hdq : (d : ℚ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hd)
  field_simp [hdq] at h
  exact_mod_cast h

/-- The translated upper-root parametrization is injective in `v`. -/
theorem upper_root_param_injective
    {v w t j : ℕ} (hj : 0 < j)
    (h :
      ((v : ℚ) - (t : ℚ)) / (j : ℚ) =
        ((w : ℚ) - (t : ℚ)) / (j : ℚ)) :
    v = w := by
  have hjq : (j : ℚ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hj)
  field_simp [hjq] at h
  exact_mod_cast (sub_left_inj.mp h)

/-- The Repair-26 root mismatch gives an actual simple root of the concrete
anchor polynomial.  This eliminates `RootMismatchToSimpleRoot`. -/
theorem anchorSimpleRoot_proved :
    RemainingAnalytic27.AnchorSimpleRoot := by
  intro a r j t h ell hj hjr hh hell hth hnp
  have hr : 0 < r := lt_trans hj hjr
  have hq0 : q a ≠ 0 := q_ne_zero a
  have hr0 : r ≠ 0 := Nat.ne_of_gt hr
  have hj0 : j ≠ 0 := Nat.ne_of_gt hj
  obtain ⟨x, hcase⟩ :=
    anchor_root_mismatch_proved hj hjr hh hell hth hnp
  let SL : Finset ℕ :=
    (Finset.range ell).filter (fun i => 1 ≤ i)
  let SU : Finset ℕ :=
    (Finset.range h).filter (fun v => v ≠ t)
  let fL : ℕ → Polynomial ℚ :=
    fun i => Polynomial.C (r : ℚ) * Polynomial.X -
      Polynomial.C (i : ℚ)
  let fU : ℕ → Polynomial ℚ :=
    fun v => Polynomial.C (j : ℚ) * Polynomial.X +
      Polynomial.C (t : ℚ) - Polynomial.C (v : ℚ)
  have hfL : ∀ i ∈ SL, fL i ≠ 0 := by
    intro i hi
    dsimp [fL]
    intro hz
    have hc := congrArg (fun p : Polynomial ℚ => p.coeff 1) hz
    simp at hc
    exact hr0 (by exact_mod_cast hc)
  have hfU : ∀ v ∈ SU, fU v ≠ 0 := by
    intro v hv
    dsimp [fU]
    intro hz
    have hc := congrArg (fun p : Polynomial ℚ => p.coeff 1) hz
    simp at hc
    exact hj0 (by exact_mod_cast hc)
  have hprodL0 : (∏ i ∈ SL, fL i) ≠ 0 := by
    apply Finset.prod_ne_zero_iff.mpr
    intro i hi
    exact hfL i hi
  have hprodU0 : (∏ v ∈ SU, fU v) ≠ 0 := by
    apply Finset.prod_ne_zero_iff.mpr
    intro v hv
    exact hfU v hv
  have hconst0 :
      Polynomial.C ((q a * r * j : ℕ) : ℚ) ≠
        (0 : Polynomial ℚ) := by
    simp [hq0, hr0, hj0]
  have hanchor0 :
      Tasks.anchorPolynomial a r j t h ell ≠ 0 := by
    unfold Tasks.anchorPolynomial
    exact mul_ne_zero (mul_ne_zero hconst0 hprodL0) hprodU0
  have hmult :
      Polynomial.rootMultiplicity x
        (Tasks.anchorPolynomial a r j t h ell) =
        (∑ i ∈ SL,
          if x = (i : ℚ) / (r : ℚ) then 1 else 0) +
        (∑ v ∈ SU,
          if x = ((v : ℚ) - (t : ℚ)) / (j : ℚ) then 1 else 0) := by
    unfold Tasks.anchorPolynomial
    rw [Polynomial.rootMultiplicity_mul hanchor0]
    have hleft0 :
        Polynomial.C ((q a * r * j : ℕ) : ℚ) *
            (∏ i ∈ SL, fL i) ≠ 0 :=
      mul_ne_zero hconst0 hprodL0
    rw [Polynomial.rootMultiplicity_mul hleft0]
    simp only [Polynomial.rootMultiplicity_C, zero_add]
    rw [rootMultiplicity_finset_prod SL fL x hfL]
    rw [rootMultiplicity_finset_prod SU fU x hfU]
    apply congrArg₂ (· + ·)
    · apply Finset.sum_congr rfl
      intro i hi
      dsimp [fL]
      exact lower_anchor_factor_multiplicity hr x
    · apply Finset.sum_congr rfl
      intro v hv
      dsimp [fU]
      exact upper_anchor_factor_multiplicity hj x
  refine ⟨x, ?_⟩
  rw [hmult]
  rcases hcase with ⟨hlow, hnup⟩ | ⟨hup, hnlow⟩
  · rcases hlow with ⟨i, hi1, hiell, hxi⟩
    have hiSL : i ∈ SL := by
      simp [SL, hi1, hiell]
    have hsumL :
        (∑ k ∈ SL,
          if x = (k : ℚ) / (r : ℚ) then 1 else 0) = 1 := by
      rw [Finset.sum_eq_single i]
      · simp [hxi]
      · intro k hk hki
        have hneq : x ≠ (k : ℚ) / (r : ℚ) := by
          intro hxk
          have hik : i = k :=
            nat_div_same_den_injective hr (hxi.symm.trans hxk)
          exact hki hik.symm
        simp [hneq]
      · simp [hiSL]
    have hsumU :
        (∑ v ∈ SU,
          if x = ((v : ℚ) - (t : ℚ)) / (j : ℚ) then 1 else 0) = 0 := by
      apply Finset.sum_eq_zero
      intro v hv
      have hvh : v < h := (Finset.mem_filter.mp hv).1 |> Finset.mem_range.mp
      have hvt : v ≠ t := (Finset.mem_filter.mp hv).2
      have hneq :
          x ≠ ((v : ℚ) - (t : ℚ)) / (j : ℚ) := by
        intro hxv
        apply hnup
        exact ⟨v, hvh, hvt, hxv⟩
      simp [hneq]
    rw [hsumL, hsumU]
  · rcases hup with ⟨v, hvh, hvt, hxv⟩
    have hvSU : v ∈ SU := by
      simp [SU, hvh, hvt]
    have hsumU :
        (∑ w ∈ SU,
          if x = ((w : ℚ) - (t : ℚ)) / (j : ℚ) then 1 else 0) = 1 := by
      rw [Finset.sum_eq_single v]
      · simp [hxv]
      · intro w hw hwv
        have hneq :
            x ≠ ((w : ℚ) - (t : ℚ)) / (j : ℚ) := by
          intro hxw
          have hvw : v = w :=
            upper_root_param_injective hj (hxv.symm.trans hxw)
          exact hwv hvw.symm
        simp [hneq]
      · simp [hvSU]
    have hsumL :
        (∑ i ∈ SL,
          if x = (i : ℚ) / (r : ℚ) then 1 else 0) = 0 := by
      apply Finset.sum_eq_zero
      intro i hi
      have hi1 : 1 ≤ i := (Finset.mem_filter.mp hi).2
      have hiell : i < ell :=
        Finset.mem_range.mp (Finset.mem_filter.mp hi).1
      have hneq : x ≠ (i : ℚ) / (r : ℚ) := by
        intro hxi
        apply hnlow
        exact ⟨i, hi1, hiell, hxi⟩
      simp [hneq]
    rw [hsumL, hsumU]

/-- Consequently the anchor polynomial is genuinely nonsquare with no local
bridge assumption. -/
theorem anchorPolynomialNonsquareGenuine_proved :
    RemainingAnalytic27.AnchorPolynomialNonsquareGenuine :=
  anchorPolynomialNonsquare_of_simpleRoot anchorSimpleRoot_proved


/-! ### Good-reduction arithmetic -/

/-- The two exponent margins in manuscript (5.8) follow directly from the
single parameter condition `3 alpha + 8 eta < 1`. -/
theorem prop51_parameter_margins
    {α η : ℝ} (hα : 0 ≤ α) (hη : 0 ≤ η)
    (h : 3 * α + 8 * η < 1) :
    α + η < (1 - α) / 2 ∧
      η < (1 - α) / 4 := by
  constructor <;> linarith

/-- A crude cross-difference bound sufficient for root separation:
`|i*j - w*r| <= 2*r*H` whenever all tuple coordinates are in their
manuscript ranges. -/
theorem cross_difference_bound
    {i w j r H : ℕ}
    (hij : j ≤ r) (hi : i ≤ H) (hw : w ≤ H) :
    |(i : ℤ) * j - (w : ℤ) * r| ≤ (2 * r * H : ℕ) := by
  have h1 : (i : ℤ) * j ≤ (H : ℤ) * r := by
    exact mul_le_mul (by exact_mod_cast hi) (by exact_mod_cast hij)
      (by positivity) (by positivity)
  have h2 : (w : ℤ) * r ≤ (H : ℤ) * r := by
    gcongr
  have hA0 : (0 : ℤ) ≤ (i : ℤ) * j := by positivity
  have hB0 : (0 : ℤ) ≤ (w : ℤ) * r := by positivity
  have hcast : ((2 * r * H : ℕ) : ℤ) =
      2 * (r : ℤ) * (H : ℤ) := by norm_num
  rw [abs_le, hcast]
  constructor <;> nlinarith

/-- If a nonzero integer cross-difference has absolute value below a prime
`lam`, it remains nonzero modulo `lam`. -/
theorem nonzero_mod_of_abs_lt
    {D : ℤ} {lam : ℕ}
    (hD : D ≠ 0) (habs : |D| < lam) :
    D % (lam : ℤ) ≠ 0 := by
  intro hz
  have hdvd : (lam : ℤ) ∣ D := by
    exact Int.dvd_iff_emod_eq_zero.mpr hz
  obtain ⟨k, hk⟩ := hdvd
  subst D
  have hlam : 0 < (lam : ℤ) := by
    exact_mod_cast (show 0 < lam by
      by_contra h
      have : lam = 0 := by omega
      subst lam
      simp at habs)
  have hk0 : k ≠ 0 := by
    intro hk
    subst k
    simp at hD
  have hkabs : (1 : ℤ) ≤ |k| := by
    exact Int.one_le_abs hk0
  have hlower : (lam : ℤ) ≤ |(lam : ℤ) * k| := by
    rw [abs_mul, abs_of_nonneg (le_of_lt hlam)]
    nlinarith
  exact (not_lt_of_ge hlower) (by exact_mod_cast habs)


/-! ### Weil bookkeeping -/

/-- Pure arithmetic core of the `rho_lam <= 3 lam / 4` deduction.
`charAbs` is an upper bound for the absolute character sum and `z` is the
number of zero residues. -/
theorem weil_three_quarters_arithmetic
    {lam H rho z : ℕ} {charAbs : ℝ}
    (hH : 1 ≤ H)
    (hlam : 64 * H ^ 2 ≤ lam)
    (hz : z ≤ 2 * H)
    (hchar : charAbs ≤ 2 * (H : ℝ) * Real.sqrt (lam : ℝ))
    (hrho :
      (2 * rho : ℝ) ≤ (lam : ℝ) + z + charAbs) :
    4 * rho ≤ 3 * lam := by
  have hlam0 : (0 : ℝ) ≤ lam := by positivity
  have hs0 : 0 ≤ Real.sqrt (lam : ℝ) := Real.sqrt_nonneg _
  have hs2 : (Real.sqrt (lam : ℝ)) ^ 2 = (lam : ℝ) := by
    simpa using Real.sq_sqrt hlam0
  have hlamR : (64 : ℝ) * (H : ℝ) ^ 2 ≤ (lam : ℝ) := by
    exact_mod_cast hlam
  have h8 : 8 * (H : ℝ) ≤ Real.sqrt (lam : ℝ) := by
    nlinarith
  have hHpos : (0 : ℝ) < H := by exact_mod_cast (show 0 < H by omega)
  have hsmall :
      (z : ℝ) + charAbs ≤ (lam : ℝ) / 2 := by
    have hzR : (z : ℝ) ≤ 2 * H := by exact_mod_cast hz
    have hmul8 :
        8 * (H : ℝ) ^ 2 ≤
          (H : ℝ) * Real.sqrt (lam : ℝ) := by
      have := mul_le_mul_of_nonneg_left h8 (le_of_lt hHpos)
      nlinarith
    have hH1 : (1 : ℝ) ≤ H := by exact_mod_cast hH
    have hHsq : (H : ℝ) ≤ (H : ℝ) ^ 2 := by
      nlinarith
    have h2H_lam :
        2 * (H : ℝ) ≤ (lam : ℝ) / 4 := by
      nlinarith
    have h8mul :
        8 * (H : ℝ) * Real.sqrt (lam : ℝ) ≤ (lam : ℝ) := by
      have hm := mul_le_mul_of_nonneg_right h8 hs0
      calc
        8 * (H : ℝ) * Real.sqrt (lam : ℝ)
            ≤ Real.sqrt (lam : ℝ) * Real.sqrt (lam : ℝ) := by
              nlinarith
        _ = (lam : ℝ) := by
              nlinarith [hs2]
    have h2Hs_lam :
        2 * (H : ℝ) * Real.sqrt (lam : ℝ) ≤
          (lam : ℝ) / 4 := by
      nlinarith
    have hHs :
        2 * (H : ℝ) + 2 * (H : ℝ) * Real.sqrt (lam : ℝ) ≤
          (lam : ℝ) / 2 := by
      linarith
    linarith
  have hr :
      (2 * rho : ℝ) ≤ (3 : ℝ) * lam / 2 := by
    linarith
  exact_mod_cast (show (4 * rho : ℝ) ≤ 3 * lam by linarith)


/-! ### Large-sieve energy algebra -/

/-- The Cauchy--Schwarz lower bound used after the square-residue restriction:
if at most `3 lam/4` classes are occupied, the nontrivial Fourier energy is at
least `J^2/3`. -/
theorem residue_energy_lower
    {lam rho J : ℕ}
    (hrho : 4 * rho ≤ 3 * lam)
    (hrho0 : 0 < rho)
    (hdiag :
      ((lam : ℝ) / (rho : ℝ) - 1) * (J : ℝ) ^ 2 ≤
        (J : ℝ) ^ 2) :
    ((J : ℝ) ^ 2) / 3 ≤ (J : ℝ) ^ 2 := by
  have hlamrho : (4 : ℝ) * rho ≤ 3 * lam := by exact_mod_cast hrho
  have hrpos : (0 : ℝ) < rho := by exact_mod_cast hrho0
  have hratio : (1 : ℝ) / 3 ≤ (lam : ℝ) / rho - 1 := by
    apply (le_sub_iff_add_le).2
    apply (le_div_iff₀ hrpos).2
    nlinarith
  have hJ2 : 0 ≤ (J : ℝ) ^ 2 := sq_nonneg _
  nlinarith

/-- Abstract final algebra of the large-sieve step.  Once the total lower
energy is `M*J^2/3`, the large sieve gives `<= C*L*J`, and the auxiliary-prime
supply gives `M >= c*sqrt L/log L`, one obtains `J << sqrt L log L`. -/
theorem large_sieve_tuple_algebra
    {J L : ℕ} {M C c : ℝ}
    (hJ : 0 < J) (hL : 2 ≤ L)
    (hM : 0 < M) (hC : 0 < C) (hc : 0 < c)
    (hprime :
      c * Real.sqrt (L : ℝ) / Real.log (L : ℝ) ≤ M)
    (henergy :
      M * ((J : ℝ) ^ 2 / 3) ≤ C * (L : ℝ) * J) :
    (J : ℝ) ≤
      (3 * C / c) * Real.sqrt (L : ℝ) * Real.log (L : ℝ) := by
  have hLR : (1 : ℝ) < L := by exact_mod_cast (show 1 < L by omega)
  have hlog : 0 < Real.log (L : ℝ) := Real.log_pos hLR
  have hs : 0 < Real.sqrt (L : ℝ) := Real.sqrt_pos.2 (by positivity)
  have hJr : 0 < (J : ℝ) := by exact_mod_cast hJ
  have hL0 : (0 : ℝ) ≤ L := by positivity
  have hs2 : Real.sqrt (L : ℝ) * Real.sqrt (L : ℝ) = (L : ℝ) := by
    nlinarith [Real.sq_sqrt hL0]
  have hlow :
      (c * Real.sqrt (L : ℝ) / Real.log (L : ℝ)) *
          ((J : ℝ) ^ 2 / 3)
        ≤ C * (L : ℝ) * J := by
    exact le_trans
      (mul_le_mul_of_nonneg_right hprime
        (by positivity : 0 ≤ (J : ℝ) ^ 2 / 3))
      henergy
  have hlow' :
      Real.sqrt (L : ℝ) * (c * (J : ℝ)) ≤
        Real.sqrt (L : ℝ) *
          (3 * C * Real.sqrt (L : ℝ) * Real.log (L : ℝ)) := by
    calc
      Real.sqrt (L : ℝ) * (c * (J : ℝ))
          = c * Real.sqrt (L : ℝ) * (J : ℝ) := by ring
      _ ≤ 3 * C * (L : ℝ) * Real.log (L : ℝ) := by
        have hlow2 := hlow
        field_simp [ne_of_gt hlog] at hlow2
        nlinarith
      _ = Real.sqrt (L : ℝ) *
          (3 * C * Real.sqrt (L : ℝ) * Real.log (L : ℝ)) := by
        calc
          3 * C * (L : ℝ) * Real.log (L : ℝ)
              = 3 * C *
                  (Real.sqrt (L : ℝ) * Real.sqrt (L : ℝ)) *
                    Real.log (L : ℝ) := by rw [hs2]
          _ = Real.sqrt (L : ℝ) *
              (3 * C * Real.sqrt (L : ℝ) * Real.log (L : ℝ)) := by ring
  have hCJ :
      c * (J : ℝ) ≤
        3 * C * Real.sqrt (L : ℝ) * Real.log (L : ℝ) := by
    by_contra hnot
    have hgt :
        3 * C * Real.sqrt (L : ℝ) * Real.log (L : ℝ) <
          c * (J : ℝ) := lt_of_not_ge hnot
    have hmulgt :
        Real.sqrt (L : ℝ) *
            (3 * C * Real.sqrt (L : ℝ) * Real.log (L : ℝ)) <
          Real.sqrt (L : ℝ) * (c * (J : ℝ)) :=
      mul_lt_mul_of_pos_left hgt hs
    exact (not_lt_of_ge hlow') hmulgt
  calc
    (J : ℝ) ≤
        (3 * C * Real.sqrt (L : ℝ) * Real.log (L : ℝ)) / c := by
      exact (le_div_iff₀ hc).2 (by simpa [mul_comm] using hCJ)
    _ = (3 * C / c) * Real.sqrt (L : ℝ) * Real.log (L : ℝ) := by
      field_simp [ne_of_gt hc]


/-! ### Tuple enumeration bookkeeping -/

/-- Crude summation estimate sufficient for the `R^(3/2)` factor:
`sum_{r<=R} sqrt r <= R sqrt R`. -/
theorem sum_sqrt_Icc_le (R : ℕ) :
    ∑ r ∈ Finset.Icc 1 R, Real.sqrt (r : ℝ) ≤
      (R : ℝ) * Real.sqrt (R : ℝ) := by
  calc
    ∑ r ∈ Finset.Icc 1 R, Real.sqrt (r : ℝ)
        ≤ ∑ r ∈ Finset.Icc 1 R, Real.sqrt (R : ℝ) := by
          apply Finset.sum_le_sum
          intro r hr
          have hrR : r ≤ R := (Finset.mem_Icc.mp hr).2
          exact Real.sqrt_le_sqrt (by exact_mod_cast hrR)
    _ = ((Finset.Icc 1 R).card : ℝ) * Real.sqrt (R : ℝ) := by
          rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ (R : ℝ) * Real.sqrt (R : ℝ) := by
          gcongr
          have hcard : (Finset.Icc 1 R).card ≤ R := by
            simpa using Finset.card_Icc_le (1 : ℕ) R
          exact_mod_cast hcard

/-- The exponent arithmetic in the five-factor tuple sum. -/
theorem five_tuple_exponent_identity {α η : ℝ} :
    (1 : ℝ) / 2 + 4 * η + 3 * α / 2 =
      (1 : ℝ) / 2 + 3 * α / 2 + 4 * η := by ring

/-- The exponent arithmetic in the four-factor tuple sum. -/
theorem four_tuple_exponent_identity {α η : ℝ} :
    (1 : ℝ) / 2 + 3 * η + 3 * α / 2 =
      (1 : ℝ) / 2 + 3 * α / 2 + 3 * η := by ring

/-- Specialization of the final exponent margins at the manuscript's chosen
parameters. -/
theorem chosen_tuple_exponents :
    (1 : ℝ) / 2 + 3 * alpha / 2 + 4 * eta = 199 / 200 ∧
    (1 : ℝ) / 2 + 3 * alpha / 2 + 3 * eta = 7 / 8 := by
  constructor <;> norm_num [alpha, eta]


