/-- Inner code space for fixed `r,a`. -/
def codesAtRA (X H r a : ℕ) : Finset FourCode :=
  (jChoices r).biUnion fun j =>
    (Finset.Icc 1 H).biUnion fun h =>
      (Finset.range h).biUnion fun t =>
        (ellChoices H h).biUnion fun ell =>
          (RemainingAnalytic28.AnchorSquareArgs
            a r j t h ell (X / r)).image fun P =>
              { r := r, j := j, h := h, t := t, ell := ell, P := P }

/-- Uniform fixed-`r,a` code count from the one-tuple large sieve. -/
theorem codesAtRA_card_le
    {X H r a : ℕ} {K : ℝ}
    (hX : 1 ≤ X)
    (hr1 : 1 ≤ r) (hrX : r ≤ X)
    (hK : 0 ≤ K)
    (hTuple :
      ∀ j t h ell : ℕ,
        0 < j → j < r → 0 < h → 0 < ell → t < h →
        (h ≠ 1 ∨ ell ≠ 1) →
        (RemainingAnalytic28.AnchorSquareArgCount
          a r j t h ell (X / r) : ℝ) ≤
          K * Real.sqrt ((X : ℝ) / (r : ℝ)) * Real.log (X : ℝ)) :
    ((codesAtRA X H r a).card : ℝ) ≤
      (r : ℝ) * (H : ℝ) ^ 3 *
        (K * Real.sqrt ((X : ℝ) / (r : ℝ)) * Real.log (X : ℝ)) := by
  let B : ℝ :=
    K * Real.sqrt ((X : ℝ) / (r : ℝ)) * Real.log (X : ℝ)
  have hB0 : 0 ≤ B := by
    dsimp [B]
    have hlog0 : 0 ≤ Real.log (X : ℝ) := Real.log_natCast_nonneg X
    exact mul_nonneg
      (mul_nonneg hK (Real.sqrt_nonneg _)) hlog0
  have hell :
      ∀ j ∈ jChoices r, ∀ h ∈ Finset.Icc 1 H, ∀ t ∈ Finset.range h,
        (((ellChoices H h).biUnion fun ell =>
          (RemainingAnalytic28.AnchorSquareArgs
            a r j t h ell (X / r)).image fun P =>
              ({ r := r, j := j, h := h, t := t, ell := ell, P := P } :
                FourCode)).card : ℝ)
          ≤ (H : ℝ) * B := by
    intro j hj h hh t ht
    have h1 :=
      card_biUnion_cast_le_card_mul
        (ellChoices H h)
        (fun ell =>
          (RemainingAnalytic28.AnchorSquareArgs
            a r j t h ell (X / r)).image fun P =>
              ({ r := r, j := j, h := h, t := t, ell := ell, P := P } :
                FourCode))
        B
        (by
          intro ell hellmem
          have hj' := Finset.mem_filter.mp hj
          have hh' := Finset.mem_Icc.mp hh
          have ht' := Finset.mem_range.mp ht
          have hell' := Finset.mem_filter.mp hellmem
          have hellI := Finset.mem_Icc.mp hell'.1
          have hcount :=
            hTuple j t h ell
              (by exact Nat.succ_le_iff.mp hj'.2)
              (Finset.mem_range.mp hj'.1)
              (by exact Nat.succ_le_iff.mp hh'.1)
              (by exact Nat.succ_le_iff.mp hellI.1)
              ht' hell'.2
          calc
            (((RemainingAnalytic28.AnchorSquareArgs
                a r j t h ell (X / r)).image fun P =>
                  ({ r := r, j := j, h := h, t := t, ell := ell, P := P } :
                    FourCode)).card : ℝ)
                ≤ (RemainingAnalytic28.AnchorSquareArgCount
                    a r j t h ell (X / r) : ℝ) := by
                  unfold RemainingAnalytic28.AnchorSquareArgCount
                  exact card_image_cast_le _ _
            _ ≤ B := by simpa [B] using hcount)
    have hc : ((ellChoices H h).card : ℝ) ≤ (H : ℝ) := by
      exact_mod_cast ellChoices_card_le H h
    calc
      _ ≤ ((ellChoices H h).card : ℝ) * B := h1
      _ ≤ (H : ℝ) * B := mul_le_mul_of_nonneg_right hc hB0
  have ht :
      ∀ j ∈ jChoices r, ∀ h ∈ Finset.Icc 1 H,
        (((Finset.range h).biUnion fun t =>
          (ellChoices H h).biUnion fun ell =>
            (RemainingAnalytic28.AnchorSquareArgs
              a r j t h ell (X / r)).image fun P =>
                ({ r := r, j := j, h := h, t := t, ell := ell, P := P } :
                  FourCode)).card : ℝ)
          ≤ (H : ℝ) ^ 2 * B := by
    intro j hj h hh
    have h1 :=
      card_biUnion_cast_le_card_mul
        (Finset.range h)
        (fun t =>
          (ellChoices H h).biUnion fun ell =>
            (RemainingAnalytic28.AnchorSquareArgs
              a r j t h ell (X / r)).image fun P =>
                ({ r := r, j := j, h := h, t := t, ell := ell, P := P } :
                  FourCode))
        ((H : ℝ) * B)
        (fun t htmem => hell j hj h hh t htmem)
    have hhH : (h : ℝ) ≤ (H : ℝ) := by
      exact_mod_cast (Finset.mem_Icc.mp hh).2
    calc
      _ ≤ (h : ℝ) * ((H : ℝ) * B) := by simpa using h1
      _ ≤ (H : ℝ) * ((H : ℝ) * B) := by gcongr
      _ = (H : ℝ) ^ 2 * B := by ring
  have hh :
      ∀ j ∈ jChoices r,
        (((Finset.Icc 1 H).biUnion fun h =>
          (Finset.range h).biUnion fun t =>
            (ellChoices H h).biUnion fun ell =>
              (RemainingAnalytic28.AnchorSquareArgs
                a r j t h ell (X / r)).image fun P =>
                  ({ r := r, j := j, h := h, t := t, ell := ell, P := P } :
                    FourCode)).card : ℝ)
          ≤ (H : ℝ) ^ 3 * B := by
    intro j hj
    have h1 :=
      card_biUnion_cast_le_card_mul
        (Finset.Icc 1 H)
        (fun h =>
          (Finset.range h).biUnion fun t =>
            (ellChoices H h).biUnion fun ell =>
              (RemainingAnalytic28.AnchorSquareArgs
                a r j t h ell (X / r)).image fun P =>
                  ({ r := r, j := j, h := h, t := t, ell := ell, P := P } :
                    FourCode))
        ((H : ℝ) ^ 2 * B)
        (fun h hhmem => ht j hj h hhmem)
    have hcard : ((Finset.Icc 1 H).card : ℝ) ≤ (H : ℝ) := by
      exact_mod_cast Icc_one_card_le H
    calc
      _ ≤ ((Finset.Icc 1 H).card : ℝ) * ((H : ℝ) ^ 2 * B) := h1
      _ ≤ (H : ℝ) * ((H : ℝ) ^ 2 * B) := by gcongr
      _ = (H : ℝ) ^ 3 * B := by ring
  have hjb :=
    card_biUnion_cast_le_card_mul
      (jChoices r)
      (fun j =>
        (Finset.Icc 1 H).biUnion fun h =>
          (Finset.range h).biUnion fun t =>
            (ellChoices H h).biUnion fun ell =>
              (RemainingAnalytic28.AnchorSquareArgs
                a r j t h ell (X / r)).image fun P =>
                  ({ r := r, j := j, h := h, t := t, ell := ell, P := P } :
                    FourCode))
      ((H : ℝ) ^ 3 * B)
      hh
  have hjcard : ((jChoices r).card : ℝ) ≤ (r : ℝ) := by
    exact_mod_cast jChoices_card_le r
  calc
    _ ≤ ((jChoices r).card : ℝ) * ((H : ℝ) ^ 3 * B) := hjb
    _ ≤ (r : ℝ) * ((H : ℝ) ^ 3 * B) := by gcongr
    _ = (r : ℝ) * (H : ℝ) ^ 3 *
        (K * Real.sqrt ((X : ℝ) / (r : ℝ)) * Real.log (X : ℝ)) := by
          simp [B, mul_assoc]

/-- Four-factor full code-space count. -/
theorem fourCodes_card_le
    {X R H : ℕ} {K : ℝ}
    (hX : 1 ≤ X)
    (hK : 0 ≤ K)
    (hTuple :
      ∀ r j t h ell : ℕ,
        1 ≤ r → r ≤ X →
        0 < j → j < r → 0 < h → 0 < ell → t < h →
        (h ≠ 1 ∨ ell ≠ 1) →
        (RemainingAnalytic28.AnchorSquareArgCount
          0 r j t h ell (X / r) : ℝ) ≤
          K * Real.sqrt ((X : ℝ) / (r : ℝ)) * Real.log (X : ℝ)) :
    ((fourCodes X R H).card : ℝ) ≤
      K * (∑ r ∈ Finset.Icc 1 R,
        (r : ℝ) * (H : ℝ) ^ 3 *
          (Real.sqrt ((X : ℝ) / (r : ℝ)) * Real.log (X : ℝ))) := by
  let rs := (Finset.Icc 1 R).filter (fun r => r ≤ X)
  have houter :=
    card_biUnion_cast_le_sum
      rs
      (fun r => codesAtRA X H r 0)
  have hchild :
      ∀ r ∈ rs,
        ((codesAtRA X H r 0).card : ℝ) ≤
          (r : ℝ) * (H : ℝ) ^ 3 *
            (K * Real.sqrt ((X : ℝ) / (r : ℝ)) * Real.log (X : ℝ)) := by
    intro r hr
    have hr' := Finset.mem_filter.mp hr
    have hrI := Finset.mem_Icc.mp hr'.1
