/-! ## 23. Repair 25: sparse Lemma 4.1 from the selected-prime family

The manuscript's sparse analysis (§§4.2--4.4) uses smooth cutoffs and the
reciprocal-prime theorem to select primes p in [P,2P] for which the lower
interval contains exactly one p-factor.  This repair moves the formalization
boundary down to that finite selected-prime family.  Lean constructs the
squarefree witness R itself and proves that divisibility without p^2-divisibility
is exactly the valuation-one condition needed by Lemma 4.1.
-/

namespace RemainingAnalytic25

/-- Exact finite output required from the sparse smooth-cutoff / reciprocal-prime
argument.  The analytic work selects a finite family of primes; the remaining
conversion to the integer witness R is performed below in Lean. -/
def SparseSelectedPrimeFamily : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 1 → ∃ X₀ : ℕ,
    ∀ X a b c : ℕ, X₀ ≤ X → a < b → b < c → c ≤ X →
      (X : ℝ) ^ γ ≤ ((c - b : ℕ) : ℝ) →
      (a : ℝ) ≤ 10 * ((c - b : ℕ) : ℝ) * Real.log (X : ℝ) →
      100 * ((c - b : ℕ) : ℝ) * (Real.log (X : ℝ)) ^ 2 < (b : ℝ) →
      ∃ S : Finset ℕ,
        0 < ∏ p ∈ S, p ∧
        ((c - b : ℕ) : ℝ) / 1280 ≤
          Real.log ((∏ p ∈ S, p : ℕ) : ℝ) ∧
        ∀ p : ℕ, p ∈ S →
          p.Prime ∧ a < p ∧ p ∣ falling (c - b) c ∧
            ¬ p ^ 2 ∣ falling (c - b) c

end RemainingAnalytic25

/-- A finite product of distinct primes is squarefree. -/
theorem squarefree_finset_prod_primes
    {S : Finset ℕ} (hprime : ∀ p : ℕ, p ∈ S → p.Prime) :
    Squarefree (∏ p ∈ S, p) := by
  apply Finset.squarefree_prod_of_pairwise_isCoprime
  · intro p hp r hr hpr
    have pp : p.Prime := hprime p hp
    have pr : r.Prime := hprime r hr
    exact Nat.coprime_iff_isRelPrime.mp ((Nat.coprime_primes pp pr).2 hpr)
  · intro p hp
    exact (hprime p hp).squarefree

/-- Every prime divisor of a product of a finite set of primes is one of the
selected primes. -/
theorem prime_mem_of_dvd_finset_prod_primes
    {S : Finset ℕ} {p : ℕ}
    (hp : p.Prime) (hprime : ∀ r : ℕ, r ∈ S → r.Prime)
    (hdiv : p ∣ ∏ r ∈ S, r) : p ∈ S := by
  have hpPrime : Prime p := (Nat.prime_iff).mp hp
  rcases (Prime.dvd_finsetProd_iff hpPrime id).mp hdiv with ⟨r, hr, hpr⟩
  have hrprime : r.Prime := hprime r hr
  have hpr_eq : p = r := (Nat.prime_dvd_prime_iff_eq hp hrprime).mp hpr
  subst r
  exact hr

/-- The finite selected-prime output of the reciprocal-prime argument produces
exactly the Repair-23 sparse witness. -/
theorem sparsePrimeWitness_from_selectedPrimeFamily
    (H : RemainingAnalytic25.SparseSelectedPrimeFamily) :
    RemainingAnalytic23.SparsePrimeWitness := by
  intro γ hγ0 hγ1
  obtain ⟨N, hN⟩ := H γ hγ0 hγ1
  refine ⟨N, ?_⟩
  intro X a b c hX hab hbc hcX hh ha hsparse
  obtain ⟨S, hRpos, hRlog, hSel⟩ :=
    hN X a b c hX hab hbc hcX hh ha hsparse
  let R : ℕ := ∏ p ∈ S, p
  have hprime : ∀ p : ℕ, p ∈ S → p.Prime := by
    intro p hpS
    exact (hSel p hpS).1
  have hRsf : Squarefree R := by
    dsimp [R]
    exact squarefree_finset_prod_primes hprime
  refine ⟨R, ?_, hRsf, ?_, ?_⟩
  · simpa [R] using hRpos
  · simpa [R] using hRlog
  · intro p hp hpR
    have hpS : p ∈ S := by
      apply prime_mem_of_dvd_finset_prod_primes hp hprime
      simpa [R] using hpR
    have hd := hSel p hpS
    exact ⟨hd.2.1, hd.2.2.1, hd.2.2.2⟩

/-- Hence the entire sparse branch of Lemma 4.1 follows from the selected-prime
family output.  The remaining hard input is now precisely the smooth-cutoff,
correlated-integral and reciprocal-prime transfer that constructs that family. -/
theorem sparseBranch_from_selectedPrimeFamily
    (H : RemainingAnalytic25.SparseSelectedPrimeFamily) :
    RemainingAnalytic19.ValuationOneMassSparse :=
  sparseBranch_from_primeWitness
    (sparsePrimeWitness_from_selectedPrimeFamily H)

