/-! ### Bottom-index algebra actually used in the corrected task -/

/-- In a five-factor representation the factorial squarefree kernel divides
the product of the two reduced interval factors. -/
theorem q_dvd_two_intervals_of_fiveRep
    {m a b c d : ℕ}
    (hr : FiveRep m a b c d) :
    q a ∣ falling (c - b) c * falling (m - d) m := by
  rcases hr with ⟨ha, hab, hbc, hcd, hdm, hs⟩
  have hsred :
      NatSquare
        (q a * falling (c - b) c * falling (m - d) m) :=
    (five_interval_reduction a b c d m ha hab hbc hcd hdm).mp hs
  have hsred' :
      NatSquare
        (q a * (falling (c - b) c * falling (m - d) m)) := by
    simpa only [mul_assoc] using hsred
  exact squarefree_dvd_other_of_square (q_squarefree a) hsred'

/-- Both reduced interval products are bounded by corresponding endpoint
powers. -/
theorem two_intervals_le_endpoint_pow
    {m b c d : ℕ}
    (hcm : c ≤ m) :
    falling (c - b) c * falling (m - d) m
      ≤ m ^ ((c - b) + (m - d)) := by
  have h1 := falling_le_pow (c - b) c
  have h2 := falling_le_pow (m - d) m
  have hcPow : c ^ (c - b) ≤ m ^ (c - b) :=
    Nat.pow_le_pow_left hcm _
  calc
    falling (c - b) c * falling (m - d) m
        ≤ c ^ (c - b) * m ^ (m - d) :=
          Nat.mul_le_mul h1 h2
    _ ≤ m ^ (c - b) * m ^ (m - d) :=
          Nat.mul_le_mul_right _ hcPow
    _ = m ^ ((c - b) + (m - d)) := by
          rw [← pow_add]

/-- Elementary upper bound for `q a` in a five-factor representation. -/
theorem q_le_endpoint_pow_of_fiveRep
    {m a b c d : ℕ}
    (hr : FiveRep m a b c d) :
    q a ≤ m ^ ((c - b) + (m - d)) := by
  have hqd := q_dvd_two_intervals_of_fiveRep hr
  have hcm : c ≤ m := by
    rcases hr with ⟨ha, hab, hbc, hcd, hdm, hs⟩
    omega
  have hprodpos :
      0 < falling (c - b) c * falling (m - d) m := by
    apply Nat.mul_pos
    · apply falling_pos_of_le
      omega
    · apply falling_pos_of_le
      omega
  exact (Nat.le_of_dvd hprodpos hqd).trans
    (two_intervals_le_endpoint_pow hcm)

/-- Once Lemma 3.1 applies at `a`, the five-factor bottom index satisfies
`a <= 3(h+ell) log m`. -/
theorem five_index_le_three_gaps_log
    {m a b c d : ℕ}
    (hm : 1 < m)
    (hr : FiveRep m a b c d)
    (hgrowth : Real.exp ((a : ℝ) / 3) ≤ (q a : ℝ)) :
    (a : ℝ) ≤
      3 * (((c - b) + (m - d) : ℕ) : ℝ) * Real.log (m : ℝ) := by
  have hqNat := q_le_endpoint_pow_of_fiveRep hr
  have hqR :
      (q a : ℝ) ≤
        (m : ℝ) ^ (((c - b) + (m - d) : ℕ)) := by
    exact_mod_cast hqNat
  have hexp :
      Real.exp ((a : ℝ) / 3) ≤
        (m : ℝ) ^ (((c - b) + (m - d) : ℕ)) :=
    hgrowth.trans hqR
  have hmpos : (0 : ℝ) < m := by
    exact_mod_cast (show 0 < m by omega)
  have hpowexp :
      (m : ℝ) ^ (((c - b) + (m - d) : ℕ)) =
        Real.exp
          ((((c - b) + (m - d) : ℕ) : ℝ) *
            Real.log (m : ℝ)) := by
    calc
      (m : ℝ) ^ (((c - b) + (m - d) : ℕ))
          =
        (Real.exp (Real.log (m : ℝ))) ^
          (((c - b) + (m - d) : ℕ)) := by
            rw [Real.exp_log hmpos]
      _ = Real.exp
          ((((c - b) + (m - d) : ℕ) : ℝ) *
            Real.log (m : ℝ)) := by
            symm
            exact Real.exp_nat_mul
              (Real.log (m : ℝ))
              (((c - b) + (m - d) : ℕ))
  rw [hpowexp] at hexp
  have hlog :=
    (Real.exp_le_exp).mp hexp
  linarith

/-- The large-`a` branch of the corrected bottom-index estimate. -/
theorem five_bottom_large_index
    (hGrowth : Tasks.FactorialClassGrowth) :
    ∃ NG : ℕ, ∀ m a b c d : ℕ,
      1 < m → NG ≤ a → FiveRep m a b c d →
      (a : ℝ) ≤
        3 * (((c - b) + (m - d) : ℕ) : ℝ) *
          Real.log (m : ℝ) := by
  obtain ⟨NG, hG⟩ := hGrowth
  refine ⟨NG, ?_⟩
  intro m a b c d hm ha hr
  exact five_index_le_three_gaps_log hm hr (hG a ha)

