/-! ## 21. Repair 24: dense branch of Lemma 4.1 from quantitative PNT mass

The dense range of Lemma 4.1 is now reduced to one genuinely analytic input:
quantitative PNT supplies enough logarithmic prime mass in
`(max b (c/2), c]`.  Everything after that point -- divisibility by the
falling product, valuation exactly one, and conversion to the required
`DensePrimeWitness` -- is proved below in Lean.
-/

namespace RemainingAnalytic24

/-- Quantitative-PNT output for the dense range.  The witness `R` is a
squarefree product of primes in the top interval `(max(b,c/2),c]`, with
logarithmic mass at least `h/4`, where `h=c-b`.  This is the only new
analytic input retained by Repair 24 for the dense branch. -/
def DenseTopIntervalPrimeMass : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 1 → ∃ X₀ : ℕ,
    ∀ X a b c : ℕ, X₀ ≤ X → a < b → b < c → c ≤ X →
      (X : ℝ) ^ γ ≤ ((c - b : ℕ) : ℝ) →
      (a : ℝ) ≤ 10 * ((c - b : ℕ) : ℝ) * Real.log (X : ℝ) →
      (b : ℝ) ≤
        100 * ((c - b : ℕ) : ℝ) * (Real.log (X : ℝ)) ^ 2 →
      ∃ R : ℕ, 0 < R ∧ Squarefree R ∧
        ((c - b : ℕ) : ℝ) / 4 ≤ Real.log (R : ℝ) ∧
        ∀ p : ℕ, p.Prime → p ∣ R →
          max b (c / 2) < p ∧ p ≤ c

end RemainingAnalytic24

/-- A prime in `(b,c]` and in the upper half of `[1,c]` occurs exactly once
in the interval product `P_{c-b}(c) = c(c-1)...(b+1)`. -/
theorem falling_factorization_eq_one_of_top_interval
    {b c p : ℕ} (hbc : b < c) (hp : p.Prime)
    (hbp : b < p) (hpc : p ≤ c) (hhalf : c < 2 * p) :
    (falling (c - b) c).factorization p = 1 := by
  have hlen_le : c - b ≤ c := Nat.sub_le _ _
  have hidx : c - p < c - b := by omega
  have hidx_mem : c - p ∈ Finset.range (c - b) :=
    Finset.mem_range.mpr hidx
  have hterm_nonzero :
      ∀ i ∈ Finset.range (c - b), c - i ≠ 0 := by
    intro i hi
    have hi' : i < c - b := Finset.mem_range.mp hi
    have hic : i < c := lt_of_lt_of_le hi' hlen_le
    omega
  unfold falling
  rw [Nat.factorization_prod_apply]
  · rw [Finset.sum_eq_single (c - p)]
    · have hterm : c - (c - p) = p := by omega
      rw [hterm, hp.factorization_self]
    · intro i hi hne
      have hir : i < c - b := Finset.mem_range.mp hi
      have hic : i < c := lt_of_lt_of_le hir hlen_le
      have htermpos : 0 < c - i := by omega
      have htermle : c - i ≤ c := Nat.sub_le _ _
      have htermlt2p : c - i < 2 * p := lt_of_le_of_lt htermle hhalf
      have hnotdvd : ¬ p ∣ c - i := by
        intro hpd
        obtain ⟨q, hq⟩ := hpd
        have hqpos : 0 < q := by
          by_contra hnpos
          have hq0 : q = 0 := by omega
          subst q
          simp at hq
          omega
        have hqone : q = 1 := by
          by_contra hqne
          have hq2 : 2 ≤ q := by omega
          have hpq_ge : 2 * p ≤ p * q := by
            simpa [Nat.mul_comm] using Nat.mul_le_mul_left p hq2
          have heq : c - i = p * q := hq
          omega
        subst q
        simp at hq
        have hip : i = c - p := by omega
        exact hne hip
      exact Nat.factorization_eq_zero_of_not_dvd hnotdvd
    · simp [hidx_mem]
  · exact hterm_nonzero

/-- Membership in the top interval automatically gives all arithmetic facts
needed for valuation one in the lower falling product. -/
theorem top_interval_prime_data
    {a b c p : ℕ} (hab : a < b) (hbc : b < c)
    (hp : p.Prime) (hpJ : max b (c / 2) < p ∧ p ≤ c) :
    a < p ∧ p ∣ falling (c - b) c ∧
      ¬ p ^ 2 ∣ falling (c - b) c := by
  have hbp : b < p := lt_of_le_of_lt (le_max_left _ _) hpJ.1
  have hhalf0 : c / 2 < p :=
    lt_of_le_of_lt (le_max_right _ _) hpJ.1
  have hhalf : c < 2 * p := by omega
  have hfac : (falling (c - b) c).factorization p = 1 :=
    falling_factorization_eq_one_of_top_interval
      hbc hp hbp hpJ.2 hhalf
  have hfall0 : falling (c - b) c ≠ 0 :=
    Nat.ne_of_gt (falling_pos_of_le (Nat.sub_le _ _))
  have hpd : p ∣ falling (c - b) c := by
    exact (hp.dvd_iff_one_le_factorization hfall0).2 (by omega)
  have hp2 : ¬ p ^ 2 ∣ falling (c - b) c := by
    intro hsq
    have htwo : 2 ≤ (falling (c - b) c).factorization p :=
      (hp.pow_dvd_iff_le_factorization hfall0).1 hsq
    rw [hfac] at htwo
    omega
  exact ⟨lt_trans hab hbp, hpd, hp2⟩

/-- Quantitative prime mass in the dense top interval implies the exact
prime-witness formulation introduced in Repair 23.  The manuscript's `h/4`
bound is stronger than the common `h/4096` valuation-mass target. -/
theorem densePrimeWitness_from_topIntervalMass
    (H : RemainingAnalytic24.DenseTopIntervalPrimeMass) :
    RemainingAnalytic23.DensePrimeWitness := by
  intro γ hγ0 hγ1
  obtain ⟨N, hN⟩ := H γ hγ0 hγ1
  refine ⟨N, ?_⟩
  intro X a b c hX hab hbc hcX hh ha hdense
  obtain ⟨R, hRpos, hRsf, hRlog, hRp⟩ :=
    hN X a b c hX hab hbc hcX hh ha hdense
  refine ⟨R, hRpos, hRsf, hRlog, ?_⟩
  intro p hp hpR
  exact top_interval_prime_data hab hbc hp (hRp p hp hpR)

/-- Hence the whole dense branch of Lemma 4.1 follows from the single
quantitative-PNT top-interval mass statement. -/
theorem denseBranch_from_topIntervalMass
    (H : RemainingAnalytic24.DenseTopIntervalPrimeMass) :
    RemainingAnalytic19.ValuationOneMassDense :=
  denseBranch_from_primeWitness
    (densePrimeWitness_from_topIntervalMass H)

