    ∃ C : ℝ, 0 < C ∧ ∃ N : ℕ, ∀ X : ℕ, N ≤ X →
      (prefixCount S X : ℝ) ≤
        C * (X : ℝ) ^ β * (Real.log (X : ℝ)) ^ logPow

