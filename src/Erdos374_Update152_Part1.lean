/-- The power/log comparison used for the direct two/three-factor cleanup is
elementary and follows from `log x = o(x^r)`. -/
theorem directExclusionDominance_proved :
    Tasks.DirectExclusionDominance := by
  intro C
  have hpowexp : 0 < (1 - alpha : ℝ) := by
    norm_num [alpha]
  have hCev : ∀ᶠ n : ℕ in atTop,
      (C : ℝ) < (n : ℝ) ^ (1 - alpha) := by
    have ht :
        Tendsto (fun n : ℕ => (n : ℝ) ^ (1 - alpha))
          atTop atTop :=
      (tendsto_rpow_atTop hpowexp).comp tendsto_natCast_atTop_atTop
    exact ht.eventually (eventually_gt_atTop (C : ℝ))
  let r : ℝ := (1 - alpha) - eta
  have hr : 0 < r := by
    dsimp [r]
    norm_num [alpha, eta]
  have hloR :
      Real.log =o[atTop] (fun x : ℝ => x ^ r) :=
    isLittleO_log_rpow_atTop hr
  have hboundR :
      ∀ᶠ x : ℝ in atTop,
        ‖Real.log x‖ ≤ (1 / 4 : ℝ) * ‖x ^ r‖ :=
    hloR.def (by norm_num)
  have hboundN :
      ∀ᶠ n : ℕ in atTop,
        ‖Real.log (n : ℝ)‖ ≤
          (1 / 4 : ℝ) * ‖(n : ℝ) ^ r‖ :=
    tendsto_natCast_atTop_atTop.eventually hboundR
  have htwo : ∀ᶠ n : ℕ in atTop, 2 ≤ n :=
    eventually_ge_atTop 2
  have hall :
      ∀ᶠ n : ℕ in atTop,
        (C : ℝ) < (n : ℝ) ^ (1 - alpha) ∧
        3 * (n : ℝ) ^ eta * Real.log (n : ℝ) <
          (n : ℝ) ^ (1 - alpha) := by
    filter_upwards [hCev, hboundN, htwo] with n hC hb hn2
    refine ⟨hC, ?_⟩
    have hnR : (1 : ℝ) < n := by
      exact_mod_cast (show 1 < n by omega)
    have hnpos : 0 < (n : ℝ) := lt_trans (by norm_num) hnR
    have hlogpos : 0 < Real.log (n : ℝ) := Real.log_pos hnR
    have hrpowpos : 0 < (n : ℝ) ^ r :=
      Real.rpow_pos_of_pos hnpos r
    have hlogle :
        Real.log (n : ℝ) ≤ (1 / 4 : ℝ) * (n : ℝ) ^ r := by
      simpa [Real.norm_eq_abs, abs_of_pos hlogpos,
        abs_of_pos hrpowpos] using hb
    have h3log : 3 * Real.log (n : ℝ) < (n : ℝ) ^ r := by
      nlinarith
    have hetapos : 0 < (n : ℝ) ^ eta :=
      Real.rpow_pos_of_pos hnpos eta
    calc
      3 * (n : ℝ) ^ eta * Real.log (n : ℝ)
          = (n : ℝ) ^ eta * (3 * Real.log (n : ℝ)) := by ring
      _ < (n : ℝ) ^ eta * (n : ℝ) ^ r :=
        mul_lt_mul_of_pos_left h3log hetapos
      _ = (n : ℝ) ^ (eta + r) := by
        rw [Real.rpow_add hnpos]
      _ = (n : ℝ) ^ (1 - alpha) := by
        congr 1
        dsimp [r]
        ring
  obtain ⟨N, hN⟩ := (eventually_atTop.1 hall)
  exact ⟨N, hN⟩

/-- The analogous elementary comparison used to pass from the `theta` upper
gap to the `eta` lower-gap contradiction in Corollary 6.2. -/
theorem shortGapDominance_proved :
    Tasks.ShortGapDominance := by
  let r : ℝ := eta - theta
  have hr : 0 < r := by
    dsimp [r]
    norm_num [eta, theta]
  have hloR :
      Real.log =o[atTop] (fun x : ℝ => x ^ r) :=
    isLittleO_log_rpow_atTop hr
  have hboundR :
      ∀ᶠ x : ℝ in atTop,
        ‖Real.log x‖ ≤ (1 / 8192 : ℝ) * ‖x ^ r‖ :=
    hloR.def (by norm_num)
  have hboundN :
      ∀ᶠ n : ℕ in atTop,
        ‖Real.log (n : ℝ)‖ ≤
          (1 / 8192 : ℝ) * ‖(n : ℝ) ^ r‖ :=
    tendsto_natCast_atTop_atTop.eventually hboundR
  have htwo : ∀ᶠ n : ℕ in atTop, 2 ≤ n :=
    eventually_ge_atTop 2
  have hall :
      ∀ᶠ n : ℕ in atTop,
        4096 * (n : ℝ) ^ theta * Real.log (n : ℝ) <
          (n : ℝ) ^ eta := by
    filter_upwards [hboundN, htwo] with n hb hn2
    have hnR : (1 : ℝ) < n := by
      exact_mod_cast (show 1 < n by omega)
    have hnpos : 0 < (n : ℝ) := lt_trans (by norm_num) hnR
    have hlogpos : 0 < Real.log (n : ℝ) := Real.log_pos hnR
    have hrpowpos : 0 < (n : ℝ) ^ r :=
      Real.rpow_pos_of_pos hnpos r
    have hlogle :
        Real.log (n : ℝ) ≤
          (1 / 8192 : ℝ) * (n : ℝ) ^ r := by
      simpa [Real.norm_eq_abs, abs_of_pos hlogpos,
        abs_of_pos hrpowpos] using hb
    have h4096 :
        4096 * Real.log (n : ℝ) < (n : ℝ) ^ r := by
      nlinarith
    have hthetap : 0 < (n : ℝ) ^ theta :=
      Real.rpow_pos_of_pos hnpos theta
    calc
      4096 * (n : ℝ) ^ theta * Real.log (n : ℝ)
          = (n : ℝ) ^ theta *
              (4096 * Real.log (n : ℝ)) := by ring
      _ < (n : ℝ) ^ theta * (n : ℝ) ^ r :=
        mul_lt_mul_of_pos_left h4096 hthetap
      _ = (n : ℝ) ^ (theta + r) := by
        rw [Real.rpow_add hnpos]
      _ = (n : ℝ) ^ eta := by
        congr 1
        dsimp [r]
        ring
  obtain ⟨N, hN⟩ := (eventually_atTop.1 hall)
  exact ⟨N, hN⟩


