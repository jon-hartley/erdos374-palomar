/-! ### Dyadic count transfer -/

/-- Exact finite-prefix split at `X/2`. -/
theorem prefixCount_dyadic_split
    (S : Set ℕ) (X : ℕ) :
    prefixCount S X =
      prefixCount S (X / 2) +
      prefixCount (S ∩ {m : ℕ | X / 2 < m ∧ m ≤ X}) X := by
  classical
  unfold prefixCount
  have hhalf : X / 2 ≤ X := Nat.div_le_self X 2
  let A := (Finset.Icc 1 X).filter (fun n => n ∈ S ∧ n ≤ X / 2)
  let B := (Finset.Icc 1 X).filter (fun n => n ∈ S ∧ X / 2 < n)
  have hdisj : Disjoint A B := by
    refine Finset.disjoint_left.mpr ?_
    intro n hnA hnB
    simp only [A, Finset.mem_filter, Finset.mem_Icc] at hnA
    simp only [B, Finset.mem_filter, Finset.mem_Icc] at hnB
    omega
  have hunion :
      A ∪ B = (Finset.Icc 1 X).filter (fun n => n ∈ S) := by
    ext n
    simp only [Finset.mem_union, A, B, Finset.mem_filter, Finset.mem_Icc]
    constructor
    · rintro (⟨hI, hS, hh⟩ | ⟨hI, hS, hh⟩)
      · exact ⟨hI, hS⟩
      · exact ⟨hI, hS⟩
    · rintro ⟨hI, hS⟩
      by_cases hh : n ≤ X / 2
      · exact Or.inl ⟨hI, hS, hh⟩
      · exact Or.inr ⟨hI, hS, lt_of_not_ge hh⟩
  have hcard :
      ((Finset.Icc 1 X).filter (fun n => n ∈ S)).card =
        A.card + B.card := by
    rw [← Finset.card_union_of_disjoint hdisj, hunion]
  have hAset :
      A = (Finset.Icc 1 (X / 2)).filter (fun n => n ∈ S) := by
    ext n
    simp only [A, Finset.mem_filter, Finset.mem_Icc]
    constructor
    · rintro ⟨⟨h1, hXn⟩, hS, hh⟩
