/-! ## 19. Repair 23: full Corollary 4.3 glue and concrete dense/sparse valuation branches

This repair replaces the remaining abstract Corollary-4.3 bridge with an
actual Lean proof from `ValuationOneMass` plus the already isolated bottom-index
estimate.  It also replaces the dense/sparse branch outputs by more primitive
prime-witness statements and proves the valuation-one conversion in Lean.
-/

/-- A squarefree natural number divides `n` if every prime divisor of it divides `n`. -/
theorem squarefree_dvd_of_prime_divisors_dvd
    {R n : ℕ} (hR0 : R ≠ 0) (hn0 : n ≠ 0)
    (hRsf : Squarefree R)
    (h : ∀ p : ℕ, p.Prime → p ∣ R → p ∣ n) :
    R ∣ n := by
  rw [← Nat.factorization_prime_le_iff_dvd hR0 hn0]
  intro p hp
  by_cases hpR : p ∣ R
  · have hR1 : R.factorization p = 1 :=
      Nat.factorization_eq_one_of_squarefree hRsf hp hpR
    have hn1 : 1 ≤ n.factorization p :=
      (hp.dvd_iff_one_le_factorization hn0).mp (h p hp hpR)
    simpa [hR1] using hn1
  · have hRz : R.factorization p = 0 :=
      Nat.factorization_eq_zero_of_not_dvd hpR
    simp [hRz]

theorem valuation_witness_divides_upper_five_full
    {a h c ell m R : ℕ}
    (hRpos : 0 < R) (hRsf : Squarefree R)
    (hRp : ∀ p : ℕ, p.Prime → p ∣ R →
      a < p ∧ (falling h c).factorization p = 1)
    (hellm : ell ≤ m)
    (hsq : NatSquare (q a * falling h c * falling ell m)) :
    R ∣ falling ell m := by
  have hupper0 : falling ell m ≠ 0 :=
    Nat.ne_of_gt (falling_pos_of_le hellm)
  apply squarefree_dvd_of_prime_divisors_dvd
      (Nat.ne_of_gt hRpos) hupper0 hRsf
  intro p hp hpR
  have hpdata := hRp p hp hpR
  exact prime_dvd_upper_of_five_square
    hp hpdata.1 hpdata.2 hellm hsq

theorem valuation_witness_divides_upper_four_full
    {h c ell m R : ℕ}
    (hRpos : 0 < R) (hRsf : Squarefree R)
    (hRp : ∀ p : ℕ, p.Prime → p ∣ R →
      (falling h c).factorization p = 1)
    (hellm : ell ≤ m)
    (hsq : NatSquare (falling h c * falling ell m)) :
    R ∣ falling ell m := by
  have hupper0 : falling ell m ≠ 0 :=
    Nat.ne_of_gt (falling_pos_of_le hellm)
  apply squarefree_dvd_of_prime_divisors_dvd
      (Nat.ne_of_gt hRpos) hupper0 hRsf
  intro p hp hpR
  exact prime_dvd_upper_of_four_square
    hp (hRp p hp hpR) hellm hsq

/-- Divisibility by an upper interval product gives the logarithmic bound
`log R ≤ ell log m`. -/
theorem log_witness_le_upper
    {R ell m : ℕ} (hRpos : 0 < R)
    (hellm : ell ≤ m) (hRdiv : R ∣ falling ell m) :
    Real.log (R : ℝ) ≤ (ell : ℝ) * Real.log (m : ℝ) := by
  by_cases hm0 : m = 0
  · subst m
    have hell0 : ell = 0 := by omega
    subst ell
    have hR1 : R = 1 := by
      apply Nat.dvd_one.mp
      simpa [falling] using hRdiv
    subst R
    simp
  · have hmpos : 0 < m := Nat.pos_of_ne_zero hm0
    have hfallpos : 0 < falling ell m := falling_pos_of_le hellm
    have hRle : R ≤ falling ell m := Nat.le_of_dvd hfallpos hRdiv
    have hfallpow : falling ell m ≤ m ^ ell := falling_le_pow ell m
    have hRpow : R ≤ m ^ ell := hRle.trans hfallpow
    have hRposR : (0 : ℝ) < R := by exact_mod_cast hRpos
    have hRpowR : (R : ℝ) ≤ (m : ℝ) ^ ell := by exact_mod_cast hRpow
    have hlog :
        Real.log (R : ℝ) ≤ Real.log ((m : ℝ) ^ ell) :=
      Real.log_le_log hRposR hRpowR
    simpa [Real.log_pow] using hlog

/-- Every four- or five-factor representation has lower gap strictly below m. -/
theorem lower_gap_lt_endpoint
    {m b c d : ℕ}
    (hr : FourRep m b c d ∨ ∃ a : ℕ, FiveRep m a b c d) :
    c - b < m := by
  rcases hr with h4 | ⟨a, h5⟩
  · rcases h4 with ⟨hb, hbc, hcd, hdm, hs⟩
    omega
  · rcases h5 with ⟨ha, hab, hbc, hcd, hdm, hs⟩
    omega

/-- Full Corollary 4.3 from Lemma 4.1, factorial growth, and the bottom-index
estimate isolated in Repair 21. -/
theorem intervalComparison_from_valuationMass
    (hVM : Tasks.ValuationOneMass)
    (hGrowth : Tasks.FactorialClassGrowth)
    (hBottom : RemainingAnalytic21.FiveFactorBottomIndexBound) :
    Tasks.IntervalLengthComparison := by
  intro γ hγ
  obtain ⟨NB, hB⟩ := hBottom hGrowth
  by_cases hγ1 : γ < 1
  · obtain ⟨NV, hV⟩ := hVM γ hγ hγ1
    refine ⟨max (max NB NV) 2, ?_⟩
    intro m b c d hmN hrep hellh hgamma
    have hmNB : NB ≤ m :=
      le_trans (le_max_left NB NV)
        (le_trans (le_max_left (max NB NV) 2) hmN)
    have hmNV : NV ≤ m :=
      le_trans (le_max_right NB NV)
        (le_trans (le_max_left (max NB NV) 2) hmN)
    have hm2 : 2 ≤ m :=
      le_trans (le_max_right (max NB NV) 2) hmN
    have hm1R : (1 : ℝ) ≤ m := by
      exact_mod_cast (show 1 ≤ m by omega)
    have hlog_nonneg : 0 ≤ Real.log (m : ℝ) :=
      Real.log_nonneg hm1R
    have hellm : m - d ≤ m := Nat.sub_le _ _
    rcases hrep with h4 | ⟨a, h5⟩
    · rcases h4 with ⟨hb, hbc, hcd, hdm, hsquare⟩
      have hbpos : 0 < b := by omega
      have hc_m : c ≤ m := by omega
      have hzero :
          (0 : ℝ) ≤
            10 * ((c - b : ℕ) : ℝ) * Real.log (m : ℝ) := by
        positivity
      obtain ⟨R, hRpos, hRsf, hRp, hRlog⟩ :=
        hV m 0 b c hmNV (by omega) hbc hc_m
          hgamma (by simpa only [Nat.cast_zero] using hzero)
      have hsred :
          NatSquare (falling (c - b) c * falling (m - d) m) :=
        (four_interval_reduction b c d m hb hbc hcd hdm).mp hsquare
      have hRdiv :
          R ∣ falling (m - d) m :=
        valuation_witness_divides_upper_four_full
          hRpos hRsf (by
            intro p hp hpR
            exact (hRp p hp hpR).2)
          hellm hsred
      have hlogup :=
        log_witness_le_upper hRpos hellm hRdiv
      linarith
    · rcases h5 with ⟨ha, hab, hbc, hcd, hdm, hsquare⟩
      have hc_m : c ≤ m := by omega
      have h5full : FiveRep m a b c d :=
        ⟨ha, hab, hbc, hcd, hdm, hsquare⟩
      have haBound :=
        hB m a b c d hmNB h5full hellh
      obtain ⟨R, hRpos, hRsf, hRp, hRlog⟩ :=
        hV m a b c hmNV hab hbc hc_m hgamma haBound
      have hsred :
          NatSquare
            (q a * falling (c - b) c * falling (m - d) m) :=
        (five_interval_reduction a b c d m ha hab hbc hcd hdm).mp hsquare
      have hRdiv :
          R ∣ falling (m - d) m :=
        valuation_witness_divides_upper_five_full
          hRpos hRsf hRp hellm hsred
      have hlogup :=
        log_witness_le_upper hRpos hellm hRdiv
      linarith
  · refine ⟨2, ?_⟩
    intro m b c d hmN hrep hellh hgamma
    have hmgt : 1 < m := by omega
    have hmR1 : (1 : ℝ) ≤ m := by exact_mod_cast (show 1 ≤ m by omega)
    have hγge : (1 : ℝ) ≤ γ := le_of_not_gt hγ1
    have hmpow : (m : ℝ) ≤ (m : ℝ) ^ γ := by
      have h :=
        Real.rpow_le_rpow_of_exponent_le hmR1 hγge
      simpa using h
    have hgapltNat : c - b < m :=
      lower_gap_lt_endpoint hrep
    have hgaplt : ((c - b : ℕ) : ℝ) < (m : ℝ) := by
      exact_mod_cast hgapltNat
    linarith

/-! ### Concrete valuation-one conversion for dense and sparse branches -/

/-- If p divides n but p² does not, then its factorization exponent is exactly 1. -/
theorem factorization_eq_one_of_dvd_not_sq_dvd
    {n p : ℕ} (hp : p.Prime) (hn0 : n ≠ 0)
    (hpd : p ∣ n) (hp2 : ¬ p ^ 2 ∣ n) :
    n.factorization p = 1 := by
  have h1 : 1 ≤ n.factorization p :=
    (hp.dvd_iff_one_le_factorization hn0).mp hpd
  have hnot2 : ¬ 2 ≤ n.factorization p := by
    intro h2
    exact hp2 ((hp.pow_dvd_iff_le_factorization hn0).2 h2)
  omega

namespace RemainingAnalytic23

/-- Quantitative-PNT output needed in the dense branch: enough squarefree
prime mass, with each selected prime dividing the lower interval but its
square not dividing that interval product. -/
def DensePrimeWitness : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 1 → ∃ X₀ : ℕ,
    ∀ X a b c : ℕ, X₀ ≤ X → a < b → b < c → c ≤ X →
      (X : ℝ) ^ γ ≤ ((c - b : ℕ) : ℝ) →
      (a : ℝ) ≤ 10 * ((c - b : ℕ) : ℝ) * Real.log (X : ℝ) →
      (b : ℝ) ≤
        100 * ((c - b : ℕ) : ℝ) * (Real.log (X : ℝ)) ^ 2 →
      ∃ R : ℕ, 0 < R ∧ Squarefree R ∧
        ((c - b : ℕ) : ℝ) / 4 ≤ Real.log (R : ℝ) ∧
        ∀ p : ℕ, p.Prime → p ∣ R →
          a < p ∧ p ∣ falling (c - b) c ∧
            ¬ p ^ 2 ∣ falling (c - b) c

/-- Reciprocal-prime/smooth-cutoff output in the sparse branch. -/
def SparsePrimeWitness : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 1 → ∃ X₀ : ℕ,
    ∀ X a b c : ℕ, X₀ ≤ X → a < b → b < c → c ≤ X →
      (X : ℝ) ^ γ ≤ ((c - b : ℕ) : ℝ) →
      (a : ℝ) ≤ 10 * ((c - b : ℕ) : ℝ) * Real.log (X : ℝ) →
      100 * ((c - b : ℕ) : ℝ) * (Real.log (X : ℝ)) ^ 2 < (b : ℝ) →
      ∃ R : ℕ, 0 < R ∧ Squarefree R ∧
        ((c - b : ℕ) : ℝ) / 1280 ≤ Real.log (R : ℝ) ∧
        ∀ p : ℕ, p.Prime → p ∣ R →
          a < p ∧ p ∣ falling (c - b) c ∧
            ¬ p ^ 2 ∣ falling (c - b) c

end RemainingAnalytic23

theorem denseBranch_from_primeWitness
    (H : RemainingAnalytic23.DensePrimeWitness) :
    RemainingAnalytic19.ValuationOneMassDense := by
  intro γ hγ0 hγ1
  obtain ⟨N, hN⟩ := H γ hγ0 hγ1
  refine ⟨N, ?_⟩
  intro X a b c hX hab hbc hcX hh ha hdense
  obtain ⟨R, hRpos, hRsf, hRlog, hRp⟩ :=
    hN X a b c hX hab hbc hcX hh ha hdense
  refine ⟨R, hRpos, hRsf, ?_, ?_⟩
  · intro p hp hpR
    have hd := hRp p hp hpR
    refine ⟨hd.1, ?_⟩
    exact factorization_eq_one_of_dvd_not_sq_dvd
      hp (Nat.ne_of_gt (falling_pos_of_le (by omega)))
      hd.2.1 hd.2.2
  · linarith

theorem sparseBranch_from_primeWitness
    (H : RemainingAnalytic23.SparsePrimeWitness) :
    RemainingAnalytic19.ValuationOneMassSparse := by
  intro γ hγ0 hγ1
  obtain ⟨N, hN⟩ := H γ hγ0 hγ1
  refine ⟨N, ?_⟩
  intro X a b c hX hab hbc hcX hh ha hsparse
  obtain ⟨R, hRpos, hRsf, hRlog, hRp⟩ :=
    hN X a b c hX hab hbc hcX hh ha hsparse
  refine ⟨R, hRpos, hRsf, ?_, ?_⟩
  · intro p hp hpR
    have hd := hRp p hp hpR
    refine ⟨hd.1, ?_⟩
    exact factorization_eq_one_of_dvd_not_sq_dvd
      hp (Nat.ne_of_gt (falling_pos_of_le (by omega)))
