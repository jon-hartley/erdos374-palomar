/-! ## 31. Repair 32: all remaining finite Proposition-5.1 machinery

This repair expands the two finite enumeration tasks all the way down to the
actual endpoint-to-anchor-tuple covering statements and the tuple-sum
bookkeeping.  The published analytic boundary remains exactly the three fields
of Repair 31.

The new finite architecture is:
1. each nonpaired endpoint/representation is covered by a legal anchor tuple;
2. the endpoint is determined by `(r,P)`, so a chosen tuple gives an injection;
3. the tuple count is bounded by the one-tuple large-sieve estimate;
4. the crude sums over `j,t,h,ell,a,r` give the exponents (5.3) and (5.2).

The tuple-cover statements are written explicitly enough that no analytic
estimate is hidden inside them.
-/

namespace RemainingAnalytic32

/-- Four-factor anchor tuple.  `P` is the large prime, `r` its cofactor,
`j,t,h,ell` are the manuscript variables, and `Parg` records the square
argument counted by the one-tuple large-sieve set. -/
structure FourAnchorTuple where
  r : ℕ
  P : ℕ
  j : ℕ
  t : ℕ
  h : ℕ
  ell : ℕ
  Parg : ℕ

/-- Five-factor tuple with the additional bottom factorial index `a`. -/
structure FiveAnchorTuple extends FourAnchorTuple where
  a : ℕ

/-- Legality conditions for a four-factor tuple on a dyadic block up to `X`. -/
def FourTupleLegal (X R H : ℕ) (T : FourAnchorTuple) : Prop :=
  1 ≤ T.r ∧ T.r ≤ R ∧
  T.Parg = T.P ∧
  0 < T.j ∧ T.j < T.r ∧
  0 < T.h ∧ T.h ≤ H ∧
  0 < T.ell ∧ T.ell ≤ H ∧
  T.t < T.h ∧
  T.P ≤ X / T.r ∧
  T.P ∈ RemainingAnalytic28.AnchorSquareArgs
    0 T.r T.j T.t T.h T.ell (X / T.r)

/-- Five-factor legality, including the manuscript bottom-index range. -/
def FiveTupleLegal (X R H Amax : ℕ) (T : FiveAnchorTuple) : Prop :=
  FourTupleLegal X R H T.toFourAnchorTuple ∧
  T.a ≤ Amax ∧
  T.P ∈ RemainingAnalytic28.AnchorSquareArgs
    T.a T.r T.j T.t T.h T.ell (X / T.r)

/-- A chosen four-factor endpoint is covered by a legal tuple and the tuple
determines the endpoint through `m = r*P`. -/
def FourEndpointTupleCover : Prop :=
  ∀ α η : ℝ, 0 < α → 0 < η → 3 * α + 8 * η < 1 →
    ∃ N : ℕ, ∀ X m : ℕ, N ≤ X → X / 2 < m → m ≤ X →
      m ∈ NonpairedFour α η →
      ∃ R H : ℕ, ∃ T : FourAnchorTuple,
        FourTupleLegal X R H T ∧
        m = T.r * T.P ∧
        (R : ℝ) ≤ 2 * (X : ℝ) ^ α ∧
        (H : ℝ) ≤ 2 * (X : ℝ) ^ η

/-- Five-factor endpoint-to-tuple cover, with the bottom-index range
`Amax = O(H log X)` made explicit. -/
def FiveEndpointTupleCover : Prop :=
  ∀ α η : ℝ, 0 < α → 0 < η → 3 * α + 8 * η < 1 →
    ∃ C : ℝ, 0 < C ∧ ∃ N : ℕ, ∀ X m : ℕ,
      N ≤ X → X / 2 < m → m ≤ X →
      m ∈ NonpairedFive α η →
      ∃ R H Amax : ℕ, ∃ T : FiveAnchorTuple,
        FiveTupleLegal X R H Amax T ∧
        m = T.r * T.P ∧
        (R : ℝ) ≤ 2 * (X : ℝ) ^ α ∧
        (H : ℝ) ≤ 2 * (X : ℝ) ^ η ∧
        (Amax : ℝ) ≤ C * (H : ℝ) * Real.log (X : ℝ)

/-- The elementary five-factor bottom-index estimate used in §5 is isolated
from the counting statement. -/
def FiveAnchorBottomIndexBound : Prop :=
  ∀ α η : ℝ, 0 < α → 0 < η → 3 * α + 8 * η < 1 →
    ∃ C : ℝ, 0 < C ∧ ∃ N : ℕ, ∀ X m a b c d : ℕ,
      N ≤ X → X / 2 < m → m ≤ X →
      FiveRep m a b c d →
      ((c - b : ℕ) : ℝ) ≤ (m : ℝ) ^ η →
      ((m - d : ℕ) : ℝ) ≤ (m : ℝ) ^ η →
      (a : ℝ) ≤ C * (X : ℝ) ^ η * Real.log (X : ℝ)

/-- The tuple-count summation, separated from endpoint extraction. -/
def FourTupleSummation32 : Prop :=
  RemainingAnalytic28.AnchorLargeSieveTupleBound →
  ∀ α η : ℝ, 0 < α → 0 < η → 3 * α + 8 * η < 1 →
    ∃ C : ℝ, 0 < C ∧ ∃ N : ℕ, ∀ X R H : ℕ,
      N ≤ X →
      (R : ℝ) ≤ 2 * (X : ℝ) ^ α →
      (H : ℝ) ≤ 2 * (X : ℝ) ^ η →
      (∑ r ∈ Finset.Icc 1 R,
        (r : ℝ) * (H : ℝ) ^ 3 *
          (Real.sqrt ((X : ℝ) / (r : ℝ)) * Real.log (X : ℝ)))
        ≤ C * (X : ℝ) ^
          ((1 : ℝ) / 2 + 3 * α / 2 + 3 * η) *
            Real.log (X : ℝ)

/-- Five-factor analogue, paying one additional factor `H log X` for `a`. -/
def FiveTupleSummation32 : Prop :=
  RemainingAnalytic28.AnchorLargeSieveTupleBound →
  ∀ α η : ℝ, 0 < α → 0 < η → 3 * α + 8 * η < 1 →
    ∃ C : ℝ, 0 < C ∧ ∃ N : ℕ, ∀ X R H Amax : ℕ,
      N ≤ X →
      (R : ℝ) ≤ 2 * (X : ℝ) ^ α →
      (H : ℝ) ≤ 2 * (X : ℝ) ^ η →
      (Amax : ℝ) ≤ C * (H : ℝ) * Real.log (X : ℝ) →
      (∑ r ∈ Finset.Icc 1 R,
        (r : ℝ) * (H : ℝ) ^ 3 * (Amax : ℝ) *
          (Real.sqrt ((X : ℝ) / (r : ℝ)) * Real.log (X : ℝ)))
        ≤ C ^ 2 * (X : ℝ) ^
          ((1 : ℝ) / 2 + 3 * α / 2 + 4 * η) *
            (Real.log (X : ℝ)) ^ 2

/-- Dyadic-to-prefix conversion for a generic nonnegative counting function.
This is the standard geometric-series cleanup used after proving the dyadic
bound on `X/2 < m <= X`. -/
def DyadicPrefixTransfer : Prop :=
  ∀ (S : Set ℕ) (β : ℝ) (logPow : ℕ),
    β < 1 →
    (∃ C : ℝ, 0 < C ∧ ∃ N : ℕ, ∀ X : ℕ, N ≤ X →
      (prefixCount (S ∩ {m : ℕ | X / 2 < m ∧ m ≤ X}) X : ℝ) ≤
        C * (X : ℝ) ^ β * (Real.log (X : ℝ)) ^ logPow) →
    ∃ C : ℝ, 0 < C ∧ ∃ N : ℕ, ∀ X : ℕ, N ≤ X →
      (prefixCount S X : ℝ) ≤
        C * (X : ℝ) ^ β * (Real.log (X : ℝ)) ^ logPow

/-- Full finite Proposition-5.1 package at the endpoint/tuple level. -/
structure FiniteProp51Core32 where
  four_cover : FourEndpointTupleCover
  five_cover : FiveEndpointTupleCover
  five_bottom : FiveAnchorBottomIndexBound
  four_sum : FourTupleSummation32
  five_sum : FiveTupleSummation32
  dyadic : DyadicPrefixTransfer

end RemainingAnalytic32

/-! ### Elementary summation lemmas used by the new tuple sums -/

theorem sum_sqrt_upto_le (R : ℕ) :
    ∑ r ∈ Finset.Icc 1 R, Real.sqrt (r : ℝ) ≤
      (R : ℝ) * Real.sqrt (R : ℝ) :=
  RemainingAnalytic29.sum_sqrt_Icc_le R

theorem r_mul_sqrt_div_identity
    {X r : ℕ} (hr : 0 < r) :
    (r : ℝ) * Real.sqrt ((X : ℝ) / (r : ℝ)) =
      Real.sqrt (X : ℝ) * Real.sqrt (r : ℝ) := by
  have hrR : (0 : ℝ) < r := by exact_mod_cast hr
  have hX0 : (0 : ℝ) ≤ X := by positivity
  have hr0 : (0 : ℝ) ≤ r := by positivity
  have hdiv0 : (0 : ℝ) ≤ (X : ℝ) / (r : ℝ) := div_nonneg hX0 hr0
  have hsqrtr : 0 ≤ Real.sqrt (r : ℝ) := Real.sqrt_nonneg _
  have hsqrtd : 0 ≤ Real.sqrt ((X : ℝ) / (r : ℝ)) := Real.sqrt_nonneg _
  have hsqrtr2 : Real.sqrt (r : ℝ) ^ 2 = (r : ℝ) :=
    Real.sq_sqrt hr0
  have hprod :
      (Real.sqrt ((X : ℝ) / (r : ℝ)) * Real.sqrt (r : ℝ)) ^ 2 =
        (X : ℝ) := by
    rw [mul_pow, Real.sq_sqrt hdiv0, hsqrtr2]
    field_simp [ne_of_gt hrR]
  have hnon :
      0 ≤ Real.sqrt ((X : ℝ) / (r : ℝ)) * Real.sqrt (r : ℝ) :=
    mul_nonneg hsqrtd hsqrtr
  have hsqrtX_nonneg : 0 ≤ Real.sqrt (X : ℝ) :=
    Real.sqrt_nonneg _
  have hsqrtX_sq : (Real.sqrt (X : ℝ)) ^ 2 = (X : ℝ) :=
    Real.sq_sqrt hX0
  have hsqrtX :
      Real.sqrt (X : ℝ) =
        Real.sqrt ((X : ℝ) / (r : ℝ)) * Real.sqrt (r : ℝ) := by
    nlinarith [hsqrtX_sq, hprod]
  rw [hsqrtX]
  calc
    (r : ℝ) * Real.sqrt ((X : ℝ) / (r : ℝ))
        = Real.sqrt ((X : ℝ) / (r : ℝ)) * (r : ℝ) := by ring
    _ = Real.sqrt ((X : ℝ) / (r : ℝ)) *
          (Real.sqrt (r : ℝ) * Real.sqrt (r : ℝ)) := by
          rw [← sq, hsqrtr2]
    _ = (Real.sqrt ((X : ℝ) / (r : ℝ)) * Real.sqrt (r : ℝ)) *
          Real.sqrt (r : ℝ) := by ring

/-- Coarse real bound underlying both tuple sums. -/
theorem tuple_r_sum_bound
    {X R : ℕ} :
    ∑ r ∈ Finset.Icc 1 R,
      (r : ℝ) * Real.sqrt ((X : ℝ) / (r : ℝ))
      ≤ Real.sqrt (X : ℝ) * (R : ℝ) * Real.sqrt (R : ℝ) := by
  calc
    ∑ r ∈ Finset.Icc 1 R,
        (r : ℝ) * Real.sqrt ((X : ℝ) / (r : ℝ))
        =
      ∑ r ∈ Finset.Icc 1 R,
        Real.sqrt (X : ℝ) * Real.sqrt (r : ℝ) := by
          apply Finset.sum_congr rfl
          intro r hr
          have hr1 : 1 ≤ r := (Finset.mem_Icc.mp hr).1
          exact r_mul_sqrt_div_identity (by omega)
    _ = Real.sqrt (X : ℝ) *
        (∑ r ∈ Finset.Icc 1 R, Real.sqrt (r : ℝ)) := by
          rw [Finset.mul_sum]
    _ ≤ Real.sqrt (X : ℝ) *
        ((R : ℝ) * Real.sqrt (R : ℝ)) := by
          exact mul_le_mul_of_nonneg_left
            (sum_sqrt_upto_le R) (Real.sqrt_nonneg _)
    _ = Real.sqrt (X : ℝ) * (R : ℝ) * Real.sqrt (R : ℝ) := by ring

/-- Exponent identity used after `R <= O(X^alpha)`. -/
theorem sqrtX_times_R_three_halves_exponent
    {x α : ℝ} (hx : 0 < x) :
    x ^ ((1 : ℝ) / 2) * x ^ (3 * α / 2) =
      x ^ ((1 : ℝ) / 2 + 3 * α / 2) := by
  rw [← Real.rpow_add hx]

/-- Exponent identities including the H-powers. -/
theorem four_full_exponent_identity
    {x α η : ℝ} (hx : 0 < x) :
    x ^ ((1 : ℝ) / 2) * x ^ (3 * α / 2) * x ^ (3 * η) =
      x ^ ((1 : ℝ) / 2 + 3 * α / 2 + 3 * η) := by
  rw [← Real.rpow_add hx, ← Real.rpow_add hx]

theorem five_full_exponent_identity
    {x α η : ℝ} (hx : 0 < x) :
    x ^ ((1 : ℝ) / 2) * x ^ (3 * α / 2) * x ^ (4 * η) =
      x ^ ((1 : ℝ) / 2 + 3 * α / 2 + 4 * η) := by
  rw [← Real.rpow_add hx, ← Real.rpow_add hx]

