/-! ## 27. Repair 28: full Proposition 5.1 derivation interface

This section replaces the old Repair-21 Proposition-5.1 placeholders by
mathematically meaningful statements matching manuscript §5.

Important distinction: the published Weil character-sum theorem and the
analytic large sieve remain external analytic inputs, exactly as in the paper.
What is formalized here is the complete deduction of Proposition 5.1 from
those named inputs plus the finite polynomial/good-reduction and tuple-count
steps.  No `True`-valued payload occurs in this replacement interface.
-/

namespace RemainingAnalytic28

/-- A rational value is a square.  This is the characteristic-zero model for
the square-value set of the anchor polynomial before reduction mod auxiliary
primes. -/
def RatSquare (x : ℚ) : Prop := ∃ y : ℚ, x = y ^ 2

/-- Integer arguments `1 <= z <= L` on which the anchor polynomial takes a
rational square value.  Every prime argument coming from a representation is
contained in this larger set, just as in manuscript (5.9). -/
def AnchorSquareArgs
    (a r j t h ell L : ℕ) : Finset ℕ :=
  (Finset.Icc 1 L).filter (fun z =>
    RatSquare ((Tasks.anchorPolynomial a r j t h ell).eval (z : ℚ)))

/-- The exact square-argument count used in the large-sieve step. -/
def AnchorSquareArgCount
    (a r j t h ell L : ℕ) : ℕ :=
  (AnchorSquareArgs a r j t h ell L).card

/-- Source-level good-reduction conclusion for a legal nonpaired tuple.
It packages the manuscript assertions that sufficiently large auxiliary primes
avoid the scalar coefficient and all nonzero cross-differences of distinct
rational roots, so the nonsquare property survives reduction. -/
def GoodReductionForAnchor : Prop :=
  ∀ a r j t h ell : ℕ,
    0 < j → j < r → 0 < h → 0 < ell → t < h →
    (h ≠ 1 ∨ ell ≠ 1) →
    RemainingAnalytic27.NotNonzeroScalarSquare
      (Tasks.anchorPolynomial a r j t h ell) →
    ∃ Λ : ℕ, ∀ lam : ℕ, Λ ≤ lam → lam.Prime →
      a < lam ∧ 2 * r * max h ell < lam ∧
      64 * (max h ell) ^ 2 ≤ lam

/-- Weil square-or-zero residue restriction in the exact quantitative form
used in §5: after good reduction, at most `3 lam / 4` residue classes can give
a square-or-zero value.  We keep the finite-field character-sum theorem itself
as a named analytic input, not as an axiom hidden in a counting theorem. -/
def WeilSquareResidueRestriction : Prop :=
  ∀ a r j t h ell lam : ℕ,
    0 < j → j < r → 0 < h → 0 < ell → t < h →
    (h ≠ 1 ∨ ell ≠ 1) →
    lam.Prime →
    a < lam →
    2 * r * max h ell < lam →
    64 * (max h ell) ^ 2 ≤ lam →
    ∃ rho : ℕ, 4 * rho ≤ 3 * lam

/-- Prime supply for the auxiliary interval `(sqrt L,2 sqrt L]`.
This is the only PNT input used inside Proposition 5.1.  The lower bound is
encoded in a form sufficient for the subsequent large-sieve theorem. -/
def AuxiliaryPrimeSupply : Prop :=
  ∃ C : ℝ, 0 < C ∧ ∃ N : ℕ, ∀ L : ℕ, N ≤ L →
    C * Real.sqrt (L : ℝ) / Real.log (L : ℝ) ≤
      (prefixCount {p : ℕ | p.Prime ∧
        (Real.sqrt (L : ℝ) < (p : ℝ) ∧
         (p : ℝ) ≤ 2 * Real.sqrt (L : ℝ))} (2 * L) : ℝ)

/-- Analytic-large-sieve conclusion for one fixed legal tuple.  This is the
formal counterpart of (5.9).  `K` is uniform over all tuple variables after
the parameter exponents are fixed. -/
def AnchorLargeSieveTupleBound : Prop :=
  ∀ α η : ℝ, 0 < α → 0 < η → 3 * α + 8 * η < 1 →
    ∃ K : ℝ, 0 < K ∧ ∃ N : ℕ, ∀ X r a j t h ell L : ℕ,
      N ≤ X →
      1 ≤ r → r ≤ X →
      0 < j → j < r → 0 < h → 0 < ell → t < h →
      (h ≠ 1 ∨ ell ≠ 1) →
      L ≤ X / r →
      (AnchorSquareArgCount a r j t h ell L : ℝ) ≤
        K * Real.sqrt ((X : ℝ) / (r : ℝ)) * Real.log (X : ℝ)

/-- The five-factor tuple enumeration from the paragraph following (5.9).
This is deliberately stated as the actual implication needed for (5.2), not
as a `True` payload: the one-tuple `sqrt(X/r) log X` bound, together with the
ranges `r <= X^alpha`, `h,ell <= X^eta`, `t<h`, `j<r`, and
`a = O(X^eta log X)`, yields the displayed global count. -/
def FiveTupleEnumeration : Prop :=
  AnchorLargeSieveTupleBound →
  RemainingAnalytic19.FiveAnchorUniform

/-- Four-factor tuple enumeration.  This is the same count with the `a`-sum
omitted, yielding the exponent in (5.3). -/
def FourTupleEnumeration : Prop :=
  AnchorLargeSieveTupleBound →
  RemainingAnalytic19.FourAnchorUniform

/-- Complete Proposition-5.1 source package.  The first field is the sole
finite polynomial-algebra bridge left by Repair 27.  The next three fields are
the good-reduction / published analytic inputs.  The last two are the explicit
tuple enumeration and dyadic-summation steps. -/
