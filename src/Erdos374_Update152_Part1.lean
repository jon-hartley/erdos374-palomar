/-- Repair 14 derives the direct two- and three-factor exclusion package from
the manuscript's global short-gap theorem, the eventual factorial-class growth
bound, and only elementary real-variable dominance. -/
theorem direct_two_three_package
    (hShort : Tasks.ShortSecondLargestGap)
    (hGrowth : Tasks.FactorialClassGrowth)
    (hDom : Tasks.DirectExclusionDominance) :
    ∃ E : Set ℕ, DensityZero E ∧ ∃ N : ℕ,
      ∀ m : ℕ, N ≤ m → m ∉ E → m ∈ B alpha →
        ¬ HasRep m 2 ∧ ¬ HasRep m 3 := by
  obtain ⟨E, hEzero, NS, hS⟩ := hShort
  obtain ⟨NG, hG⟩ := hGrowth
  obtain ⟨ND, hD⟩ := hDom NG
  refine ⟨E, hEzero, max (max NS ND) 2, ?_⟩
  intro m hmN hmE hmB
  have hmNS : NS ≤ m := by
    exact le_trans (le_max_left NS ND) (le_trans (le_max_left (max NS ND) 2) hmN)
  have hmND : ND ≤ m := by
    exact le_trans (le_max_right NS ND) (le_trans (le_max_left (max NS ND) 2) hmN)
  have hm2 : 2 ≤ m :=
    le_trans (le_max_right (max NS ND) 2) hmN
  have hm : 1 < m := by omega
  have hshortm := hS m hmNS hmE
  have hDm := hD m hmND
  constructor
  · intro hrep2
    obtain ⟨d, hd, hdm, hs, htheta⟩ :=
      two_of_hasRep_with_short hshortm hrep2
    exact no_two_square_of_B_shortGap hmB hm hd hdm hs htheta
  · intro hrep3
    obtain ⟨a, d, ha, had, hdm, hs, htheta⟩ :=
      three_of_hasRep_with_short hshortm hrep3
    have hmR1 : (1 : ℝ) ≤ m := by exact_mod_cast (show 1 ≤ m by omega)
    have heta : ((m - d : ℕ) : ℝ) ≤ (m : ℝ) ^ eta := by
      exact htheta.trans (rpow_theta_le_rpow_eta hmR1)
    have hgap : m - d < largestPrime m :=
      gap_lt_largestPrime_of_B hmB hm htheta
    by_cases hlargeA : NG ≤ a
    · have hgrowth : Real.exp ((a : ℝ) / 3) ≤ (q a : ℝ) :=
        hG a hlargeA
      exact no_three_square_of_B_bounds
        hmB hm ha had hdm hs htheta heta hgrowth hDm.2
    · have haNG : a < NG := by omega
      have haRNG : (a : ℝ) < (NG : ℝ) := by exact_mod_cast haNG
      have haP_R : (a : ℝ) < (largestPrime m : ℝ) :=
        lt_trans haRNG (lt_trans hDm.1 hmB.2)
      have haP : a < largestPrime m := by exact_mod_cast haP_R
      have hq0 : (q a).factorization (largestPrime m) = 0 :=
        q_factorization_eq_zero_of_index_lt_prime
          (largestPrime_prime hm) haP
      exact no_three_rep_of_largePrime_gap
        hmB.1 hm ha had hdm hgap hq0 hs


/-- Corollary 6.2, derived rather than assumed: outside one density-zero set
and beyond one cutoff, every four- and five-factor representation has both
gaps below `m^eta`. -/
theorem short_four_five_package
    (hShort : Tasks.ShortSecondLargestGap)
    (hComp : Tasks.IntervalLengthComparison)
    (hDom : Tasks.ShortGapDominance) :
    ∃ E : Set ℕ, DensityZero E ∧ ∃ N : ℕ, ∀ m : ℕ,
      N ≤ m → m ∉ E →
      (∀ b c d : ℕ, FourRep m b c d →
        ((c - b : ℕ) : ℝ) < (m : ℝ) ^ eta ∧
        ((m - d : ℕ) : ℝ) < (m : ℝ) ^ eta) ∧
      (∀ a b c d : ℕ, FiveRep m a b c d →
        ((c - b : ℕ) : ℝ) < (m : ℝ) ^ eta ∧
        ((m - d : ℕ) : ℝ) < (m : ℝ) ^ eta) := by
  obtain ⟨E, hEzero, NS, hS⟩ := hShort
  obtain ⟨NC, hC⟩ := hComp eta (by norm_num [eta])
  obtain ⟨ND, hD⟩ := hDom
  refine ⟨E, hEzero, max (max (max NS NC) ND) 2, ?_⟩
  intro m hmN hmE
  have hmNS : NS ≤ m := by
    exact le_trans (le_max_left NS NC)
      (le_trans (le_max_left (max NS NC) ND)
        (le_trans (le_max_left (max (max NS NC) ND) 2) hmN))
  have hmNC : NC ≤ m := by
    exact le_trans (le_max_right NS NC)
      (le_trans (le_max_left (max NS NC) ND)
        (le_trans (le_max_left (max (max NS NC) ND) 2) hmN))
  have hmND : ND ≤ m := by
    exact le_trans (le_max_right (max NS NC) ND)
      (le_trans (le_max_left (max (max NS NC) ND) 2) hmN)
  have hm2 : 2 ≤ m :=
    le_trans (le_max_right (max (max NS NC) ND) 2) hmN
  have hmgt : 1 < m := by omega
  have hmRgt : (1 : ℝ) < m := by exact_mod_cast hmgt
  have hthetaeta :
      (m : ℝ) ^ theta < (m : ℝ) ^ eta :=
    rpow_theta_lt_rpow_eta hmRgt
  have hlog0 : 0 ≤ Real.log (m : ℝ) :=
    Real.log_nonneg (by exact_mod_cast (show 1 ≤ m by omega))
  have hshortm := hS m hmNS hmE
  constructor
  · intro b c d hr
    have hellTheta :=
      fourRep_second_gap_from_short hr hshortm
    have hellEta :
        ((m - d : ℕ) : ℝ) < (m : ℝ) ^ eta :=
      lt_of_le_of_lt hellTheta hthetaeta
    constructor
    · by_contra hh
      have heta_h :
          (m : ℝ) ^ eta ≤ ((c - b : ℕ) : ℝ) :=
        le_of_not_gt hh
      have hell_hR :
          ((m - d : ℕ) : ℝ) < ((c - b : ℕ) : ℝ) :=
        lt_of_lt_of_le hellEta heta_h
      have hell_h : m - d ≤ c - b := by
        exact Nat.le_of_lt (by exact_mod_cast hell_hR)
      have hcomp :=
        hC m b c d hmNC (Or.inl hr) hell_h heta_h
      have hscale :
          4096 * ((m - d : ℕ) : ℝ) * Real.log (m : ℝ) ≤
            4096 * (m : ℝ) ^ theta * Real.log (m : ℝ) := by
        gcongr
      have hdom := hD m hmND
      linarith
    · exact hellEta
  · intro a b c d hr
    have hellTheta :=
      fiveRep_second_gap_from_short hr hshortm
    have hellEta :
        ((m - d : ℕ) : ℝ) < (m : ℝ) ^ eta :=
      lt_of_le_of_lt hellTheta hthetaeta
    constructor
    · by_contra hh
      have heta_h :
          (m : ℝ) ^ eta ≤ ((c - b : ℕ) : ℝ) :=
        le_of_not_gt hh
      have hell_hR :
          ((m - d : ℕ) : ℝ) < ((c - b : ℕ) : ℝ) :=
        lt_of_lt_of_le hellEta heta_h
      have hell_h : m - d ≤ c - b := by
        exact Nat.le_of_lt (by exact_mod_cast hell_hR)
      have hcomp :=
        hC m b c d hmNC (Or.inr ⟨a, hr⟩) hell_h heta_h
      have hscale :
          4096 * ((m - d : ℕ) : ℝ) * Real.log (m : ℝ) ≤
            4096 * (m : ℝ) ^ theta * Real.log (m : ℝ) := by
        gcongr
      have hdom := hD m hmND
      linarith
    · exact hellEta

/-- A common package for all short-gap and direct-exclusion conclusions used
by the exception ledger.  If the two underlying packages choose different
exceptional sets, take their union; it still has density zero. -/
theorem final_gap_exclusion_package
    (hShort : Tasks.ShortSecondLargestGap)
    (hGrowth : Tasks.FactorialClassGrowth)
    (hDirectDom : Tasks.DirectExclusionDominance)
    (hComp : Tasks.IntervalLengthComparison)
    (hShortDom : Tasks.ShortGapDominance) :
    ∃ E : Set ℕ, DensityZero E ∧ ∃ N : ℕ, ∀ m : ℕ,
      N ≤ m → m ∉ E →
      (∀ b c d : ℕ, FourRep m b c d →
        ((c - b : ℕ) : ℝ) < (m : ℝ) ^ eta ∧
        ((m - d : ℕ) : ℝ) < (m : ℝ) ^ eta) ∧
      (∀ a b c d : ℕ, FiveRep m a b c d →
        ((c - b : ℕ) : ℝ) < (m : ℝ) ^ eta ∧
        ((m - d : ℕ) : ℝ) < (m : ℝ) ^ eta) ∧
      (m ∈ B alpha → ¬ HasRep m 2 ∧ ¬ HasRep m 3) := by
  obtain ⟨E1, hE1, N1, h15⟩ :=
    short_four_five_package hShort hComp hShortDom
  obtain ⟨E2, hE2, N2, h23⟩ :=
    direct_two_three_package hShort hGrowth hDirectDom
  refine ⟨E1 ∪ E2, densityZero_union hE1 hE2, max N1 N2, ?_⟩
  intro m hmN hmE
  have hmN1 : N1 ≤ m := le_trans (le_max_left N1 N2) hmN
  have hmN2 : N2 ≤ m := le_trans (le_max_right N1 N2) hmN
  have hmE1 : m ∉ E1 := by
    intro h
    exact hmE (Or.inl h)
  have hmE2 : m ∉ E2 := by
    intro h
    exact hmE (Or.inr h)
  have hsf := h15 m hmN1 hmE1
  have hdt := h23 m hmN2 hmE2
  exact ⟨hsf.1, hsf.2, hdt⟩

/-! ## 8. Explicit outstanding proof obligations used by final assembly

This record is deliberately named `RemainingProofs`, not `ExternalTheorems`:
several fields are the manuscript's NEW derived estimates or their consequences.
Repairs 3 and 6 have removed both paired four- and five-factor cases from
this record by proving them above. Repair 5 supplied the factorial square-class
reduction used in the five-factor proof. Repair 7 proves the exact two-interval
factorial cancellation (1.4). Repair 8 adds exact extraction and cancellation lemmas
for two- and three-factor representations. Repair 9 formalizes the largest-prime
witness and the odd-factorization obstruction. Repair 10 proves that a prime divisor
of the endpoint occurs exactly once in any upper interval shorter than that prime,
and obtains conditional two- and three-factor exclusion lemmas. Repair 11 proves
that in a three-factor representation the squarefree kernel `q a` divides the upper
interval product, hence `q a ≤ m^(m-d)`, and combines this with the Lemma 3.1 growth
input. Repair 12 takes logarithms to obtain `a ≤ 3(m-d)log m`, proves that any prime
larger than `a` is absent from `q a`, and packages the full three-factor contradiction.
Repair 13 proves the fixed exponent comparison `m^theta < m^(1-alpha)` for `m>1`,
derives the largest-prime gap bound from membership in `B alpha`, and packages
representation-level two- and three-factor exclusions. Repair 14 now wires
`Tasks.ShortSecondLargestGap` and `Tasks.FactorialClassGrowth` into a single
direct-exclusion package, with only the elementary eventual power/log comparison
isolated as `Tasks.DirectExclusionDominance`. Repair 15 goes further: it derives the four/five short-gap conclusions from
`ShortSecondLargestGap + IntervalLengthComparison`, combines them with the direct
two/three package, and introduces `RemainingProofs15`, a reduced final interface
with none of `short_four`, `short_five`, or `two_three` assumed.
The record has no inhabitant in this project. Supplying an assumed value of the
record is not a formal proof of the paper. See OBLIGATIONS.md for the dependency
of each field on the granular tasks above and on the external analytic inputs.
-/

structure RemainingProofs where
  deltaA : ℝ
  deltaA_pos : 0 < deltaA
  /-- Lemma 3.2: proof of the density of the specific set A is still required. -/
  A_density : HasDensity A deltaA
  /-- Proposition 3.5 specialized to alpha=1/100. -/
  B_density : HasDensity (B alpha) (densityConstant deltaA)
  /-- PNT plus the elementary classification of noncomposites (including 0,1). -/
  noncomposite_zero : DensityZero {m : ℕ | ¬ Composite m}
  /-- The ONE endpoint exceptional set arising from Harman and Lemma 6.1. -/
  exceptional : Set ℕ
  exceptional_zero : DensityZero exceptional
  /-- A common cutoff absorbing all finitely many initial exceptions. -/
  cutoff : ℕ
  /-- Corollary 6.2, simultaneously for every four-factor representation. -/
  short_four : ∀ m b c d : ℕ, cutoff ≤ m → m ∉ exceptional → FourRep m b c d →
    ((c - b : ℕ) : ℝ) < (m : ℝ) ^ eta ∧
    ((m - d : ℕ) : ℝ) < (m : ℝ) ^ eta
  /-- Corollary 6.2, simultaneously for every five-factor representation. -/
  short_five : ∀ m a b c d : ℕ, cutoff ≤ m → m ∉ exceptional →
    FiveRep m a b c d →
    ((c - b : ℕ) : ℝ) < (m : ℝ) ^ eta ∧
    ((m - d : ℕ) : ℝ) < (m : ℝ) ^ eta
  /-- The direct two/three-factor exclusions in §6.1. -/
  two_three : ∀ m : ℕ, m ∈ B alpha → cutoff ≤ m → m ∉ exceptional →
    ¬ HasRep m 2 ∧ ¬ HasRep m 3
  /-- Proposition 5.1 plus X^(7/8) log X = o(X). -/
  anchor_four_zero : DensityZero (NonpairedFour alpha eta)
  /-- Proposition 5.1 plus X^(199/200) (log X)^2 = o(X). -/
  anchor_five_zero : DensityZero (NonpairedFive alpha eta)

/-- Every category in the exception ledger (6.3), at the density-zero level. -/
def badSet (H : RemainingProofs) : Set ℕ :=
  {m : ℕ | ¬ Composite m} ∪
    (H.exceptional ∪ (Initial H.cutoff ∪
      (NonpairedFour alpha eta ∪ NonpairedFive alpha eta)))

theorem badSet_densityZero (H : RemainingProofs) : DensityZero (badSet H) := by
  exact densityZero_union H.noncomposite_zero
    (densityZero_union H.exceptional_zero
      (densityZero_union (densityZero_initial H.cutoff)
        (densityZero_union H.anchor_four_zero H.anchor_five_zero)))

/-- Conditional combinatorial assembly of the exception ledger. -/
theorem difference_subset_badSet (H : RemainingProofs) :
    B alpha \ D6 ⊆ badSet H := by
  classical
  intro m hm
  by_contra hbad
  have hc : Composite m := by
    by_contra hnc
    exact hbad (Or.inl hnc)
  have hE : m ∉ H.exceptional := by
    intro he
