/-! ## 17. Repair 22: actual Harman → Lemma 6.1 formalization

This repair replaces the abstract `HarmanToSecondLargestBridge` field by an
actual proof.  The key arithmetic fact is that if `p ≤ m < 2p`, then `p`
occurs exactly once in `m!`.  Hence a square product of distinct factorials
ending at `m!` must have its second-largest index at least `p`.
-/

/-- If `p` is prime and `p ≤ m < 2p`, then its exponent in `m!` is exactly 1. -/
theorem factorization_factorial_eq_one_of_prime_le_lt_two_mul
    {p m : ℕ} (hp : p.Prime) (hpm : p ≤ m) (hm2p : m < 2 * p) :
    m.factorial.factorization p = 1 := by
  obtain ⟨t, rfl⟩ := Nat.exists_eq_add_of_le hpm
  have htp : t < p := by omega
  induction t with
  | zero =>
      change p.factorial.factorization p = 1
      have hprev :
          (p - 1).factorial.factorization p = 0 :=
        Nat.factorization_factorial_eq_zero_of_lt (by omega)
      have hpfac : p.factorial = p * (p - 1).factorial := by
        rw [factorial_predecessor p (by omega)]
      rw [hpfac, Nat.factorization_mul (by omega) (Nat.factorial_ne_zero _)]
      simp [hp.factorization_self, hprev]
  | succ t ih =>
      have htlt : t < p := by omega
      have ht1lt : t + 1 < p := by omega
      have hnotdvd : ¬ p ∣ (p + (t + 1)) := by
        rintro ⟨q, hq⟩
        have hqpos : 0 < q := by
          by_contra hz
          have hq0 : q = 0 := by omega
          subst q
          simp at hq
        have hqgt : 1 < q := by
          by_contra h
          have hq1 : q = 1 := by omega
          subst q
          simp at hq
        have hp2 : 2 ≤ p := hp.two_le
        have hq2 : 2 ≤ q := by omega
        nlinarith [Nat.mul_le_mul hp2 hq2]
      have hnew0 : (p + (t + 1)).factorization p = 0 :=
        Nat.factorization_eq_zero_of_not_dvd hnotdvd
      have hfac :
          (p + (t + 1)).factorial =
            (p + (t + 1)) * (p + t).factorial := by
        rw [factorial_predecessor (p + (t + 1)) (by omega)]
        congr 1
      have ih' : (p + t).factorial.factorization p = 1 :=
        ih (by omega) (by omega) (by omega)
      rw [hfac, Nat.factorization_mul (by omega) (Nat.factorial_ne_zero _)]
      simpa [hnew0] using ih'

/-- In a representation with at least two factorials, every non-final index
is at most the second-largest index. -/
theorem representation_index_le_second
    {m k : ℕ} (hk : 2 ≤ k) (r : Representation m k)
    (i : Fin k) (hi : i ≠ ⟨k - 1, by omega⟩) :
    r.index i ≤ r.index ⟨k - 2, by omega⟩ := by
  have hilast : i.val < k - 1 := by
    have hile : i.val ≤ k - 1 := by omega
    by_contra hnot
    have hieq : i.val = k - 1 := by omega
    apply hi
    apply Fin.ext
    exact hieq
  have hisecond : i.val ≤ k - 2 := by omega
  by_cases heq : i = ⟨k - 2, by omega⟩
  · rw [heq]
  · have hlt : i < ⟨k - 2, by omega⟩ := by
      apply Fin.mk_lt_mk.mpr
      have hneval : i.val ≠ k - 2 := by
        intro h
        apply heq
        apply Fin.ext
        exact h
      omega
    exact le_of_lt (r.increasing hlt)

/-- If a prime lies in `(m/2,m]`, a square factorial representation ending
at `m!` must have second-largest index at least that prime. -/
theorem representation_second_index_ge_top_prime
    {m k p : ℕ} (hk : 2 ≤ k) (r : Representation m k)
    (hp : p.Prime) (hpm : p ≤ m) (hm2p : m < 2 * p) :
    p ≤ r.index ⟨k - 2, by omega⟩ := by
  by_contra hbad
  have hsecondlt : r.index ⟨k - 2, by omega⟩ < p := by omega
  let last : Fin k := ⟨k - 1, by omega⟩
  have hlast : r.index last = m := by
    apply r.endpoint
    dsimp [last]
    omega
  have hprod :
      (∏ i : Fin k, (r.index i).factorial).factorization p = 1 := by
    rw [Nat.factorization_prod_apply]
    · rw [Finset.sum_eq_single last]
      · rw [hlast]
        exact factorization_factorial_eq_one_of_prime_le_lt_two_mul
          hp hpm hm2p
      · intro i hi hne
        have hile :
            r.index i ≤ r.index ⟨k - 2, by omega⟩ :=
          representation_index_le_second hk r i hne
        have hilt : r.index i < p := lt_of_le_of_lt hile hsecondlt
        exact Nat.factorization_factorial_eq_zero_of_lt hilt
      · intro hnotmem
        simp at hnotmem
    · intro i hi
      exact Nat.factorial_ne_zero _
  have hsquare : IsSquare (∏ i : Fin k, (r.index i).factorial) :=
    (natSquare_iff_isSquare _).mp r.square
  have heven :
      Even ((∏ i : Fin k, (r.index i).factorial).factorization p) :=
    (Nat.isSquare_iff_even_factorization.mp hsquare) p hp
  rw [hprod] at heven
  norm_num [Even] at heven

/-- Eventually `m^theta < m/2`. -/
theorem theta_power_lt_half_eventually :
    ∃ N : ℕ, ∀ m : ℕ, N ≤ m →
      2 * (m : ℝ) ^ theta < (m : ℝ) := by
  have hexp : 0 < (1 - theta : ℝ) := by
    norm_num [theta]
  have ht :
      Tendsto (fun n : ℕ => (n : ℝ) ^ (1 - theta))
        atTop atTop :=
    (tendsto_rpow_atTop hexp).comp tendsto_natCast_atTop_atTop
  have hev :
      ∀ᶠ n : ℕ in atTop, (2 : ℝ) < (n : ℝ) ^ (1 - theta) :=
    ht.eventually (eventually_gt_atTop 2)
  have htwo : ∀ᶠ n : ℕ in atTop, 2 ≤ n := eventually_ge_atTop 2
  have hall :
      ∀ᶠ n : ℕ in atTop, 2 * (n : ℝ) ^ theta < (n : ℝ) := by
    filter_upwards [hev, htwo] with n hn hn2
    have hnR : (0 : ℝ) < n := by
      exact_mod_cast (show 0 < n by omega)
    have htheta : 0 < (n : ℝ) ^ theta :=
      Real.rpow_pos_of_pos hnR _
    have hmul :
        2 * (n : ℝ) ^ theta <
          (n : ℝ) ^ (1 - theta) * (n : ℝ) ^ theta :=
      mul_lt_mul_of_pos_right hn htheta
    have hpow :
        (n : ℝ) ^ (1 - theta) * (n : ℝ) ^ theta = (n : ℝ) := by
      rw [← Real.rpow_add hnR]
      ring_nf
      simp
    simpa [hpow] using hmul
  exact eventually_atTop.1 hall

/-- The Harman short-prime interval statement implies the manuscript's
representation-uniform second-largest-gap conclusion. -/
theorem harman_to_secondLargest_proved :
    RemainingAnalytic21.HarmanToSecondLargestBridge := by
  intro hH
  obtain ⟨E, hEzero, NH, hH⟩ := hH
  obtain ⟨NP, hP⟩ := theta_power_lt_half_eventually
  refine ⟨E, hEzero, max NH NP, ?_⟩
  intro m hmN hmE k hk r
  have hmH : NH ≤ m := le_trans (le_max_left NH NP) hmN
  have hmP : NP ≤ m := le_trans (le_max_right NH NP) hmN
  obtain ⟨p, hp, hpm, hgap⟩ := hH m hmH hmE
  have hhalf := hP m hmP
  have hgapNat : 2 * (m - p) < m := by
    have hgapR : (2 : ℝ) * (m - p : ℕ) < (m : ℝ) := by
      calc
        (2 : ℝ) * (m - p : ℕ)
            ≤ 2 * (m : ℝ) ^ theta := by gcongr
        _ < (m : ℝ) := hhalf
    exact_mod_cast hgapR
  have hm2p : m < 2 * p := by omega
  have hpsecond :
      p ≤ r.index ⟨k - 2, by omega⟩ :=
    representation_second_index_ge_top_prime hk r hp hpm hm2p
  have hgapIndex : m - r.index ⟨k - 2, by omega⟩ ≤ m - p :=
    Nat.sub_le_sub_left hpsecond m
  have hgapIndexR :
      ((m - r.index ⟨k - 2, by omega⟩ : ℕ) : ℝ) ≤
        ((m - p : ℕ) : ℝ) := by exact_mod_cast hgapIndex
  exact hgapIndexR.trans hgap

/-! ### Corollary 4.3: concrete valuation-transfer lemmas -/

/-- A prime appearing once in the lower interval and not in `q a` must appear
in the upper interval if the reduced five-factor product is a square. -/
theorem prime_dvd_upper_of_five_square
    {a h c ell m p : ℕ}
    (hp : p.Prime)
    (hpa : a < p)
    (hlow : (falling h c).factorization p = 1)
    (hellm : ell ≤ m)
    (hsq : NatSquare (q a * falling h c * falling ell m)) :
    p ∣ falling ell m := by
  have hq0 : (q a).factorization p = 0 :=
    q_factorization_eq_zero_of_index_lt_prime hp hpa
  have hqne : q a ≠ 0 := q_ne_zero a
  have hlowne : falling h c ≠ 0 := by
    by_contra hz
    rw [hz] at hlow
    simp at hlow
  have hupperne : falling ell m ≠ 0 :=
    Nat.ne_of_gt (falling_pos_of_le hellm)
  have hfac :
      (q a * falling h c * falling ell m).factorization p =
        (falling ell m).factorization p + 1 := by
    rw [Nat.factorization_mul (Nat.mul_ne_zero hqne hlowne) hupperne]
    rw [Nat.factorization_mul hqne hlowne]
    change (q a).factorization p + (falling h c).factorization p +
      (falling ell m).factorization p =
        (falling ell m).factorization p + 1
    rw [hq0, hlow]
    omega
  have his : IsSquare (q a * falling h c * falling ell m) :=
    (natSquare_iff_isSquare _).mp hsq
  have hev :
      Even ((q a * falling h c * falling ell m).factorization p) :=
    (Nat.isSquare_iff_even_factorization.mp his) p hp
  rw [hfac] at hev
  by_contra hnot
  have hz : (falling ell m).factorization p = 0 :=
    Nat.factorization_eq_zero_of_not_dvd hnot
  rw [hz] at hev
  norm_num [Even] at hev

/-- The same parity-transfer statement for the four-factor reduced product. -/
theorem prime_dvd_upper_of_four_square
    {h c ell m p : ℕ}
    (hp : p.Prime)
    (hlow : (falling h c).factorization p = 1)
    (hellm : ell ≤ m)
    (hsq : NatSquare (falling h c * falling ell m)) :
    p ∣ falling ell m := by
  have hlowne : falling h c ≠ 0 := by
    by_contra hz
    rw [hz] at hlow
    simp at hlow
  have hupperne : falling ell m ≠ 0 :=
    Nat.ne_of_gt (falling_pos_of_le hellm)
  have hfac :
      (falling h c * falling ell m).factorization p =
        (falling ell m).factorization p + 1 := by
    rw [Nat.factorization_mul hlowne hupperne]
    change (falling h c).factorization p +
      (falling ell m).factorization p =
        (falling ell m).factorization p + 1
    rw [hlow]
    omega
  have his : IsSquare (falling h c * falling ell m) :=
    (natSquare_iff_isSquare _).mp hsq
  have hev :
      Even ((falling h c * falling ell m).factorization p) :=
    (Nat.isSquare_iff_even_factorization.mp his) p hp
  rw [hfac] at hev
  by_contra hnot
  have hz : (falling ell m).factorization p = 0 :=
    Nat.factorization_eq_zero_of_not_dvd hnot
  rw [hz] at hev
  norm_num [Even] at hev

