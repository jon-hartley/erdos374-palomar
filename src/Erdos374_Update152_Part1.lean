/-! ## 26. Repair 27: genuine polynomial nonsquare bridge

Repair 26 proved the concrete root-list mismatch from manuscript (5.7).  This
repair upgrades the formal statement on the polynomial side: a polynomial
with a simple rational root cannot be a nonzero scalar multiple of a square.

The remaining bridge from the Repair-26 root-list mismatch to an actual
`rootMultiplicity = 1` statement for `anchorPolynomial` is isolated explicitly
as `AnchorSimpleRoot`.  Thus the old Repair-21 `True` payload is no longer the
mathematical nonsquare statement used here.
-/

namespace RemainingAnalytic27

/-- A genuine polynomial formulation of "not a nonzero scalar times a square". -/
def NotNonzeroScalarSquare (f : Polynomial ℚ) : Prop :=
  ¬ ∃ κ : ℚ, ∃ g : Polynomial ℚ,
      κ ≠ 0 ∧ f = Polynomial.C κ * g ^ 2

/-- The exact simple-root output needed from the root-list analysis. -/
def AnchorSimpleRoot : Prop :=
  ∀ a r j t h ell : ℕ,
    0 < j → j < r → 0 < h → 0 < ell → t < h →
    (h ≠ 1 ∨ ell ≠ 1) →
    ∃ x : ℚ,
      Polynomial.rootMultiplicity x (Tasks.anchorPolynomial a r j t h ell) = 1

/-- Genuine nonsquare statement for the anchor polynomial. -/
def AnchorPolynomialNonsquareGenuine : Prop :=
  ∀ a r j t h ell : ℕ,
    0 < j → j < r → 0 < h → 0 < ell → t < h →
    (h ≠ 1 ∨ ell ≠ 1) →
    NotNonzeroScalarSquare (Tasks.anchorPolynomial a r j t h ell)

end RemainingAnalytic27

/-- Every nonzero scalar multiple of a square has even root multiplicity.
This is the algebraic parity fact behind the manuscript's nonsquare argument. -/
theorem rootMultiplicity_even_of_nonzero_scalar_square
    {f g : Polynomial ℚ} {κ x : ℚ}
    (hκ : κ ≠ 0) (hf : f = Polynomial.C κ * g ^ 2) :
    Even (Polynomial.rootMultiplicity x f) := by
  subst f
  by_cases hg : g = 0
  · subst g
    simp
  · have hC : Polynomial.C κ ≠ (0 : Polynomial ℚ) := by
      simp [hκ]
    have hgg : g * g ≠ (0 : Polynomial ℚ) := mul_ne_zero hg hg
    have hprod : Polynomial.C κ * (g * g) ≠ (0 : Polynomial ℚ) :=
      mul_ne_zero hC hgg
    have hmul1 := Polynomial.rootMultiplicity_mul (x := x) hprod
    have hmul2 := Polynomial.rootMultiplicity_mul (x := x) hgg
    rw [pow_two]
    rw [hmul1, hmul2]
    simp only [Polynomial.rootMultiplicity_C, zero_add]
    refine ⟨Polynomial.rootMultiplicity x g, ?_⟩
    omega

/-- A simple root rules out a nonzero scalar-square representation. -/
theorem notNonzeroScalarSquare_of_rootMultiplicity_one
    {f : Polynomial ℚ} {x : ℚ}
    (hx : Polynomial.rootMultiplicity x f = 1) :
    RemainingAnalytic27.NotNonzeroScalarSquare f := by
  rintro ⟨κ, g, hκ, hf⟩
  have hev : Even (Polynomial.rootMultiplicity x f) :=
    rootMultiplicity_even_of_nonzero_scalar_square hκ hf
  rw [hx] at hev
  norm_num [Even] at hev

/-- The simple-root form of the anchor argument implies the genuine polynomial
nonsquare statement uniformly in every tuple. -/
theorem anchorPolynomialNonsquare_of_simpleRoot
    (H : RemainingAnalytic27.AnchorSimpleRoot) :
    RemainingAnalytic27.AnchorPolynomialNonsquareGenuine := by
  intro a r j t h ell hj hjr hh hell hth hnp
  obtain ⟨x, hx⟩ := H a r j t h ell hj hjr hh hell hth hnp
  exact notNonzeroScalarSquare_of_rootMultiplicity_one hx

/-- Repair 26 supplies the root-list mismatch for every legal nonpaired tuple.
This records the exact remaining local bridge: prove that such a mismatch gives
an actual simple root of `anchorPolynomial`. -/
def RemainingAnalytic27.RootMismatchToSimpleRoot : Prop :=
  ∀ a r j t h ell : ℕ,
    0 < j → j < r → 0 < h → 0 < ell → t < h →
    (h ≠ 1 ∨ ell ≠ 1) →
    RemainingAnalytic26.AnchorRootMismatch r j t h ell →
    ∃ x : ℚ,
      Polynomial.rootMultiplicity x (Tasks.anchorPolynomial a r j t h ell) = 1

/-- The Repair-26 theorem plus the one explicit polynomial-factor bridge gives
`AnchorSimpleRoot`. -/
theorem anchorSimpleRoot_of_rootMismatchBridge
    (H : RemainingAnalytic27.RootMismatchToSimpleRoot) :
    RemainingAnalytic27.AnchorSimpleRoot := by
  intro a r j t h ell hj hjr hh hell hth hnp
  apply H a r j t h ell hj hjr hh hell hth hnp
  exact anchor_root_mismatch_proved hj hjr hh hell hth hnp

/-- Therefore the sole remaining polynomial-algebra step implies the genuine
anchor nonsquare theorem used before good reduction and Weil. -/
theorem anchorPolynomialNonsquareGenuine_of_rootMismatchBridge
    (H : RemainingAnalytic27.RootMismatchToSimpleRoot) :
    RemainingAnalytic27.AnchorPolynomialNonsquareGenuine :=
  anchorPolynomialNonsquare_of_simpleRoot
    (anchorSimpleRoot_of_rootMismatchBridge H)

