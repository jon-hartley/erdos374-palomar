  have hboundR :
      ∀ᶠ x : ℝ in atTop,
        ‖Real.log x ^ (2 : ℝ)‖ ≤
          (ε / (2 * C)) * ‖x ^ (1 / 200 : ℝ)‖ :=
    hlo.def hcoeff
  have hboundN :
      ∀ᶠ n : ℕ in atTop,
        ‖Real.log (n : ℝ) ^ (2 : ℝ)‖ ≤
          (ε / (2 * C)) *
            ‖(n : ℝ) ^ (1 / 200 : ℝ)‖ :=
    tendsto_natCast_atTop_atTop.eventually hboundR
  have htwo : ∀ᶠ n : ℕ in atTop, 2 ≤ n := eventually_ge_atTop 2
  have hall :
      ∀ᶠ n : ℕ in atTop,
        C * (n : ℝ) ^ ((199 : ℝ) / 200) *
            (Real.log (n : ℝ)) ^ 2 <
          ε * (n : ℝ) := by
    filter_upwards [hboundN, htwo] with n hb hn2
    have hnR : (1 : ℝ) < n := by
      exact_mod_cast (show 1 < n by omega)
    have hnpos : 0 < (n : ℝ) := lt_trans (by norm_num) hnR
    have hlogpos : 0 < Real.log (n : ℝ) := Real.log_pos hnR
    have hp1 : 0 < (n : ℝ) ^ (1 / 200 : ℝ) :=
      Real.rpow_pos_of_pos hnpos _
    have hp199 : 0 < (n : ℝ) ^ ((199 : ℝ) / 200) :=
      Real.rpow_pos_of_pos hnpos _
    have hlog2pos : 0 < (Real.log (n : ℝ)) ^ 2 := sq_pos_of_pos hlogpos
    have hlog2le :
        (Real.log (n : ℝ)) ^ 2 ≤
          (ε / (2 * C)) * (n : ℝ) ^ (1 / 200 : ℝ) := by
      change |Real.log (n : ℝ) ^ (2 : ℝ)| ≤
        (ε / (2 * C)) * |(n : ℝ) ^ (1 / 200 : ℝ)| at hb
      have hlogrpow2 : 0 < Real.log (n : ℝ) ^ (2 : ℝ) :=
        Real.rpow_pos_of_pos hlogpos _
      rw [abs_of_pos hlogrpow2, abs_of_pos hp1] at hb
      simpa [Real.rpow_two] using hb
    have hmul :
        C * (n : ℝ) ^ ((199 : ℝ) / 200) *
            (Real.log (n : ℝ)) ^ 2 ≤
          C * (n : ℝ) ^ ((199 : ℝ) / 200) *
            ((ε / (2 * C)) * (n : ℝ) ^ (1 / 200 : ℝ)) := by
      exact mul_le_mul_of_nonneg_left hlog2le
        (le_of_lt (mul_pos hC hp199))
    have hpow :
        (n : ℝ) ^ ((199 : ℝ) / 200) *
            (n : ℝ) ^ (1 / 200 : ℝ) = (n : ℝ) := by
      rw [← Real.rpow_add hnpos]
      norm_num
    have hcoeffeq : C * (ε / (2 * C)) = ε / 2 := by
      field_simp [ne_of_gt hC]
    have heq :
        C * (n : ℝ) ^ ((199 : ℝ) / 200) *
            ((ε / (2 * C)) * (n : ℝ) ^ (1 / 200 : ℝ)) =
          (ε / 2) * (n : ℝ) := by
      calc
        C * (n : ℝ) ^ ((199 : ℝ) / 200) *
              ((ε / (2 * C)) * (n : ℝ) ^ (1 / 200 : ℝ))
            =
              (C * (ε / (2 * C))) *
                ((n : ℝ) ^ ((199 : ℝ) / 200) *
                  (n : ℝ) ^ (1 / 200 : ℝ)) := by ring
        _ = (ε / 2) *
              ((n : ℝ) ^ ((199 : ℝ) / 200) *
                (n : ℝ) ^ (1 / 200 : ℝ)) := by rw [hcoeffeq]
        _ = (ε / 2) * (n : ℝ) := by rw [hpow]
    rw [heq] at hmul
    have hhalf : (ε / 2) * (n : ℝ) < ε * (n : ℝ) := by
      nlinarith
    exact lt_of_le_of_lt hmul hhalf
  obtain ⟨N, hN⟩ := eventually_atTop.1 hall
  exact ⟨N, hN⟩

/-- Convert an eventual prefix-count bound to density zero.  This theorem is
completely generic and will be reused for both anchor populations. -/
theorem densityZero_of_eventual_count_lt
    {S : Set ℕ}
    (hdecay : ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ X : ℕ, N ≤ X →
      (prefixCount S X : ℝ) < ε * (X : ℝ)) :
    DensityZero S := by
  intro ε hε
  obtain ⟨N, hN⟩ := hdecay ε hε
  refine ⟨max N 1, ?_⟩
  intro X hX
  have hNX : N ≤ X := le_trans (le_max_left N 1) hX
  have hX1 : 1 ≤ X := le_trans (le_max_right N 1) hX
  have hXpos : (0 : ℝ) < X := by
    exact_mod_cast (show 0 < X by omega)
  have hc := hN X hNX
  have hp : proportion S X < ε := by
    unfold proportion
    exact (div_lt_iff₀ hXpos).2 hc
  have hn := proportion_nonneg S X
  simpa [sub_zero, abs_of_nonneg hn] using hp

