/-- Concrete code used for four-factor counting. -/
structure FourCode where
  r : ℕ
  j : ℕ
  h : ℕ
  t : ℕ
  ell : ℕ
  P : ℕ
deriving DecidableEq

/-- Concrete code used for five-factor counting. -/
structure FiveCode extends FourCode where
  a : ℕ
deriving DecidableEq

/-- Positive `j<r` choices. -/
def jChoices (r : ℕ) : Finset ℕ :=
  (Finset.range r).filter (fun j => 1 ≤ j)

/-- Positive `ell≤H` choices that remain nonpaired with `h`. -/
def ellChoices (H h : ℕ) : Finset ℕ :=
  (Finset.Icc 1 H).filter (fun ell => h ≠ 1 ∨ ell ≠ 1)

/-- Four-factor code space for one dyadic scale. -/
def fourCodes (X R H : ℕ) : Finset FourCode :=
  ((Finset.Icc 1 R).filter (fun r => r ≤ X)).biUnion fun r =>
    (jChoices r).biUnion fun j =>
      (Finset.Icc 1 H).biUnion fun h =>
        (Finset.range h).biUnion fun t =>
          (ellChoices H h).biUnion fun ell =>
            (RemainingAnalytic28.AnchorSquareArgs
              0 r j t h ell (X / r)).image fun P =>
                { r := r, j := j, h := h, t := t, ell := ell, P := P }

/-- Five-factor code space. -/
def fiveCodes (X R H Amax : ℕ) : Finset FiveCode :=
  ((Finset.Icc 1 R).filter (fun r => r ≤ X)).biUnion fun r =>
    (Finset.Icc 1 Amax).biUnion fun a =>
      (jChoices r).biUnion fun j =>
        (Finset.Icc 1 H).biUnion fun h =>
          (Finset.range h).biUnion fun t =>
            (ellChoices H h).biUnion fun ell =>
              (RemainingAnalytic28.AnchorSquareArgs
                a r j t h ell (X / r)).image fun P =>
                  { r := r, j := j, h := h, t := t, ell := ell, P := P, a := a }

/-- Endpoint represented by a four-factor code. -/
def FourCode.endpoint (c : FourCode) : ℕ := c.r * c.P

/-- Endpoint represented by a five-factor code. -/
def FiveCode.endpoint (c : FiveCode) : ℕ := c.r * c.P

/-- Real-cardinality union bound, used repeatedly below. -/
theorem card_biUnion_cast_le_sum
    {ι β : Type*} [DecidableEq β]
    (s : Finset ι) (f : ι → Finset β) :
    (((s.biUnion f).card : ℕ) : ℝ) ≤
      ∑ x ∈ s, (((f x).card : ℕ) : ℝ) := by
  exact_mod_cast (Finset.card_biUnion_le (s := s) (t := f))

/-- If every fiber has real cardinality at most `B`, the union has cardinality
at most `|s| B`. -/
theorem card_biUnion_cast_le_card_mul
    {ι β : Type*} [DecidableEq β]
    (s : Finset ι) (f : ι → Finset β) (B : ℝ)
    (hB : ∀ x ∈ s, (((f x).card : ℕ) : ℝ) ≤ B) :
    (((s.biUnion f).card : ℕ) : ℝ) ≤ (s.card : ℝ) * B := by
  calc
    (((s.biUnion f).card : ℕ) : ℝ)
        ≤ ∑ x ∈ s, (((f x).card : ℕ) : ℝ) :=
          card_biUnion_cast_le_sum s f
    _ ≤ ∑ _x ∈ s, B := by
          apply Finset.sum_le_sum
          intro x hx
          exact hB x hx
    _ = (s.card : ℝ) * B := by simp

/-- Images do not increase real cardinality. -/
theorem card_image_cast_le
    {α β : Type*} [DecidableEq β]
    (f : α → β) (s : Finset α) :
    ((((s.image f).card : ℕ) : ℝ)) ≤ (s.card : ℝ) := by
  exact_mod_cast Finset.card_image_le

/-- Elementary cardinality bounds for the finite coordinate ranges. -/
theorem jChoices_card_le (r : ℕ) :
    (jChoices r).card ≤ r := by
  exact le_trans (Finset.card_le_card (Finset.filter_subset _ _)) (by simp)

theorem ellChoices_card_le (H h : ℕ) :
    (ellChoices H h).card ≤ H := by
  calc
    (ellChoices H h).card
        ≤ (Finset.Icc 1 H).card :=
          Finset.card_le_card (Finset.filter_subset _ _)
    _ ≤ H := by simp

theorem Icc_one_card_le (H : ℕ) :
    (Finset.Icc 1 H).card ≤ H := by simp

