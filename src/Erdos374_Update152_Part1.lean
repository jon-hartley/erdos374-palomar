  have hN : H.cutoff ≤ m := by
    by_contra hn
    have hi : m ∈ Initial H.cutoff := by change m < H.cutoff; omega
    exact hbad (Or.inr (Or.inr (Or.inl hi)))
  have h4 : m ∉ NonpairedFour alpha eta := by
    intro hh
    exact hbad (Or.inr (Or.inr (Or.inr (Or.inl hh))))
  have h5 : m ∉ NonpairedFive alpha eta := by
    intro hh
    exact hbad (Or.inr (Or.inr (Or.inr (Or.inr hh))))
  have hno : ∀ k : ℕ, 2 ≤ k → k < 6 → ¬ HasRep m k := by
    intro k hk hk6 hrep
    interval_cases k
    · exact (H.two_three m hm.1 hN hE).1 hrep
    · exact (H.two_three m hm.1 hN hE).2 hrep
    · obtain ⟨b, c, d, hr⟩ := four_of_hasRep hrep
      have hg := H.short_four m b c d hN hE hr
      by_cases hp : c - b = 1 ∧ m - d = 1
      · exact paired_four_proved m b c d hm.1.1 hr hp.1 hp.2
      · have hnp : c - b ≠ 1 ∨ m - d ≠ 1 := by tauto
        exact h4 ⟨hm.1.2, b, c, d, hr, hnp, le_of_lt hg.1, le_of_lt hg.2⟩
    · obtain ⟨a, b, c, d, hr⟩ := five_of_hasRep hrep
