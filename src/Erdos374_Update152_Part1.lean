/-! ## 1. Exact objects and endpoint convention (manuscript §1) -/

/-- A square in the nonnegative integers; this is not squareness in the reals. -/
def NatSquare (n : ℕ) : Prop := ∃ z : ℕ, n = z ^ 2

/-- An ordered list of `k` distinct positive factorial indices ending at `m`.
The use of `Fin k` is the zero-based encoding of `a₁ < ... < aₖ = m`. -/
structure Representation (m k : ℕ) where
  index : Fin k → ℕ
  increasing : StrictMono index
  positive : ∀ i, 1 ≤ index i
  endpoint : ∀ i : Fin k, i.val + 1 = k → index i = m
  square : NatSquare (∏ i : Fin k, (index i).factorial)

/-- At least two factors, as in the definition of F in the source. -/
def HasRep (m k : ℕ) : Prop :=
  2 ≤ k ∧ Nonempty (Representation m k)

/-- Direct minimum formulation of `F(m) = 6`, avoiding an infinity convention. -/
def D6 : Set ℕ :=
  {m | 1 < m ∧ HasRep m 6 ∧ ∀ k : ℕ, 2 ≤ k → k < 6 → ¬ HasRep m k}

/-- Squarefree kernel: product of primes with odd valuation. Only positive
arguments are mathematically used in this project. -/
def sf (n : ℕ) : ℕ :=
  ∏ p ∈ n.primeFactors.filter (fun p => n.factorization p % 2 = 1), p

def q (a : ℕ) : ℕ := sf a.factorial

/-- The conditions run over EVERY a >= 2, not merely over a < m. -/
def A : Set ℕ :=
  {m | 1 ≤ m ∧ Squarefree m ∧ ∀ a : ℕ, 2 ≤ a → (Nat.gcd m (q a)) ^ 2 ≤ q a}

/-- The maximum prime factor, with value 1 at both 0 and 1.
The value at 0 is an unused totalization; the manuscript specifies P⁺(1) = 1. -/
def largestPrime (m : ℕ) : ℕ := max 1 (m.primeFactors.sup id)

def LargePrime (α : ℝ) (m : ℕ) : Prop :=
  (m : ℝ) ^ (1 - α) < (largestPrime m : ℝ)

def B (α : ℝ) : Set ℕ := {m | m ∈ A ∧ LargePrime α m}

/-- P_h(c) in the paper, including its exact falling-product definition. -/
def falling (h c : ℕ) : ℕ := ∏ i ∈ Finset.range h, (c - i)

/-- Composite endpoint, stated using actual nontrivial factors. -/
def Composite (m : ℕ) : Prop :=
  ∃ u v : ℕ, 2 ≤ u ∧ 2 ≤ v ∧ m = u * v

/-- The explicit four-factor representation b! c! d! m!. -/
def FourRep (m b c d : ℕ) : Prop :=
  1 ≤ b ∧ b < c ∧ c < d ∧ d < m ∧
    NatSquare (b.factorial * c.factorial * d.factorial * m.factorial)

/-- The explicit five-factor representation a! b! c! d! m!. -/
def FiveRep (m a b c d : ℕ) : Prop :=
  1 ≤ a ∧ a < b ∧ b < c ∧ c < d ∧ d < m ∧
    NatSquare (a.factorial * b.factorial * c.factorial * d.factorial * m.factorial)

/-- This population does NOT impose membership in A or squarefreeness:
Proposition 5.1 has the larger scope stated here. -/
def NonpairedFour (α η : ℝ) : Set ℕ :=
  {m | LargePrime α m ∧ ∃ b c d : ℕ,
    FourRep m b c d ∧ (c - b ≠ 1 ∨ m - d ≠ 1) ∧
      ((c - b : ℕ) : ℝ) ≤ (m : ℝ) ^ η ∧
      ((m - d : ℕ) : ℝ) ≤ (m : ℝ) ^ η}

def NonpairedFive (α η : ℝ) : Set ℕ :=
  {m | LargePrime α m ∧ ∃ a b c d : ℕ,
    FiveRep m a b c d ∧ (c - b ≠ 1 ∨ m - d ≠ 1) ∧
      ((c - b : ℕ) : ℝ) ≤ (m : ℝ) ^ η ∧
      ((m - d : ℕ) : ℝ) ≤ (m : ℝ) ^ η}

/-! ## 2. Elementary scripts: definitions and numerical margins -/

@[simp] theorem q_zero : q 0 = 1 := by simp [q, sf]
@[simp] theorem q_one : q 1 = 1 := by simp [q, sf]

/-- The squarefree kernel `q a` is genuinely squarefree.  This is the first
substantive half of `Tasks.FactorialSquareClasses`, proved directly from the
definition as a product of a finset of distinct primes. -/
theorem q_squarefree (a : ℕ) : Squarefree (q a) := by
  unfold q sf
  apply Finset.squarefree_prod_of_pairwise_isCoprime
  · intro p hp r hr hpr
    have pp : p.Prime :=
      Nat.prime_of_mem_primeFactors (Finset.mem_filter.mp hp).1
    have pr : r.Prime :=
      Nat.prime_of_mem_primeFactors (Finset.mem_filter.mp hr).1
    exact Nat.coprime_iff_isRelPrime.mp ((Nat.coprime_primes pp pr).2 hpr)
  · intro p hp
    have pp : p.Prime :=
      Nat.prime_of_mem_primeFactors (Finset.mem_filter.mp hp).1
    exact pp.squarefree

/-- In particular `q a` is positive/nonzero, which will be used when we
cancel its square in the five-factor paired case. -/
theorem q_ne_zero (a : ℕ) : q a ≠ 0 := (q_squarefree a).ne_zero

@[simp] theorem falling_zero (c : ℕ) : falling 0 c = 1 := by simp [falling]
@[simp] theorem falling_one (c : ℕ) : falling 1 c = c := by simp [falling]

/-- A script for the divisor-closure part of Lemma 3.2. -/
theorem A_divisor_closed {m d : ℕ} (hm : m ∈ A) (hdm : d ∣ m) : d ∈ A := by
  have hsf : Squarefree d := by
    intro x hx
    exact hm.2.1 x (dvd_trans hx hdm)
  have hdpos : 1 ≤ d := by
    have := hsf.ne_zero
    omega
  refine ⟨hdpos, hsf, ?_⟩
  intro a ha
  have hgcd : Nat.gcd d (q a) ∣ Nat.gcd m (q a) :=
    Nat.dvd_gcd (dvd_trans (Nat.gcd_dvd_left d (q a)) hdm)
      (Nat.gcd_dvd_right d (q a))
  have hgpos : 0 < Nat.gcd m (q a) := by
    by_contra h
    have hz : Nat.gcd m (q a) = 0 := by omega
    have hmz : m = 0 := by
      have hd := Nat.gcd_dvd_left m (q a)
      simpa [hz] using hd
    have := hm.1
    omega
  have hle := Nat.le_of_dvd hgpos hgcd
  have hsq : (Nat.gcd d (q a)) ^ 2 ≤ (Nat.gcd m (q a)) ^ 2 := by
    simpa [pow_two] using Nat.mul_le_mul hle hle
  exact hsq.trans (hm.2.2 a ha)

/-- `NatSquare` is the paper-facing formulation; Mathlib's `IsSquare` is
more convenient for squarefree divisibility lemmas. -/
theorem natSquare_iff_isSquare (n : ℕ) : NatSquare n ↔ IsSquare n := by
  constructor
  · rintro ⟨z, hz⟩
    exact ⟨z, by simpa [pow_two] using hz⟩
  · rintro ⟨z, hz⟩
    exact ⟨z, by simpa [pow_two] using hz⟩

/-- Cancelling an explicitly squared positive factor from a natural square.
The cancellation is carried out in `ℚ`, then reflected back to `ℕ`. -/
theorem natSquare_cancel_square_factor {n s : ℕ} (hs : 0 < s)
    (h : NatSquare (n * s ^ 2)) : NatSquare n := by
  have hNat : IsSquare (n * s ^ 2) := (natSquare_iff_isSquare _).mp h
  rcases hNat with ⟨z, hz⟩
  have hRat : IsSquare (((n * s ^ 2 : ℕ) : ℚ)) := by
    refine ⟨(z : ℚ), ?_⟩
    exact_mod_cast hz
  have hDen : IsSquare (((s ^ 2 : ℕ) : ℚ)) := by
    simpa using (IsSquare.sq (s : ℚ))
  have hDiv := hRat.div hDen
  have hs0 : (s : ℚ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hs)
  have hquot : (((n * s ^ 2 : ℕ) : ℚ) / ((s ^ 2 : ℕ) : ℚ)) = (n : ℚ) := by
    push_cast
    field_simp [hs0]
  rw [hquot] at hDiv
  have hNat' : IsSquare n := by
    exact (Rat.isSquare_natCast_iff).mp hDiv
  exact (natSquare_iff_isSquare n).mpr hNat'

/-- A prime divides the factorial squarefree kernel exactly when its exponent
in `a!` is odd.  This packages the defining filter in `sf` into a form that
can be used with factorization parity. -/
theorem prime_dvd_q_iff (a p : ℕ) (hp : p.Prime) :
    p ∣ q a ↔ a.factorial.factorization p % 2 = 1 := by
  unfold q sf
  have hpPrime : Prime p := (Nat.prime_iff).mp hp
  constructor
  · intro hdiv
    rcases (Prime.dvd_finsetProd_iff hpPrime id).mp hdiv with ⟨r, hr, hpr⟩
    have hrpf : r ∈ a.factorial.primeFactors := (Finset.mem_filter.mp hr).1
    have hrprime : r.Prime := Nat.prime_of_mem_primeFactors hrpf
    have hpr_eq : p = r := (Nat.prime_dvd_prime_iff_eq hp hrprime).mp hpr
    subst r
    exact (Finset.mem_filter.mp hr).2
  · intro hodd
    apply (Prime.dvd_finsetProd_iff hpPrime id).mpr
    refine ⟨p, ?_, dvd_rfl⟩
    apply Finset.mem_filter.mpr
    refine ⟨?_, hodd⟩
    apply (Nat.mem_primeFactors).2
    refine ⟨hp, ?_, Nat.factorial_ne_zero a⟩
    apply Nat.dvd_of_factorization_pos
    omega

/-- At every prime, `q a` records exactly the parity bit of the exponent in
`a!`. -/
theorem q_factorization_prime (a p : ℕ) (hp : p.Prime) :
    (q a).factorization p = a.factorial.factorization p % 2 := by
  by_cases hodd : a.factorial.factorization p % 2 = 1
  · have hdiv : p ∣ q a := (prime_dvd_q_iff a p hp).2 hodd
    have hq : (q a).factorization p = 1 :=
      Nat.factorization_eq_one_of_squarefree (q_squarefree a) hp hdiv
    rw [hq, hodd]
  · have hmod : a.factorial.factorization p % 2 = 0 := by omega
    have hndiv : ¬ p ∣ q a := by
      intro hdiv
      exact hodd ((prime_dvd_q_iff a p hp).1 hdiv)
    have hq0 : (q a).factorization p = 0 := by
      by_contra hne
      exact hndiv (Nat.dvd_of_factorization_pos hne)
    rw [hq0, hmod]

/-- Multiplying `a!` by its squarefree kernel gives a square: every prime
exponent has been made even. -/
theorem factorial_mul_q_square (a : ℕ) : NatSquare (a.factorial * q a) := by
  apply (natSquare_iff_isSquare _).mpr
  rw [Nat.isSquare_iff_even_factorization]
  intro p hp
  have hfac0 : a.factorial ≠ 0 := Nat.factorial_ne_zero a
  have hq0 : q a ≠ 0 := q_ne_zero a
  rw [Nat.factorization_mul hfac0 hq0]
  change Even (a.factorial.factorization p + (q a).factorization p)
  rw [q_factorization_prime a p hp]
  rw [Nat.even_iff]
  omega

/-- Products of natural-number squares are squares. -/
theorem natSquare_mul {x y : ℕ} (hx : NatSquare x) (hy : NatSquare y) :
    NatSquare (x * y) := by
  rcases hx with ⟨u, rfl⟩
  rcases hy with ⟨v, rfl⟩
  refine ⟨u * v, ?_⟩
  ring

/-- Exact square-class equivalence used in equation (1.4): replacing `a!`
by `q a` preserves whether the product with an arbitrary natural `n` is a
square.  The proof multiplies by the square `a! * q a` and cancels an explicit
square factor in each direction. -/
theorem factorial_squareclass (a n : ℕ) :
    NatSquare (a.factorial * n) ↔ NatSquare (q a * n) := by
  constructor
  · intro h
    have hprod := natSquare_mul h (factorial_mul_q_square a)
    have hrearr :
        (a.factorial * n) * (a.factorial * q a) =
          (q a * n) * a.factorial ^ 2 := by ring
    rw [hrearr] at hprod
    exact natSquare_cancel_square_factor (Nat.factorial_pos a) hprod
  · intro h
    have hprod := natSquare_mul h (factorial_mul_q_square a)
    have hrearr :
        (q a * n) * (a.factorial * q a) =
          (a.factorial * n) * (q a) ^ 2 := by ring
    rw [hrearr] at hprod
    have hqpos : 0 < q a := Nat.pos_of_ne_zero (q_ne_zero a)
    exact natSquare_cancel_square_factor hqpos hprod

/-- The paired four-factor case from Lemma 3.3, proved here rather than assumed.
When both gaps are one, the factorial product is `(c*m)` times an explicit
square. After cancelling that square, squarefreeness of `m` forces `m ∣ c`,
contradicting `c < m`. -/
theorem paired_four_proved (m b c d : ℕ) (hm : m ∈ A) (hr : FourRep m b c d)
    (hcb : c - b = 1) (hmd : m - d = 1) : False := by
  have hc : c = b + 1 := by omega
  have hmm : m = d + 1 := by omega
  have hprod :
      b.factorial * c.factorial * d.factorial * m.factorial =
        (c * m) * (b.factorial * d.factorial) ^ 2 := by
    rw [hc, hmm]
    simp only [Nat.factorial_succ]
    ring
  have hsq : NatSquare ((c * m) * (b.factorial * d.factorial) ^ 2) := by
    rw [← hprod]
    exact hr.2.2.2.2
  have hspos : 0 < b.factorial * d.factorial :=
    Nat.mul_pos (Nat.factorial_pos _) (Nat.factorial_pos _)
  have hcm : NatSquare (c * m) := natSquare_cancel_square_factor hspos hsq
  have his : IsSquare (m * c) := by
    have := (natSquare_iff_isSquare (c * m)).mp hcm
    simpa [Nat.mul_comm] using this
  have hdiv : m ∣ c := hm.2.1.dvd_of_isSquare_mul his
  have hcpos : 0 < c := by omega
  have hle : m ≤ c := Nat.le_of_dvd hcpos hdiv
  have hlt : c < m := lt_trans hr.2.2.1 hr.2.2.2.1
  omega


/-- Arithmetic core of the five-factor paired exclusion.  If `m` and `q` are
squarefree, `gcd(m,q)^2 ≤ q`, and `q*c*m` is a square, then `m ≤ c`.
This is the divisibility step in Lemma 3.3. -/
theorem paired_squarefree_bound {m qv c : ℕ}
    (hmpos : 0 < m) (hqpos : 0 < qv) (hcpos : 0 < c)
    (hmsf : Squarefree m) (hqsf : Squarefree qv)
    (hgcond : (Nat.gcd m qv) ^ 2 ≤ qv)
    (hsq : NatSquare (qv * (c * m))) : m ≤ c := by
  let g := Nat.gcd m qv
  have hgpos : 0 < g := by
    dsimp [g]
    exact Nat.gcd_pos_of_pos_left qv hmpos
  obtain ⟨u, v, huv, hmu, hqv⟩ := Nat.exists_coprime m qv
  have hmu_g : m = u * g := by
    simpa [g] using hmu
  have hqv_g : qv = v * g := by
    simpa [g] using hqv
  have hu_dvd : u ∣ m := by
    refine ⟨g, ?_⟩
    exact hmu_g
  have hv_dvd : v ∣ qv := by
    refine ⟨g, ?_⟩
    exact hqv_g
  have husf : Squarefree u := by
    intro x hx
    exact hmsf x (dvd_trans hx hu_dvd)
  have hvsf : Squarefree v := by
    intro x hx
    exact hqsf x (dvd_trans hx hv_dvd)
  have huv_sf : Squarefree (u * v) :=
    (Nat.squarefree_mul huv).2 ⟨husf, hvsf⟩
  have hsq' : NatSquare ((u * v * c) * g ^ 2) := by
    rw [hmu_g, hqv_g] at hsq
    convert hsq using 1 <;> ring
  have hcore : NatSquare (u * v * c) :=
    natSquare_cancel_square_factor hgpos hsq'
  have hdiv : u * v ∣ c := by
    apply huv_sf.dvd_of_isSquare_mul
    exact (natSquare_iff_isSquare _).mp (by simpa [mul_assoc] using hcore)
  have hgcond' : g * g ≤ v * g := by
    have := hgcond
    rw [show Nat.gcd m qv = g by rfl, hqv_g] at this
    simpa [pow_two] using this
  have hgv : g ≤ v := by
    nlinarith
  have hm_le_uv : m ≤ u * v := by
    rw [hmu_g]
    exact Nat.mul_le_mul_left u hgv
  exact hm_le_uv.trans (Nat.le_of_dvd hcpos hdiv)

/-- The five-factor paired case of Lemma 3.3, now proved rather than assumed.
Repair 6 uses the factorial square-class theorem from Repair 5 and the defining
gcd condition of `A`. -/
theorem paired_five_proved (m a b c d : ℕ) (hm : m ∈ A)
    (hr : FiveRep m a b c d) (hcb : c - b = 1) (hmd : m - d = 1) : False := by
  have hc : c = b + 1 := by omega
  have hmm : m = d + 1 := by omega
  have hprod :
      a.factorial * b.factorial * c.factorial * d.factorial * m.factorial =
        (a.factorial * (c * m)) * (b.factorial * d.factorial) ^ 2 := by
    rw [hc, hmm]
    simp only [Nat.factorial_succ]
    ring
  have hsq : NatSquare ((a.factorial * (c * m)) *
      (b.factorial * d.factorial) ^ 2) := by
    rw [← hprod]
    exact hr.2.2.2.2.2
  have hspos : 0 < b.factorial * d.factorial :=
    Nat.mul_pos (Nat.factorial_pos _) (Nat.factorial_pos _)
  have hfac : NatSquare (a.factorial * (c * m)) :=
    natSquare_cancel_square_factor hspos hsq
  have hqcm : NatSquare (q a * (c * m)) :=
    (factorial_squareclass a (c * m)).mp hfac
  have hgcond : (Nat.gcd m (q a)) ^ 2 ≤ q a := by
    by_cases ha : 2 ≤ a
    · exact hm.2.2 a ha
    · have ha_pos : 1 ≤ a := hr.1
      have ha1 : a = 1 := by omega
      subst a
      simp
  have hmpos : 0 < m := by omega
  have hqpos : 0 < q a := Nat.pos_of_ne_zero (q_ne_zero a)
  have hcpos : 0 < c := by omega
  have hmle : m ≤ c := paired_squarefree_bound hmpos hqpos hcpos hm.2.1
      (q_squarefree a) hgcond hqcm
  have hcm : c < m := lt_trans hr.2.2.2.1 hr.2.2.2.2.1
  omega

def alpha : ℝ := 1 / 100
def theta : ℝ := 11 / 100
def eta : ℝ := 3 / 25

def densityConstant (δ : ℝ) : ℝ := δ * Real.log ((100 : ℝ) / 99)

/-- The entire numerical ledger in §6.1, as exact rational arithmetic. -/
theorem parameter_ledger :
    theta - (1 : ℝ) / 10 = 1 / 100 ∧
    eta - theta = 1 / 100 ∧
    1 - (3 * alpha + 8 * eta) = 1 / 100 ∧
    1 - (1 / 2 + 3 * alpha / 2 + 4 * eta) = 1 / 200 ∧
    1 - (1 / 2 + 3 * alpha / 2 + 3 * eta) = 1 / 8 ∧
    (1 - alpha) / 2 - (alpha + eta) = 73 / 200 ∧
    (1 - alpha) / 4 - eta = 51 / 400 := by
  norm_num [alpha, theta, eta]

theorem parameter_conditions :
    0 < alpha ∧ alpha < 1 / 2 ∧ 1 / 10 < theta ∧ theta < eta ∧
    3 * alpha + 8 * eta < 1 := by
  norm_num [alpha, theta, eta]

theorem five_exponent : (1 : ℝ) / 2 + 3 * alpha / 2 + 4 * eta = 199 / 200 := by
  norm_num [alpha, eta]

theorem four_exponent : (1 : ℝ) / 2 + 3 * alpha / 2 + 3 * eta = 7 / 8 := by
  norm_num [alpha, eta]

theorem densityConstant_pos {δ : ℝ} (hδ : 0 < δ) : 0 < densityConstant δ := by
  exact mul_pos hδ (Real.log_pos (by norm_num : (1 : ℝ) < 100 / 99))

/-! ## 3. Classical factorial construction, including coincident-index cases -/

theorem factorial_predecessor (n : ℕ) (hn : 1 ≤ n) :
    n.factorial = n * (n - 1).factorial := by
  have h : n - 1 + 1 = n := Nat.sub_add_cancel hn
  calc
    n.factorial = (n - 1 + 1).factorial := by rw [h]
    _ = (n - 1 + 1) * (n - 1).factorial := Nat.factorial_succ (n - 1)
    _ = n * (n - 1).factorial := by rw [h]

/-- Identity (6.2). This identity alone is not a claim of six DISTINCT factors. -/
theorem six_factor_identity (u v : ℕ) (hu : 2 ≤ u) (hv : 2 ≤ v) :
    ((u - 1).factorial * u.factorial) *
      ((v - 1).factorial * v.factorial) *
      ((u * v - 1).factorial * (u * v).factorial) =
    ((u * v) * (u - 1).factorial * (v - 1).factorial *
      (u * v - 1).factorial) ^ 2 := by
  have hm : 1 ≤ u * v := by
    simpa using Nat.mul_le_mul (show 1 ≤ u by omega) (show 1 ≤ v by omega)
  rw [factorial_predecessor u (by omega),
      factorial_predecessor v (by omega), factorial_predecessor (u * v) hm]
  ring

/-- Construct a representation from two explicitly ordered indices. -/
theorem hasRep_two_of {d m : ℕ} (hd : 1 ≤ d) (hdm : d < m)
    (hs : NatSquare (d.factorial * m.factorial)) : HasRep m 2 := by
  refine ⟨by decide, ⟨{
    index := ![d, m]
    increasing := ?_
    positive := ?_
    endpoint := ?_
    square := ?_
  }⟩⟩
  · intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all
  · intro i
    fin_cases i
    · simpa using hd
    · simpa using (le_trans hd (le_of_lt hdm))
  · intro i hi
    fin_cases i <;> simp_all
  · simpa [Fin.prod_univ_succ, mul_assoc] using hs

/-- Construct a representation from four explicitly ordered indices. -/
theorem hasRep_four_of {a b c m : ℕ} (ha : 1 ≤ a) (hab : a < b)
    (hbc : b < c) (hcm : c < m)
    (hs : NatSquare (a.factorial * b.factorial * c.factorial * m.factorial)) :
    HasRep m 4 := by
  refine ⟨by decide, ⟨{
    index := ![a, b, c, m]
    increasing := ?_
    positive := ?_
    endpoint := ?_
    square := ?_
  }⟩⟩
  · intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all <;> omega
  · intro i
    fin_cases i <;> simp_all <;> omega
  · intro i hi
    fin_cases i <;> simp_all
  · simpa [Fin.prod_univ_succ, mul_assoc] using hs

/-- Construct a representation from six explicitly ordered indices. -/
theorem hasRep_six_of {a b c d e m : ℕ} (ha : 1 ≤ a) (hab : a < b)
    (hbc : b < c) (hcd : c < d) (hde : d < e) (hem : e < m)
    (hs : NatSquare (a.factorial * b.factorial * c.factorial * d.factorial *
      e.factorial * m.factorial)) : HasRep m 6 := by
  refine ⟨by decide, ⟨{
    index := ![a, b, c, d, e, m]
    increasing := ?_
    positive := ?_
    endpoint := ?_
    square := ?_
  }⟩⟩
  · intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all <;> omega
  · intro i
    fin_cases i <;> simp_all <;> omega
  · intro i hi
    fin_cases i <;> simp_all
  · simpa [Fin.prod_univ_succ, mul_assoc] using hs

/-- An explicit implementation of the repeated-index cancellation in §6.1.
After arranging u <= v there are exactly three cases: v=u, v=u+1, v>=u+2. -/
theorem six_bound_ordered (u v : ℕ) (hu : 2 ≤ u) (hv : 2 ≤ v) (huv : u ≤ v) :
    ∃ k : ℕ, k ≤ 6 ∧ HasRep (u * v) k := by
  by_cases heq : u = v
  · subst v
    have hm : 4 ≤ u * u := by simpa using Nat.mul_le_mul hu hu
    have hs : NatSquare ((u * u - 1).factorial * (u * u).factorial) := by
      refine ⟨u * (u * u - 1).factorial, ?_⟩
      rw [factorial_predecessor (u * u) (by omega)]
      ring
    exact ⟨2, by decide, hasRep_two_of (by omega) (by omega) hs⟩
  · have huvlt : u < v := by omega
    by_cases hadj : v = u + 1
    · subst v
      have hm : u + 1 + 2 ≤ u * (u + 1) := by
        nlinarith [Nat.mul_le_mul hu hu]
      have hs : NatSquare ((u - 1).factorial * (u + 1).factorial *
          (u * (u + 1) - 1).factorial * (u * (u + 1)).factorial) := by
        refine ⟨(u * (u + 1)) * (u - 1).factorial *
          (u * (u + 1) - 1).factorial, ?_⟩
        rw [Nat.factorial_succ, factorial_predecessor u (by omega),
          factorial_predecessor (u * (u + 1)) (by omega)]
        ring
      exact ⟨4, by decide, hasRep_four_of (by omega) (by omega)
        (by omega) (by omega) hs⟩
    · have hgap : u + 2 ≤ v := by omega
      have hm : v + 2 ≤ u * v := by
        have hmul : 2 * v ≤ u * v := Nat.mul_le_mul_right v hu
        omega
      have hs : NatSquare ((u - 1).factorial * u.factorial *
          (v - 1).factorial * v.factorial * (u * v - 1).factorial *
          (u * v).factorial) := by
        refine ⟨(u * v) * (u - 1).factorial * (v - 1).factorial *
          (u * v - 1).factorial, ?_⟩
        simpa [mul_assoc] using six_factor_identity u v hu hv
      exact ⟨6, by decide, hasRep_six_of (by omega) (by omega)
        (by omega) (by omega) (by omega) (by omega) hs⟩

theorem composite_six_bound {m : ℕ} (hm : Composite m) :
    ∃ k : ℕ, k ≤ 6 ∧ HasRep m k := by
  obtain ⟨u, v, hu, hv, rfl⟩ := hm
  rcases le_total u v with huv | hvu
  · exact six_bound_ordered u v hu hv huv
  · simpa [Nat.mul_comm] using six_bound_ordered v u hv hu hvu

theorem composite_gt_one {m : ℕ} (hm : Composite m) : 1 < m := by
  obtain ⟨u, v, hu, hv, rfl⟩ := hm
  have hprod : 4 ≤ u * v := by simpa using Nat.mul_le_mul hu hv
  omega

theorem mem_D6_of_composite_exclusions {m : ℕ} (hm : Composite m)
    (hno : ∀ k : ℕ, 2 ≤ k → k < 6 → ¬ HasRep m k) : m ∈ D6 := by
  obtain ⟨k, hk, hrep⟩ := composite_six_bound hm
  have heq : k = 6 := by
    by_contra hne
    exact hno k hrep.1 (by omega) hrep
  refine ⟨composite_gt_one hm, ?_, hno⟩
  simpa [heq] using hrep


/-! ## 3.9 Extracting two- and three-factor coordinates -/

/-- Extract the unique lower index from a two-factor representation. -/
theorem two_of_hasRep {m : ℕ} (hm : HasRep m 2) :
    ∃ d : ℕ, 1 ≤ d ∧ d < m ∧
      NatSquare (d.factorial * m.factorial) := by
  obtain ⟨_, ⟨r⟩⟩ := hm
  have he : r.index (1 : Fin 2) = m := r.endpoint 1 (by norm_num)
  have hs : NatSquare ((r.index 0).factorial * (r.index 1).factorial) := by
    simpa [Fin.prod_univ_succ, mul_assoc] using r.square
  refine ⟨r.index 0, r.positive 0, ?_, ?_⟩
  · simpa [he] using r.increasing (by decide : (0 : Fin 2) < 1)
  · simpa [he] using hs

/-- Extract the two lower indices from a three-factor representation. -/
theorem three_of_hasRep {m : ℕ} (hm : HasRep m 3) :
    ∃ a d : ℕ, 1 ≤ a ∧ a < d ∧ d < m ∧
      NatSquare (a.factorial * d.factorial * m.factorial) := by
  obtain ⟨_, ⟨r⟩⟩ := hm
  have he : r.index (2 : Fin 3) = m := r.endpoint 2 (by norm_num)
  have hs : NatSquare ((r.index 0).factorial * (r.index 1).factorial *
      (r.index 2).factorial) := by
    simpa [Fin.prod_univ_succ, mul_assoc] using r.square
  refine ⟨r.index 0, r.index 1, r.positive 0,
    r.increasing (by decide : (0 : Fin 3) < 1), ?_, ?_⟩
  · simpa [he] using r.increasing (by decide : (1 : Fin 3) < 2)
  · simpa [he] using hs

/-! ## 4. Extracting the paper's four- and five-factor coordinates -/

theorem four_of_hasRep {m : ℕ} (hm : HasRep m 4) :
    ∃ b c d : ℕ, FourRep m b c d := by
  obtain ⟨_, ⟨r⟩⟩ := hm
  have he : r.index (3 : Fin 4) = m := r.endpoint 3 (by norm_num)
  have hs : NatSquare ((r.index 0).factorial * (r.index 1).factorial *
      (r.index 2).factorial * (r.index 3).factorial) := by
    simpa [Fin.prod_univ_succ, mul_assoc] using r.square
  refine ⟨r.index 0, r.index 1, r.index 2, r.positive 0,
    r.increasing (by decide : (0 : Fin 4) < 1),
    r.increasing (by decide : (1 : Fin 4) < 2), ?_, ?_⟩
  · simpa [he] using r.increasing (by decide : (2 : Fin 4) < 3)
  · simpa [he] using hs

theorem five_of_hasRep {m : ℕ} (hm : HasRep m 5) :
    ∃ a b c d : ℕ, FiveRep m a b c d := by
  obtain ⟨_, ⟨r⟩⟩ := hm
  have he : r.index (4 : Fin 5) = m := r.endpoint 4 (by norm_num)
  have hs : NatSquare ((r.index 0).factorial * (r.index 1).factorial *
      (r.index 2).factorial * (r.index 3).factorial * (r.index 4).factorial) := by
    simpa [Fin.prod_univ_succ, mul_assoc] using r.square
  refine ⟨r.index 0, r.index 1, r.index 2, r.index 3, r.positive 0,
    r.increasing (by decide : (0 : Fin 5) < 1),
    r.increasing (by decide : (1 : Fin 5) < 2),
    r.increasing (by decide : (2 : Fin 5) < 3), ?_, ?_⟩
  · simpa [he] using r.increasing (by decide : (3 : Fin 5) < 4)
  · simpa [he] using hs

/-! ## 5. Elementary root-separation fact used in Proposition 5.1
This proves a numerical root obstruction, not the polynomial nonsquareness,
good-reduction, Weil, or large-sieve steps. -/

theorem anchor_first_root_unmatched {r j v : ℕ}
    (hj : 0 < j) (hjr : j < r) (hv : 1 ≤ v) :
    (1 : ℚ) / (r : ℚ) ≠ (v : ℚ) / (j : ℚ) := by
  have hjq : (0 : ℚ) < j := by exact_mod_cast hj
  have hrq : (0 : ℚ) < r := by exact_mod_cast (lt_trans hj hjr)
  have hjrq : (j : ℚ) < r := by exact_mod_cast hjr
  have hvq : (1 : ℚ) ≤ v := by exact_mod_cast hv
  have hvr : (r : ℚ) ≤ (v : ℚ) * (r : ℚ) := by
    simpa using mul_le_mul_of_nonneg_right hvq (le_of_lt hrq)
  intro h
  have hc : (1 : ℚ) * j = (v : ℚ) * r :=
    (div_eq_div_iff (ne_of_gt hrq) (ne_of_gt hjq)).mp h
  nlinarith

/-! ## 6. Prefix counts and epsilon-N density statements

The paper counts [1,X]. We use exactly [1,N] for natural N. Restricting the
asymptotic variable to natural N does not change a counting density. The
`LowerDensityAtLeast` definition is the eventual epsilon lower-bound formulation
of liminf >= delta. No existence of the density of the whole of D6 is imposed.
-/

def prefixCount (S : Set ℕ) (N : ℕ) : ℕ := by
  classical
  exact ((Finset.Icc 1 N).filter (fun n => n ∈ S)).card

def proportion (S : Set ℕ) (N : ℕ) : ℝ := (prefixCount S N : ℝ) / (N : ℝ)

def HasDensity (S : Set ℕ) (δ : ℝ) : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ X : ℕ,
    N ≤ X → |proportion S X - δ| < ε

def DensityZero (S : Set ℕ) : Prop := HasDensity S 0

def LowerDensityAtLeast (S : Set ℕ) (δ : ℝ) : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ X : ℕ,
    N ≤ X → δ - ε ≤ proportion S X

def PositiveLowerDensity (S : Set ℕ) : Prop :=
  ∃ δ : ℝ, 0 < δ ∧ LowerDensityAtLeast S δ

def Initial (N : ℕ) : Set ℕ := {m | m < N}

theorem proportion_nonneg (S : Set ℕ) (X : ℕ) : 0 ≤ proportion S X := by
  unfold proportion
  positivity

theorem prefixCount_mono {S T : Set ℕ} (h : S ⊆ T) (X : ℕ) :
    prefixCount S X ≤ prefixCount T X := by
  classical
  apply Finset.card_le_card
  intro n hn
  simp only [Finset.mem_filter] at hn ⊢
  exact ⟨hn.1, h hn.2⟩

theorem proportion_mono {S T : Set ℕ} (h : S ⊆ T) (X : ℕ) :
    proportion S X ≤ proportion T X := by
  unfold proportion
  exact div_le_div_of_nonneg_right (by exact_mod_cast prefixCount_mono h X)
    (Nat.cast_nonneg X)

/-- Count the two disjoint parts of T directly on the finite prefix.
The induction avoids relying on a separately elaborated filter identity. -/
theorem prefixCount_partition (D T : Set ℕ) (X : ℕ) :
    prefixCount (D ∩ T) X + prefixCount (T \ D) X = prefixCount T X := by
  classical
  unfold prefixCount
  generalize (Finset.Icc (1 : ℕ) X) = s
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
      by_cases hD : a ∈ D <;> by_cases hT : a ∈ T <;>
        simp [Finset.filter_insert, Set.mem_inter_iff,
          hD, hT, ha, Finset.mem_filter] at * <;> omega

theorem proportion_inter_eq_sub (D T : Set ℕ) (X : ℕ) :
    proportion (D ∩ T) X = proportion T X - proportion (T \ D) X := by
  have h : (prefixCount (D ∩ T) X : ℝ) + prefixCount (T \ D) X =
      prefixCount T X := by
    exact_mod_cast prefixCount_partition D T X
  unfold proportion
  rw [← h]
  ring

/-- A direct inclusion proof of the union bound, with no filter-equality rewrite. -/
theorem prefixCount_union_le (S T : Set ℕ) (X : ℕ) :
    prefixCount (S ∪ T) X ≤ prefixCount S X + prefixCount T X := by
  classical
  calc
    prefixCount (S ∪ T) X ≤
        (((Finset.Icc 1 X).filter (fun n => n ∈ S)) ∪
          ((Finset.Icc 1 X).filter (fun n => n ∈ T))).card := by
      unfold prefixCount
      apply Finset.card_le_card
      intro n hn
      simp only [Finset.mem_filter, Set.mem_union, Finset.mem_union] at hn ⊢
      rcases hn with ⟨hI, hS | hT⟩
      · exact Or.inl ⟨hI, hS⟩
      · exact Or.inr ⟨hI, hT⟩
    _ ≤ prefixCount S X + prefixCount T X := by
      unfold prefixCount
      exact Finset.card_union_le _ _

theorem proportion_union_le (S T : Set ℕ) (X : ℕ) :
    proportion (S ∪ T) X ≤ proportion S X + proportion T X := by
  have h : (prefixCount (S ∪ T) X : ℝ) ≤ prefixCount S X + prefixCount T X := by
    exact_mod_cast prefixCount_union_le S T X
  unfold proportion
  calc
    _ ≤ ((prefixCount S X : ℝ) + prefixCount T X) / (X : ℝ) :=
      div_le_div_of_nonneg_right h (Nat.cast_nonneg X)
    _ = _ := by ring

theorem densityZero_mono {S T : Set ℕ} (hST : S ⊆ T)
    (hT : DensityZero T) : DensityZero S := by
  intro ε hε
  obtain ⟨N, hN⟩ := hT ε hε
  refine ⟨N, ?_⟩
  intro X hX
  have ht := hN X hX
  have hsn := proportion_nonneg S X
  have htn := proportion_nonneg T X
  have hm := proportion_mono hST X
  simpa only [sub_zero, abs_of_nonneg hsn] using
    (lt_of_le_of_lt hm (by simpa only [sub_zero, abs_of_nonneg htn] using ht))

theorem densityZero_union {S T : Set ℕ} (hS : DensityZero S)
    (hT : DensityZero T) : DensityZero (S ∪ T) := by
  intro ε hε
  obtain ⟨NS, hNS⟩ := hS (ε / 2) (by linarith)
  obtain ⟨NT, hNT⟩ := hT (ε / 2) (by linarith)
  refine ⟨max NS NT, ?_⟩
  intro X hX
  have hs := (abs_lt.mp (hNS X (le_trans (le_max_left NS NT) hX))).2
  have ht := (abs_lt.mp (hNT X (le_trans (le_max_right NS NT) hX))).2
  have hu := proportion_union_le S T X
  have hn := proportion_nonneg (S ∪ T) X
  rw [sub_zero, abs_of_nonneg hn]
  linarith

theorem densityZero_initial (N : ℕ) : DensityZero (Initial N) := by
  intro ε hε
  obtain ⟨M, hM⟩ := exists_nat_gt ((N : ℝ) / ε)
  refine ⟨max M 1, ?_⟩
  intro X hX
  have hMX : M ≤ X := le_trans (le_max_left M 1) hX
  have hXpos : (0 : ℝ) < X := by
    have : 1 ≤ X := le_trans (le_max_right M 1) hX
    exact_mod_cast (show 0 < X by omega)
  have hcount : prefixCount (Initial N) X ≤ N := by
    classical
    have hs : ((Finset.Icc 1 X).filter (fun n => n ∈ Initial N)) ⊆
        Finset.range N := by
      intro n hn
      exact Finset.mem_range.mpr (Finset.mem_filter.mp hn).2
    simpa [prefixCount] using Finset.card_le_card hs
  have hcountR : (prefixCount (Initial N) X : ℝ) ≤ N := by exact_mod_cast hcount
  have hMXR : (M : ℝ) ≤ X := by exact_mod_cast hMX
  have hprod : (N : ℝ) < ε * X := by
    calc
      (N : ℝ) < (M : ℝ) * ε := (div_lt_iff₀ hε).mp hM
      _ ≤ (X : ℝ) * ε := mul_le_mul_of_nonneg_right hMXR (le_of_lt hε)
      _ = ε * X := mul_comm _ _
  have hp : proportion (Initial N) X < ε := by
    unfold proportion
    apply (div_lt_iff₀ hXpos).mpr
    linarith
  simpa only [sub_zero, abs_of_nonneg (proportion_nonneg (Initial N) X)] using hp

/-- Removing a density-zero difference preserves the subfamily density. -/
theorem density_inter_of_difference {D T : Set ℕ} {δ : ℝ}
    (hT : HasDensity T δ) (hE : DensityZero (T \ D)) :
    HasDensity (D ∩ T) δ := by
  intro ε hε
  obtain ⟨NT, hNT⟩ := hT (ε / 2) (by linarith)
  obtain ⟨NE, hNE⟩ := hE (ε / 2) (by linarith)
  refine ⟨max NT NE, ?_⟩
  intro X hX
  have ht := abs_lt.mp (hNT X (le_trans (le_max_left NT NE) hX))
  have he := abs_lt.mp (hNE X (le_trans (le_max_right NT NE) hX))
  rw [proportion_inter_eq_sub]
  apply abs_lt.mpr
  constructor <;> linarith

theorem lowerDensity_of_density_subset {S T : Set ℕ} {δ : ℝ}
    (hST : S ⊆ T) (hS : HasDensity S δ) : LowerDensityAtLeast T δ := by
  intro ε hε
  obtain ⟨N, hN⟩ := hS ε hε
  refine ⟨N, ?_⟩
  intro X hX
  have hs := (abs_lt.mp (hN X hX)).1
  have hm := proportion_mono hST X
  linarith


/-! ## 6.5 Exact interval cancellation needed for the two- and three-factor step

Repair 7 formalizes the elementary factorial cancellation underlying (1.4).
This is a prerequisite for the direct two- and three-factor exclusion in §6.1.
-/

/-- The manuscript's `falling h c` is Mathlib's descending factorial. -/
theorem falling_eq_descFactorial (h c : ℕ) :
    falling h c = c.descFactorial h := by
  induction h with
  | zero =>
      simp [falling]
  | succ h ih =>
      unfold falling
      rw [Finset.prod_range_succ, Nat.descFactorial_succ]
      change falling h c * (c - h) = (c - h) * c.descFactorial h
      rw [ih]
      exact mul_comm _ _

/-- Exact interval identity:
`P_{m-d}(m) * d! = m!`. -/
theorem falling_mul_factorial_eq_factorial {d m : ℕ} (hdm : d ≤ m) :
    falling (m - d) m * d.factorial = m.factorial := by
  rw [falling_eq_descFactorial]
  have h := Nat.factorial_mul_descFactorial
    (n := m) (k := m - d) (Nat.sub_le m d)
  have hsub : m - (m - d) = d := by omega
  rw [hsub] at h
  simpa [mul_comm] using h

/-- Multiplying a natural square by an explicit square preserves squareness. -/
theorem natSquare_mul_square_factor {n s : ℕ}
    (h : NatSquare n) : NatSquare (n * s ^ 2) := by
  rcases h with ⟨z, rfl⟩
  refine ⟨z * s, ?_⟩
  ring

/-- Hence a positive explicit square factor may be inserted or cancelled. -/
theorem natSquare_mul_square_factor_iff {n s : ℕ} (hs : 0 < s) :
    NatSquare (n * s ^ 2) ↔ NatSquare n := by
  constructor
  · exact natSquare_cancel_square_factor hs
  · exact natSquare_mul_square_factor

/-- Four-factor form of the two-interval cancellation in (1.4). -/
theorem four_interval_reduction
    (b c d m : ℕ) (hb : 1 ≤ b) (hbc : b < c)
    (hcd : c < d) (hdm : d < m) :
    NatSquare (b.factorial * c.factorial * d.factorial * m.factorial) ↔
      NatSquare (falling (c - b) c * falling (m - d) m) := by
  have hbc_le : b ≤ c := le_of_lt hbc
  have hdm_le : d ≤ m := le_of_lt hdm
  have hc := falling_mul_factorial_eq_factorial (d := b) (m := c) hbc_le
  have hm := falling_mul_factorial_eq_factorial (d := d) (m := m) hdm_le
  let s := b.factorial * d.factorial
  have hs : 0 < s := by
    dsimp [s]
    exact Nat.mul_pos (Nat.factorial_pos _) (Nat.factorial_pos _)
  have hre :
      b.factorial * c.factorial * d.factorial * m.factorial =
        (falling (c - b) c * falling (m - d) m) * s ^ 2 := by
    dsimp [s]
    rw [← hc, ← hm]
    ring
  rw [hre]
  exact natSquare_mul_square_factor_iff hs

/-- Five-factor form of the two-interval cancellation in (1.4). -/
theorem five_interval_reduction
    (a b c d m : ℕ) (ha : 1 ≤ a) (hab : a < b)
    (hbc : b < c) (hcd : c < d) (hdm : d < m) :
    NatSquare (a.factorial * b.factorial * c.factorial * d.factorial * m.factorial) ↔
      NatSquare (q a * falling (c - b) c * falling (m - d) m) := by
  have hbc_le : b ≤ c := le_of_lt hbc
  have hdm_le : d ≤ m := le_of_lt hdm
  have hc := falling_mul_factorial_eq_factorial (d := b) (m := c) hbc_le
  have hm := falling_mul_factorial_eq_factorial (d := d) (m := m) hdm_le
  let s := b.factorial * d.factorial
  let n := a.factorial * (falling (c - b) c * falling (m - d) m)
  have hs : 0 < s := by
    dsimp [s]
    exact Nat.mul_pos (Nat.factorial_pos _) (Nat.factorial_pos _)
  have hre :
      a.factorial * b.factorial * c.factorial * d.factorial * m.factorial =
        n * s ^ 2 := by
    dsimp [n, s]
    rw [← hc, ← hm]
    ring
  rw [hre, natSquare_mul_square_factor_iff hs]
  dsimp [n]
  simpa [mul_assoc] using
    (factorial_squareclass a (falling (c - b) c * falling (m - d) m))


/-- Two-factor cancellation: `d! m!` is a square iff the upper interval product is. -/
theorem two_interval_reduction
    (d m : ℕ) (hd : 1 ≤ d) (hdm : d < m) :
    NatSquare (d.factorial * m.factorial) ↔
      NatSquare (falling (m - d) m) := by
  have hdm_le : d ≤ m := le_of_lt hdm
  have hm := falling_mul_factorial_eq_factorial (d := d) (m := m) hdm_le
  let s := d.factorial
  have hs : 0 < s := by
    dsimp [s]
    exact Nat.factorial_pos _
  have hre :
      d.factorial * m.factorial =
        falling (m - d) m * s ^ 2 := by
    dsimp [s]
    rw [← hm]
    ring
  rw [hre]
  exact natSquare_mul_square_factor_iff hs

/-- Three-factor cancellation: after removing `d!²`, replace `a!` by `q a`. -/
theorem three_interval_reduction
    (a d m : ℕ) (ha : 1 ≤ a) (had : a < d) (hdm : d < m) :
    NatSquare (a.factorial * d.factorial * m.factorial) ↔
      NatSquare (q a * falling (m - d) m) := by
  have hdm_le : d ≤ m := le_of_lt hdm
  have hm := falling_mul_factorial_eq_factorial (d := d) (m := m) hdm_le
  let s := d.factorial
  have hs : 0 < s := by
    dsimp [s]
    exact Nat.factorial_pos _
  have hre :
      a.factorial * d.factorial * m.factorial =
        (a.factorial * falling (m - d) m) * s ^ 2 := by
    dsimp [s]
    rw [← hm]
    ring
  rw [hre, natSquare_mul_square_factor_iff hs]
  simpa [mul_assoc] using
    (factorial_squareclass a (falling (m - d) m))


/-! ## 6.6 Largest-prime and parity machinery for the direct exclusions

Repair 9 formalizes the exact prime witness carried by `largestPrime`, and the
generic odd-valuation obstruction to squareness.  These are the local
number-theoretic ingredients used in the final two- and three-factor argument.
-/

/-- For `m > 1`, our totalized `largestPrime` really is the maximum element of
`m.primeFactors`. -/
theorem largestPrime_eq_maxPrime {m : ℕ} (hm : 1 < m) :
    largestPrime m = m.primeFactors.max' (Nat.nonempty_primeFactors.mpr hm) := by
  let hs : m.primeFactors.Nonempty := Nat.nonempty_primeFactors.mpr hm
  have hmem : m.primeFactors.max' hs ∈ m.primeFactors :=
    Finset.max'_mem _ _
  have hp : (m.primeFactors.max' hs).Prime :=
    Nat.prime_of_mem_primeFactors hmem
  have htwo : 2 ≤ m.primeFactors.max' hs := hp.two_le
  have hsup : m.primeFactors.sup id = m.primeFactors.max' hs := by
    rw [← Finset.sup'_eq_sup hs id]
    exact (Finset.max'_eq_sup' m.primeFactors hs).symm
  unfold largestPrime
  rw [hsup]
  exact max_eq_right (by omega)

/-- Consequently the largest prime is itself a prime factor of `m`. -/
theorem largestPrime_mem_primeFactors {m : ℕ} (hm : 1 < m) :
    largestPrime m ∈ m.primeFactors := by
  rw [largestPrime_eq_maxPrime hm]
  exact Finset.max'_mem _ _

theorem largestPrime_prime {m : ℕ} (hm : 1 < m) :
    (largestPrime m).Prime :=
  Nat.prime_of_mem_primeFactors (largestPrime_mem_primeFactors hm)

theorem largestPrime_dvd {m : ℕ} (hm : 1 < m) :
    largestPrime m ∣ m :=
  Nat.dvd_of_mem_primeFactors (largestPrime_mem_primeFactors hm)

/-- Membership in `A` makes the largest prime occur exactly once in `m`
itself, since members of `A` are squarefree. -/
theorem A_largestPrime_factorization_eq_one {m : ℕ}
    (hmA : m ∈ A) (hm : 1 < m) :
    m.factorization (largestPrime m) = 1 := by
  exact Nat.factorization_eq_one_of_squarefree hmA.2.1
    (largestPrime_prime hm) (largestPrime_dvd hm)

/-- A number with a prime occurring to exponent exactly one cannot be a
square.  This is the parity contradiction used at the end of both direct
exclusions. -/
theorem not_natSquare_of_prime_factorization_one {n p : ℕ}
    (hp : p.Prime) (hfac : n.factorization p = 1) :
    ¬ NatSquare n := by
  intro hs
  have his : IsSquare n := (natSquare_iff_isSquare n).mp hs
  have hev : Even (n.factorization p) :=
    (Nat.isSquare_iff_even_factorization.mp his) p hp
  rw [hfac] at hev
  norm_num [Even] at hev

/-- More generally, an explicitly odd prime exponent rules out a square. -/
theorem not_natSquare_of_prime_factorization_odd {n p : ℕ}
    (hp : p.Prime) (hodd : n.factorization p % 2 = 1) :
    ¬ NatSquare n := by
  intro hs
  have his : IsSquare n := (natSquare_iff_isSquare n).mp hs
  have hev : Even (n.factorization p) :=
    (Nat.isSquare_iff_even_factorization.mp his) p hp
  rcases hev with ⟨k, hk⟩
  rw [hk] at hodd
  omega


/-! ## 6.7 The prime occurs exactly once in a short upper interval

Repair 10 proves the local bridge needed by the direct two- and three-factor
exclusions.  The only remaining global step is to derive the hypotheses
`m - d < largestPrime m` and (for three factors) absence from `q a` from the
large-prime and short-gap estimates.
-/

/-- Every factor in `falling h m` is positive when `h ≤ m`. -/
theorem falling_pos_of_le {h m : ℕ} (hhm : h ≤ m) :
    0 < falling h m := by
  induction h with
  | zero =>
      simp [falling]
  | succ h ih =>
      have hhm' : h ≤ m := by omega
      have hpos : 0 < m - h := by omega
      unfold falling
      rw [Finset.prod_range_succ]
      have ih' : 0 < ∏ i ∈ Finset.range h, (m - i) := by
        simpa [falling] using ih hhm'
      exact Nat.mul_pos ih' hpos

/-- If `p | m`, the interval length is positive and smaller than `p`, and `p`
occurs exactly once in `m`, then it occurs exactly once in the whole falling
product `m(m-1)...(m-h+1)`. -/
theorem falling_factorization_eq_one_of_short
    {m h p : ℕ}
    (hp : p.Prime) (hpdiv : p ∣ m)
    (hmfac : m.factorization p = 1)
    (hhpos : 0 < h) (hhp : h < p) (hhm : h ≤ m) :
    (falling h m).factorization p = 1 := by
  induction h with
  | zero =>
      omega
  | succ h ih =>
      by_cases hz : h = 0
      · subst h
        simpa [falling] using hmfac
      · have hhpos' : 0 < h := Nat.pos_of_ne_zero hz
        have hhp' : h < p := by omega
        have hhm' : h ≤ m := by omega
        have hltm : h < m := by omega
        have hnotdvd : ¬ p ∣ (m - h) := by
          intro hd
          have hpi : p ∣ h :=
            (Nat.dvd_sub_iff_right (by omega : h ≤ m) hpdiv).mp hd
          have hple : p ≤ h := Nat.le_of_dvd hhpos' hpi
          omega
        have hfac0 : (m - h).factorization p = 0 := by
          by_contra hne
          exact hnotdvd (Nat.dvd_of_factorization_pos hne)
        have hfallpos : 0 < falling h m := falling_pos_of_le hhm'
        have htermpos : 0 < m - h := by omega
        have hmul :
            (falling h m * (m - h)).factorization p =
              (falling h m).factorization p + (m - h).factorization p := by
          rw [Nat.factorization_mul (Nat.ne_of_gt hfallpos) (Nat.ne_of_gt htermpos)]
          rfl
        have hrec : falling (Nat.succ h) m = falling h m * (m - h) := by
          unfold falling
          rw [Finset.prod_range_succ]
        rw [hrec, hmul, ih hhpos' hhp' hhm', hfac0]

/-- Specialization to the paper's largest prime at a squarefree endpoint. -/
theorem A_falling_largestPrime_factorization_eq_one
    {m d : ℕ} (hmA : m ∈ A) (hm : 1 < m)
    (hdm : d < m) (hgap : m - d < largestPrime m) :
    (falling (m - d) m).factorization (largestPrime m) = 1 := by
  apply falling_factorization_eq_one_of_short
      (hp := largestPrime_prime hm)
      (hpdiv := largestPrime_dvd hm)
      (hmfac := A_largestPrime_factorization_eq_one hmA hm)
  · omega
  · exact hgap
  · omega

/-- A two-factor representation is impossible as soon as the largest-prime
gap inequality has been established. -/
theorem no_two_rep_of_largePrime_gap
    {m d : ℕ} (hmA : m ∈ A) (hm : 1 < m)
    (hd : 1 ≤ d) (hdm : d < m)
    (hgap : m - d < largestPrime m) :
    ¬ NatSquare (d.factorial * m.factorial) := by
  intro hs
  have hsred : NatSquare (falling (m - d) m) :=
    (two_interval_reduction d m hd hdm).mp hs
  exact not_natSquare_of_prime_factorization_one
    (largestPrime_prime hm)
    (A_falling_largestPrime_factorization_eq_one hmA hm hdm hgap)
    hsred

/-- Three-factor exclusion once the largest prime is also absent from `q a`.
Repair 10 deliberately states that absence as an explicit hypothesis; deriving
it from the manuscript's bound on `a` is the next formalization step. -/
theorem no_three_rep_of_largePrime_gap
    {m a d : ℕ} (hmA : m ∈ A) (hm : 1 < m)
    (ha : 1 ≤ a) (had : a < d) (hdm : d < m)
    (hgap : m - d < largestPrime m)
    (hq0 : (q a).factorization (largestPrime m) = 0) :
    ¬ NatSquare (a.factorial * d.factorial * m.factorial) := by
  intro hs
  have hsred : NatSquare (q a * falling (m - d) m) :=
    (three_interval_reduction a d m ha had hdm).mp hs
  have hfall :
      (falling (m - d) m).factorization (largestPrime m) = 1 :=
    A_falling_largestPrime_factorization_eq_one hmA hm hdm hgap
  have hqne : q a ≠ 0 := q_ne_zero a
  have hfallne : falling (m - d) m ≠ 0 :=
    Nat.ne_of_gt (falling_pos_of_le (by omega : m - d ≤ m))
  have hprod :
      (q a * falling (m - d) m).factorization (largestPrime m) = 1 := by
    rw [Nat.factorization_mul hqne hfallne]
    change (q a).factorization (largestPrime m) +
      (falling (m - d) m).factorization (largestPrime m) = 1
    rw [hq0, hfall]
  exact not_natSquare_of_prime_factorization_one
    (largestPrime_prime hm) hprod hsred


/-! ## 6.8 Bounding the bottom factorial index in a three-factor representation

Repair 11 formalizes the algebraic and elementary size part of the manuscript's
estimate `a ≤ 3 ℓ log m + O(1)`.  It does not yet invoke the eventual lower
bound `exp(a/3) ≤ q a`; that analytic input is kept explicit.
-/

/-- A squarefree factor of a square product divides the other factor. -/
theorem squarefree_dvd_other_of_square {qv n : ℕ}
    (hqsf : Squarefree qv) (hs : NatSquare (qv * n)) :
    qv ∣ n := by
  apply hqsf.dvd_of_isSquare_mul
  exact (natSquare_iff_isSquare _).mp hs

/-- In particular, the factorial squarefree kernel divides the upper interval
product in every three-factor representation. -/
theorem q_dvd_falling_of_threeRep
    {m a d : ℕ} (ha : 1 ≤ a) (had : a < d) (hdm : d < m)
    (hs : NatSquare (a.factorial * d.factorial * m.factorial)) :
    q a ∣ falling (m - d) m := by
  have hsred : NatSquare (q a * falling (m - d) m) :=
    (three_interval_reduction a d m ha had hdm).mp hs
  apply squarefree_dvd_other_of_square (q_squarefree a)
  simpa [mul_assoc] using hsred

/-- Each factor in a falling product is at most the endpoint. -/
theorem falling_le_pow (h m : ℕ) :
    falling h m ≤ m ^ h := by
  induction h with
  | zero =>
      simp [falling]
  | succ h ih =>
      unfold falling
      rw [Finset.prod_range_succ, pow_succ]
      exact Nat.mul_le_mul ih (Nat.sub_le m h)

/-- Hence the factorial squarefree kernel is at most `m^ℓ` in a three-factor
representation. -/
theorem q_le_pow_of_threeRep
    {m a d : ℕ} (ha : 1 ≤ a) (had : a < d) (hdm : d < m)
    (hs : NatSquare (a.factorial * d.factorial * m.factorial)) :
    q a ≤ m ^ (m - d) := by
  have hqd : q a ∣ falling (m - d) m :=
    q_dvd_falling_of_threeRep ha had hdm hs
  have hfallpos : 0 < falling (m - d) m :=
    falling_pos_of_le (by omega : m - d ≤ m)
  have hqle : q a ≤ falling (m - d) m :=
    Nat.le_of_dvd hfallpos hqd
  exact hqle.trans (falling_le_pow (m - d) m)

/-- Real-valued form of the same elementary upper bound. -/
theorem q_real_le_pow_of_threeRep
    {m a d : ℕ} (ha : 1 ≤ a) (had : a < d) (hdm : d < m)
    (hs : NatSquare (a.factorial * d.factorial * m.factorial)) :
    (q a : ℝ) ≤ (m : ℝ) ^ (m - d : ℕ) := by
  exact_mod_cast q_le_pow_of_threeRep ha had hdm hs

/-- If the Lemma 3.1 growth estimate is available at index `a`, then a
three-factor representation forces the exponential lower bound for `q a`
below the elementary interval upper bound.  This is the exact inequality
used before taking logarithms in §6.1. -/
theorem exp_index_le_pow_of_threeRep
    {m a d : ℕ} (ha : 1 ≤ a) (had : a < d) (hdm : d < m)
    (hs : NatSquare (a.factorial * d.factorial * m.factorial))
    (hgrowth : Real.exp ((a : ℝ) / 3) ≤ (q a : ℝ)) :
    Real.exp ((a : ℝ) / 3) ≤ (m : ℝ) ^ (m - d : ℕ) := by
  exact hgrowth.trans (q_real_le_pow_of_threeRep ha had hdm hs)


/-! ## 6.9 Taking logarithms and excluding the largest prime from `q a`

Repair 12 carries the three-factor size argument through the logarithm step.
The only asymptotic ingredient still left explicit is the eventual numerical
dominance of `3 * m^eta * log m` by the large prime.
-/

/-- Taking logs in the exponential sandwich gives the manuscript's clean
bound `a ≤ 3 ℓ log m`, with `ℓ = m-d`. -/
theorem index_le_three_gap_log_of_threeRep
    {m a d : ℕ} (hm : 1 < m)
    (ha : 1 ≤ a) (had : a < d) (hdm : d < m)
    (hs : NatSquare (a.factorial * d.factorial * m.factorial))
    (hgrowth : Real.exp ((a : ℝ) / 3) ≤ (q a : ℝ)) :
    (a : ℝ) ≤ 3 * ((m - d : ℕ) : ℝ) * Real.log (m : ℝ) := by
  have h :=
    exp_index_le_pow_of_threeRep ha had hdm hs hgrowth
  have hmpos : 0 < (m : ℝ) := by
    exact_mod_cast (show 0 < m by omega)
  have hpowexp :
      (m : ℝ) ^ (m - d : ℕ) =
        Real.exp (((m - d : ℕ) : ℝ) * Real.log (m : ℝ)) := by
    calc
      (m : ℝ) ^ (m - d : ℕ) =
          (Real.exp (Real.log (m : ℝ))) ^ (m - d : ℕ) := by
            rw [Real.exp_log hmpos]
      _ = Real.exp (((m - d : ℕ) : ℝ) * Real.log (m : ℝ)) := by
            symm
            exact Real.exp_nat_mul (Real.log (m : ℝ)) (m - d)
  rw [hpowexp] at h
  have hlin :
      (a : ℝ) / 3 ≤ ((m - d : ℕ) : ℝ) * Real.log (m : ℝ) :=
    (Real.exp_le_exp).mp h
  linarith

/-- A prime larger than the factorial index is absent from the squarefree
kernel `q a`. -/
theorem q_factorization_eq_zero_of_index_lt_prime
    {a p : ℕ} (hp : p.Prime) (hap : a < p) :
    (q a).factorization p = 0 := by
  have hnotdvd_fact : ¬ p ∣ a.factorial := by
    rw [hp.dvd_factorial]
    omega
  have hfac0 : a.factorial.factorization p = 0 :=
    Nat.factorization_eq_zero_of_not_dvd hnotdvd_fact
  apply Nat.factorization_eq_zero_of_not_dvd
  intro hpdq
  have hodd := (prime_dvd_q_iff a p hp).mp hpdq
  rw [hfac0] at hodd
  norm_num at hodd

/-- Once the short-gap estimate and the elementary exponent-dominance
inequality are supplied, the bottom index is smaller than the largest prime. -/
theorem index_lt_largestPrime_of_threeRep
    {m a d : ℕ} (hm : 1 < m)
    (ha : 1 ≤ a) (had : a < d) (hdm : d < m)
    (hs : NatSquare (a.factorial * d.factorial * m.factorial))
    (hgrowth : Real.exp ((a : ℝ) / 3) ≤ (q a : ℝ))
    (hgapR : ((m - d : ℕ) : ℝ) ≤ (m : ℝ) ^ eta)
    (hdom :
      3 * (m : ℝ) ^ eta * Real.log (m : ℝ) <
        (largestPrime m : ℝ)) :
    a < largestPrime m := by
  have ha_bound :=
    index_le_three_gap_log_of_threeRep hm ha had hdm hs hgrowth
  have hlog_nonneg : 0 ≤ Real.log (m : ℝ) := by
    have hm1 : (1 : ℝ) ≤ m := by exact_mod_cast (show 1 ≤ m by omega)
    exact Real.log_nonneg hm1
  have h1 :
      3 * ((m - d : ℕ) : ℝ) * Real.log (m : ℝ) ≤
        3 * (m : ℝ) ^ eta * Real.log (m : ℝ) := by
    gcongr
  have haR : (a : ℝ) < (largestPrime m : ℝ) :=
    lt_of_le_of_lt (ha_bound.trans h1) hdom
  exact_mod_cast haR

/-- Therefore the largest prime is absent from `q a` under those same bounds. -/
theorem largestPrime_q_factorization_zero_of_threeRep
    {m a d : ℕ} (hm : 1 < m)
    (ha : 1 ≤ a) (had : a < d) (hdm : d < m)
    (hs : NatSquare (a.factorial * d.factorial * m.factorial))
    (hgrowth : Real.exp ((a : ℝ) / 3) ≤ (q a : ℝ))
    (hgapR : ((m - d : ℕ) : ℝ) ≤ (m : ℝ) ^ eta)
    (hdom :
      3 * (m : ℝ) ^ eta * Real.log (m : ℝ) <
        (largestPrime m : ℝ)) :
    (q a).factorization (largestPrime m) = 0 := by
  apply q_factorization_eq_zero_of_index_lt_prime
    (largestPrime_prime hm)
  exact index_lt_largestPrime_of_threeRep
    hm ha had hdm hs hgrowth hgapR hdom

/-- Full three-factor contradiction once the local gap inequality and the
eventual growth/dominance estimates have been supplied. -/
theorem no_three_rep_of_growth_bounds
    {m a d : ℕ} (hmA : m ∈ A) (hm : 1 < m)
    (ha : 1 ≤ a) (had : a < d) (hdm : d < m)
    (hs : NatSquare (a.factorial * d.factorial * m.factorial))
    (hgap : m - d < largestPrime m)
    (hgrowth : Real.exp ((a : ℝ) / 3) ≤ (q a : ℝ))
    (hgapR : ((m - d : ℕ) : ℝ) ≤ (m : ℝ) ^ eta)
    (hdom :
      3 * (m : ℝ) ^ eta * Real.log (m : ℝ) <
        (largestPrime m : ℝ)) :
    False := by
  have hq0 :
      (q a).factorization (largestPrime m) = 0 :=
    largestPrime_q_factorization_zero_of_threeRep
      hm ha had hdm hs hgrowth hgapR hdom
  exact no_three_rep_of_largePrime_gap
    hmA hm ha had hdm hgap hq0 hs


/-! ## 6.10 Fixed-exponent comparisons and direct exclusions from short-gap bounds

Repair 13 proves the exact numerical exponent comparisons used in §6.1 and
packages the two- and three-factor contradictions in a form that only needs
the short-gap and eventual growth/dominance inputs.
-/

theorem theta_lt_one_sub_alpha : theta < 1 - alpha := by
  norm_num [theta, alpha]

theorem eta_lt_one_sub_alpha : eta < 1 - alpha := by
  norm_num [eta, alpha]

/-- For every real base greater than one, the `theta` power is strictly below
the `(1-alpha)` power. -/
theorem rpow_theta_lt_rpow_one_sub_alpha {x : ℝ} (hx : 1 < x) :
    x ^ theta < x ^ (1 - alpha) := by
  have hxpos : 0 < x := lt_trans (by norm_num) hx
  rw [Real.rpow_def_of_pos hxpos, Real.rpow_def_of_pos hxpos]
  apply Real.exp_lt_exp.mpr
  have hlog : 0 < Real.log x := Real.log_pos hx
  nlinarith [theta_lt_one_sub_alpha]

/-- A `theta`-short upper gap is automatically shorter than the largest prime
for an endpoint in `B alpha`. -/
theorem gap_lt_largestPrime_of_B
    {m gap : ℕ} (hmB : m ∈ B alpha) (hm : 1 < m)
    (hgap : (gap : ℝ) ≤ (m : ℝ) ^ theta) :
    gap < largestPrime m := by
  have hmR : (1 : ℝ) < m := by exact_mod_cast hm
  have hpow :
      (m : ℝ) ^ theta < (m : ℝ) ^ (1 - alpha) :=
    rpow_theta_lt_rpow_one_sub_alpha hmR
  have hlarge :
      (m : ℝ) ^ (1 - alpha) < (largestPrime m : ℝ) :=
    hmB.2
  have hgapR : (gap : ℝ) < (largestPrime m : ℝ) :=
    lt_of_le_of_lt hgap (lt_trans hpow hlarge)
  exact_mod_cast hgapR

/-- If the standard eventual logarithmic dominance has already been reduced
to the concrete inequality below, membership in `B alpha` upgrades it to the
largest-prime dominance needed in Repair 12. -/
theorem log_dominance_to_largestPrime
    {m : ℕ} (hmB : m ∈ B alpha)
    (hdom :
      3 * (m : ℝ) ^ eta * Real.log (m : ℝ) <
        (m : ℝ) ^ (1 - alpha)) :
    3 * (m : ℝ) ^ eta * Real.log (m : ℝ) <
      (largestPrime m : ℝ) := by
  exact lt_trans hdom hmB.2

/-- Two-factor representations are ruled out directly from the `theta` short
gap estimate. -/
theorem no_two_square_of_B_shortGap
    {m d : ℕ} (hmB : m ∈ B alpha) (hm : 1 < m)
    (hd : 1 ≤ d) (hdm : d < m)
    (hs : NatSquare (d.factorial * m.factorial))
    (hshort : ((m - d : ℕ) : ℝ) ≤ (m : ℝ) ^ theta) :
    False := by
  have hgap : m - d < largestPrime m :=
    gap_lt_largestPrime_of_B hmB hm hshort
  exact no_two_rep_of_largePrime_gap hmB.1 hm hd hdm hgap hs

/-- Three-factor representations are ruled out from the `theta` short gap,
the Lemma 3.1 growth estimate at `a`, and the standard eventual logarithmic
dominance `3 m^eta log m < m^(1-alpha)`. -/
theorem no_three_square_of_B_bounds
    {m a d : ℕ} (hmB : m ∈ B alpha) (hm : 1 < m)
    (ha : 1 ≤ a) (had : a < d) (hdm : d < m)
    (hs : NatSquare (a.factorial * d.factorial * m.factorial))
    (hshortTheta : ((m - d : ℕ) : ℝ) ≤ (m : ℝ) ^ theta)
    (hshortEta : ((m - d : ℕ) : ℝ) ≤ (m : ℝ) ^ eta)
    (hgrowth : Real.exp ((a : ℝ) / 3) ≤ (q a : ℝ))
    (hdom :
      3 * (m : ℝ) ^ eta * Real.log (m : ℝ) <
        (m : ℝ) ^ (1 - alpha)) :
    False := by
  have hgap : m - d < largestPrime m :=
    gap_lt_largestPrime_of_B hmB hm hshortTheta
  have hdomP :
      3 * (m : ℝ) ^ eta * Real.log (m : ℝ) <
        (largestPrime m : ℝ) :=
    log_dominance_to_largestPrime hmB hdom
  exact no_three_rep_of_growth_bounds
    hmB.1 hm ha had hdm hs hgap hgrowth hshortEta hdomP

/-- A representation-level two-factor exclusion: once every two-factor
representation has the `theta` short gap, no such representation exists. -/
theorem no_HasRep_two_of_B_shortGap
    {m : ℕ} (hmB : m ∈ B alpha) (hm : 1 < m)
    (hshort :
      ∀ d : ℕ, 1 ≤ d → d < m →
        NatSquare (d.factorial * m.factorial) →
        ((m - d : ℕ) : ℝ) ≤ (m : ℝ) ^ theta) :
    ¬ HasRep m 2 := by
  intro hrep
  obtain ⟨d, hd, hdm, hs⟩ := two_of_hasRep hrep
  exact no_two_square_of_B_shortGap
    hmB hm hd hdm hs (hshort d hd hdm hs)

/-- Representation-level three-factor exclusion.  The remaining hypotheses
are exactly the global asymptotic inputs still to be connected to Lemma 3.1
and Lemma 6.1. -/
theorem no_HasRep_three_of_B_bounds
    {m : ℕ} (hmB : m ∈ B alpha) (hm : 1 < m)
    (hshortTheta :
      ∀ a d : ℕ, 1 ≤ a → a < d → d < m →
        NatSquare (a.factorial * d.factorial * m.factorial) →
        ((m - d : ℕ) : ℝ) ≤ (m : ℝ) ^ theta)
    (hshortEta :
      ∀ a d : ℕ, 1 ≤ a → a < d → d < m →
        NatSquare (a.factorial * d.factorial * m.factorial) →
        ((m - d : ℕ) : ℝ) ≤ (m : ℝ) ^ eta)
    (hgrowth :
      ∀ a d : ℕ, 1 ≤ a → a < d → d < m →
        NatSquare (a.factorial * d.factorial * m.factorial) →
        Real.exp ((a : ℝ) / 3) ≤ (q a : ℝ))
    (hdom :
      3 * (m : ℝ) ^ eta * Real.log (m : ℝ) <
        (m : ℝ) ^ (1 - alpha)) :
    ¬ HasRep m 3 := by
  intro hrep
  obtain ⟨a, d, ha, had, hdm, hs⟩ := three_of_hasRep hrep
  exact no_three_square_of_B_bounds
    hmB hm ha had hdm hs
    (hshortTheta a d ha had hdm hs)
    (hshortEta a d ha had hdm hs)
    (hgrowth a d ha had hdm hs)
    hdom


/-! ## 6.11 Wiring the global short-gap and growth inputs

Repair 14 packages the direct two- and three-factor exclusions from the
manuscript-level global inputs, rather than assuming `two_three` as a black box.
-/

theorem theta_lt_eta : theta < eta := by
  norm_num [theta, eta]

theorem rpow_theta_le_rpow_eta {x : ℝ} (hx : 1 ≤ x) :
    x ^ theta ≤ x ^ eta := by
  by_cases hxeq : x = 1
  · subst x
    simp
  · have hxgt : 1 < x := lt_of_le_of_ne hx (Ne.symm hxeq)
    have hxpos : 0 < x := lt_trans (by norm_num) hxgt
    rw [Real.rpow_def_of_pos hxpos, Real.rpow_def_of_pos hxpos]
    apply Real.exp_le_exp.mpr
    have hlog : 0 ≤ Real.log x := Real.log_nonneg hx
    nlinarith [theta_lt_eta]

/-- Extract the actual lower index from a two-factor representation together
with the uniform `theta` short-gap conclusion supplied by Lemma 6.1. -/
theorem two_of_hasRep_with_short
    {m : ℕ}
    (hshort :
      ∀ k : ℕ, ∀ hk : 2 ≤ k, ∀ r : Representation m k,
        ((m - r.index ⟨k - 2, by omega⟩ : ℕ) : ℝ) ≤
          (m : ℝ) ^ theta)
    (hrep : HasRep m 2) :
    ∃ d : ℕ, 1 ≤ d ∧ d < m ∧
      NatSquare (d.factorial * m.factorial) ∧
      ((m - d : ℕ) : ℝ) ≤ (m : ℝ) ^ theta := by
  obtain ⟨_, ⟨r⟩⟩ := hrep
  have he : r.index (1 : Fin 2) = m := r.endpoint 1 (by norm_num)
  have hs : NatSquare ((r.index 0).factorial * (r.index 1).factorial) := by
    simpa [Fin.prod_univ_succ, mul_assoc] using r.square
  have hg := hshort 2 (by decide) r
  refine ⟨r.index 0, r.positive 0, ?_, ?_, ?_⟩
  · simpa [he] using r.increasing (by decide : (0 : Fin 2) < 1)
  · simpa [he] using hs
  · simpa using hg

/-- Three-factor analogue, retaining the same second-largest index appearing
in the short-gap theorem. -/
theorem three_of_hasRep_with_short
    {m : ℕ}
    (hshort :
      ∀ k : ℕ, ∀ hk : 2 ≤ k, ∀ r : Representation m k,
        ((m - r.index ⟨k - 2, by omega⟩ : ℕ) : ℝ) ≤
          (m : ℝ) ^ theta)
    (hrep : HasRep m 3) :
    ∃ a d : ℕ, 1 ≤ a ∧ a < d ∧ d < m ∧
      NatSquare (a.factorial * d.factorial * m.factorial) ∧
      ((m - d : ℕ) : ℝ) ≤ (m : ℝ) ^ theta := by
  obtain ⟨_, ⟨r⟩⟩ := hrep
  have he : r.index (2 : Fin 3) = m := r.endpoint 2 (by norm_num)
  have hs : NatSquare ((r.index 0).factorial * (r.index 1).factorial *
      (r.index 2).factorial) := by
    simpa [Fin.prod_univ_succ, mul_assoc] using r.square
  have hg := hshort 3 (by decide) r
  refine ⟨r.index 0, r.index 1, r.positive 0,
    r.increasing (by decide : (0 : Fin 3) < 1), ?_, ?_, ?_⟩
  · simpa [he] using r.increasing (by decide : (1 : Fin 3) < 2)
  · simpa [he] using hs
  · simpa using hg


/-! ## 6.12 Deriving Corollary 6.2 and a reduced final proof interface

Repair 15 adds the other major piece of the final assembly: it derives the
four- and five-factor short-gap conclusions from the global second-largest-gap
input plus Corollary 4.3, and then builds a new final interface in which the
derived fields `short_four`, `short_five`, and `two_three` are no longer assumed.
-/

/-- An explicit four-factor `Representation`, so the second-largest index is
definitionally the paper's `d`. -/
def fourRepresentationOf {m b c d : ℕ} (hr : FourRep m b c d) :
    Representation m 4 := by
  rcases hr with ⟨hb, hbc, hcd, hdm, hs⟩
  refine {
    index := ![b, c, d, m]
    increasing := ?_
    positive := ?_
    endpoint := ?_
    square := ?_
  }
  · intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all <;> omega
  · intro i
    fin_cases i <;> simp_all <;> omega
  · intro i hi
    fin_cases i <;> simp_all
  · simpa [Fin.prod_univ_succ, mul_assoc] using hs

/-- The analogous explicit five-factor representation. -/
def fiveRepresentationOf {m a b c d : ℕ} (hr : FiveRep m a b c d) :
    Representation m 5 := by
  rcases hr with ⟨ha, hab, hbc, hcd, hdm, hs⟩
  refine {
    index := ![a, b, c, d, m]
    increasing := ?_
    positive := ?_
    endpoint := ?_
    square := ?_
  }
  · intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all <;> omega
  · intro i
    fin_cases i <;> simp_all <;> omega
  · intro i hi
    fin_cases i <;> simp_all
  · simpa [Fin.prod_univ_succ, mul_assoc] using hs

theorem fourRep_second_gap_from_short
    {m b c d : ℕ} (hr : FourRep m b c d)
    (hshort :
      ∀ k : ℕ, ∀ hk : 2 ≤ k, ∀ r : Representation m k,
        ((m - r.index ⟨k - 2, by omega⟩ : ℕ) : ℝ) ≤
          (m : ℝ) ^ theta) :
    ((m - d : ℕ) : ℝ) ≤ (m : ℝ) ^ theta := by
  have h := hshort 4 (by decide) (fourRepresentationOf hr)
  simpa [fourRepresentationOf] using h

theorem fiveRep_second_gap_from_short
    {m a b c d : ℕ} (hr : FiveRep m a b c d)
    (hshort :
      ∀ k : ℕ, ∀ hk : 2 ≤ k, ∀ r : Representation m k,
        ((m - r.index ⟨k - 2, by omega⟩ : ℕ) : ℝ) ≤
          (m : ℝ) ^ theta) :
    ((m - d : ℕ) : ℝ) ≤ (m : ℝ) ^ theta := by
  have h := hshort 5 (by decide) (fiveRepresentationOf hr)
  simpa [fiveRepresentationOf] using h

theorem rpow_theta_lt_rpow_eta {x : ℝ} (hx : 1 < x) :
    x ^ theta < x ^ eta := by
  have hxpos : 0 < x := lt_trans (by norm_num) hx
  rw [Real.rpow_def_of_pos hxpos, Real.rpow_def_of_pos hxpos]
  apply Real.exp_lt_exp.mpr
  have hlog : 0 < Real.log x := Real.log_pos hx
  nlinarith [theta_lt_eta]


/-! ## 6.13 Elementary asymptotics and noncomposite classification

Repair 16 discharges the two purely real-variable dominance tasks used in the
final gap cleanup.  It also reduces the density-zero statement for
noncomposites to the canonical density-zero statement for primes.
-/

open Filter Asymptotics

/-- Every noncomposite natural number is either 0, 1, or prime. -/
theorem noncomposite_small_or_prime {m : ℕ}
    (h : ¬ Composite m) :
    m < 2 ∨ m.Prime := by
  by_cases hm2 : 2 ≤ m
  · right
    rw [Nat.prime_iff_not_exists_mul_eq]
    refine ⟨hm2, ?_⟩
    rintro ⟨u, v, hu, hv, huv⟩
    have hu1 : u ≠ 1 := by
      intro huone
      subst u
      simp at huv
      omega
    have hv1 : v ≠ 1 := by
      intro hvone
      subst v
      simp at huv
      omega
    have hu2 : 2 ≤ u := by
      have hupos : 0 < u := by
        by_contra huz
        have : u = 0 := by omega
        subst u
        simp at huv
        omega
      omega
    have hv2 : 2 ≤ v := by
      have hvpos : 0 < v := by
        by_contra hvz
        have : v = 0 := by omega
        subst v
        simp at huv
        omega
      omega
    exact h ⟨u, v, hu2, hv2, huv.symm⟩
  · left
    omega


/-! ## 7. Granular specifications: statements, NOT established theorems
These give precise starting targets for the substantial unfinished formalization.
They are not installed as Lean axioms and are not claimed as proofs.
-/

namespace Tasks

/-- Elementary square-class properties needed to implement (1.4) and Lemma 3.3. -/
def FactorialSquareClasses : Prop :=
  (∀ a : ℕ, Squarefree (q a)) ∧
  (∀ a n : ℕ, NatSquare (a.factorial * n) ↔ NatSquare (q a * n))

/-- Exact two-interval reduction (1.4), with the four-factor case separate. -/
def IntervalReduction : Prop :=
  (∀ a b c d m : ℕ, 1 ≤ a → a < b → b < c → c < d → d < m →
    (NatSquare (a.factorial * b.factorial * c.factorial * d.factorial * m.factorial) ↔
      NatSquare (q a * falling (c - b) c * falling (m - d) m))) ∧
  (∀ b c d m : ℕ, 1 ≤ b → b < c → c < d → d < m →
    (NatSquare (b.factorial * c.factorial * d.factorial * m.factorial) ↔
      NatSquare (falling (c - b) c * falling (m - d) m)))

/-- The eventual exponential consequence of Lemma 3.1. This is not the full
asymptotic log q_a >= (1/2+o(1))a also stated in that lemma. -/
def FactorialClassGrowth : Prop :=
  ∃ N : ℕ, ∀ a : ℕ, N ≤ a → Real.exp ((a : ℝ) / 3) ≤ (q a : ℝ)

/-- Lemma 3.4; importantly this quantifies over all gcd conditions in A. -/
def CofactorInheritance : Prop :=
  ∀ α : ℝ, 0 < α → α < 1 / 2 → ∃ N : ℕ,
    ∀ r P : ℕ, N ≤ r * P → P.Prime →
      ((r * P : ℕ) : ℝ) ^ (1 - α) < (P : ℝ) →
      (r * P ∈ A ↔ r ∈ A)

/-- Lemma 4.1. The prime valuation must be exactly ONE, not merely positive. -/
def ValuationOneMass : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 1 → ∃ X₀ : ℕ,
    ∀ X a b c : ℕ, X₀ ≤ X → a < b → b < c → c ≤ X →
      (X : ℝ) ^ γ ≤ ((c - b : ℕ) : ℝ) →
      (a : ℝ) ≤ 10 * ((c - b : ℕ) : ℝ) * Real.log (X : ℝ) →
      ∃ R : ℕ, 0 < R ∧ Squarefree R ∧
        (∀ p : ℕ, p.Prime → p ∣ R →
          a < p ∧ (falling (c - b) c).factorization p = 1) ∧
        ((c - b : ℕ) : ℝ) / 4096 ≤ Real.log (R : ℝ)

/-- Corollary 4.3 for both four and five factors. -/
def IntervalLengthComparison : Prop :=
  ∀ γ : ℝ, 0 < γ → ∃ N : ℕ, ∀ m b c d : ℕ,
    N ≤ m → (FourRep m b c d ∨ ∃ a : ℕ, FiveRep m a b c d) →
    m - d ≤ c - b → (m : ℝ) ^ γ ≤ ((c - b : ℕ) : ℝ) →
    ((c - b : ℕ) : ℝ) ≤ 4096 * ((m - d : ℕ) : ℝ) * Real.log (m : ℝ)

/-- The polynomial f in (5.6), over Q. Good reduction still needs its own proof. -/
def anchorPolynomial (a r j t h ℓ : ℕ) : Polynomial ℚ :=
  Polynomial.C ((q a * r * j : ℕ) : ℚ) *
    (∏ i ∈ (Finset.range ℓ).filter (fun i => 1 ≤ i),
      (Polynomial.C (r : ℚ) * Polynomial.X - Polynomial.C (i : ℚ))) *
    (∏ v ∈ (Finset.range h).filter (fun v => v ≠ t),
      (Polynomial.C (j : ℚ) * Polynomial.X + Polynomial.C (t : ℚ) -
        Polynomial.C (v : ℚ)))

/-- Proposition 5.1 in explicit eventual-bound form, including ALL index choices.
The constants are uniform over endpoints and representations after fixing α,η. -/
def AnchorCounts (α η : ℝ) : Prop :=
  ∃ C₄ C₅ : ℝ, 0 < C₄ ∧ 0 < C₅ ∧ ∃ N : ℕ, ∀ X : ℕ, N ≤ X →
    (prefixCount (NonpairedFour α η) X : ℝ) ≤
      C₄ * (X : ℝ) ^ ((1 : ℝ) / 2 + 3 * α / 2 + 3 * η) * Real.log (X : ℝ) ∧
    (prefixCount (NonpairedFive α η) X : ℝ) ≤
      C₅ * (X : ℝ) ^ ((1 : ℝ) / 2 + 3 * α / 2 + 4 * η) * (Real.log (X : ℝ)) ^ 2

def UniformAnchorSieve : Prop :=
  ∀ α η : ℝ, 0 < α → 0 < η → 3 * α + 8 * η < 1 → AnchorCounts α η

/-- Lemma 6.1 with an endpoint exceptional set independent of representations.
Only its density-zero consequence is specified here, not the O(X/log X) rate. -/
def ShortSecondLargestGap : Prop :=
  ∃ E : Set ℕ, DensityZero E ∧ ∃ N : ℕ, ∀ m : ℕ, N ≤ m → m ∉ E →
    ∀ k : ℕ, ∀ hk : 2 ≤ k, ∀ r : Representation m k,
      ((m - r.index ⟨k - 2, by omega⟩ : ℕ) : ℝ) ≤ (m : ℝ) ^ theta

/-- Elementary eventual comparisons needed only in the direct two/three-factor
cleanup.  This deliberately isolates standard real asymptotics from the new
number-theoretic estimates. -/
def DirectExclusionDominance : Prop :=
  ∀ C : ℕ, ∃ N : ℕ, ∀ m : ℕ, N ≤ m →
    (C : ℝ) < (m : ℝ) ^ (1 - alpha) ∧
    3 * (m : ℝ) ^ eta * Real.log (m : ℝ) <
      (m : ℝ) ^ (1 - alpha)

/-- The elementary power/log separation used in Corollary 6.2. -/
def ShortGapDominance : Prop :=
  ∃ N : ℕ, ∀ m : ℕ, N ≤ m →
    4096 * (m : ℝ) ^ theta * Real.log (m : ℝ) <
      (m : ℝ) ^ eta

/-- Canonical PNT-level input used only to dispose of prime endpoints. -/
def PrimeDensityZero : Prop :=
  DensityZero {m : ℕ | m.Prime}

/-- Purely real-variable decay needed to convert the specialized anchor
counts into density-zero conclusions. -/
def FourAnchorDecayTask : Prop :=
  ∀ C : ℝ, 0 < C → ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ X : ℕ,
    N ≤ X →
      C * (X : ℝ) ^ ((7 : ℝ) / 8) * Real.log (X : ℝ) <
        ε * (X : ℝ)

def FiveAnchorDecayTask : Prop :=
  ∀ C : ℝ, 0 < C → ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ X : ℕ,
    N ≤ X →
      C * (X : ℝ) ^ ((199 : ℝ) / 200) *
          (Real.log (X : ℝ)) ^ 2 <
        ε * (X : ℝ)

end Tasks

/-! ## 6.14 Anchor-sieve specialization and density-zero packaging

Repair 17 pushes Proposition 5.1 much closer to the final ledger.  It proves
the exact specialized exponents, turns the uniform anchor theorem into the
two bounds actually used in §6.1, and isolates only the generic
power-times-log decay needed to convert those bounds into density-zero sets.
-/

theorem anchor_four_exponent :
    (1 : ℝ) / 2 + 3 * alpha / 2 + 3 * eta = 7 / 8 := by
  norm_num [alpha, eta]

theorem anchor_five_exponent :
    (1 : ℝ) / 2 + 3 * alpha / 2 + 4 * eta = 199 / 200 := by
  norm_num [alpha, eta]

theorem anchor_parameter_condition :
    3 * alpha + 8 * eta < 1 := by
  norm_num [alpha, eta]

/-- Specialize the uniform anchor sieve to the exact parameters used in the
paper, retaining the explicit eventual counting bounds. -/
theorem anchorCounts_chosen
    (hAnchor : Tasks.UniformAnchorSieve) :
    ∃ C₄ C₅ : ℝ, 0 < C₄ ∧ 0 < C₅ ∧ ∃ N : ℕ, ∀ X : ℕ, N ≤ X →
      (prefixCount (NonpairedFour alpha eta) X : ℝ) ≤
        C₄ * (X : ℝ) ^ ((7 : ℝ) / 8) * Real.log (X : ℝ) ∧
      (prefixCount (NonpairedFive alpha eta) X : ℝ) ≤
        C₅ * (X : ℝ) ^ ((199 : ℝ) / 200) *
          (Real.log (X : ℝ)) ^ 2 := by
  obtain ⟨C4, C5, hC4, hC5, N, hN⟩ :=
    hAnchor alpha eta (by norm_num [alpha]) (by norm_num [eta])
      anchor_parameter_condition
  refine ⟨C4, C5, hC4, hC5, N, ?_⟩
  intro X hX
  have h := hN X hX
  convert h using 1 <;> norm_num [alpha, eta]

/-- Readable aliases for the generic decay tasks. -/
abbrev FourAnchorDecay : Prop := Tasks.FourAnchorDecayTask
abbrev FiveAnchorDecay : Prop := Tasks.FiveAnchorDecayTask


/-- The four-factor anchor decay is elementary: `log x = o(x^(1/8))`. -/
theorem fourAnchorDecay_proved : Tasks.FourAnchorDecayTask := by
  intro C hC ε hε
  have hs : 0 < (1 / 8 : ℝ) := by norm_num
  have hlo :
      Real.log =o[atTop] (fun x : ℝ => x ^ (1 / 8 : ℝ)) :=
    isLittleO_log_rpow_atTop hs
  have hcoeff : 0 < ε / (2 * C) := by positivity
  have hboundR :
      ∀ᶠ x : ℝ in atTop,
        ‖Real.log x‖ ≤
          (ε / (2 * C)) * ‖x ^ (1 / 8 : ℝ)‖ :=
    hlo.def hcoeff
  have hboundN :
      ∀ᶠ n : ℕ in atTop,
        ‖Real.log (n : ℝ)‖ ≤
          (ε / (2 * C)) * ‖(n : ℝ) ^ (1 / 8 : ℝ)‖ :=
    tendsto_natCast_atTop_atTop.eventually hboundR
  have htwo : ∀ᶠ n : ℕ in atTop, 2 ≤ n := eventually_ge_atTop 2
  have hall :
      ∀ᶠ n : ℕ in atTop,
        C * (n : ℝ) ^ ((7 : ℝ) / 8) * Real.log (n : ℝ) <
          ε * (n : ℝ) := by
    filter_upwards [hboundN, htwo] with n hb hn2
    have hnR : (1 : ℝ) < n := by
      exact_mod_cast (show 1 < n by omega)
    have hnpos : 0 < (n : ℝ) := lt_trans (by norm_num) hnR
    have hlogpos : 0 < Real.log (n : ℝ) := Real.log_pos hnR
    have hp1 : 0 < (n : ℝ) ^ (1 / 8 : ℝ) :=
      Real.rpow_pos_of_pos hnpos _
    have hp7 : 0 < (n : ℝ) ^ ((7 : ℝ) / 8) :=
      Real.rpow_pos_of_pos hnpos _
    have hlogle :
        Real.log (n : ℝ) ≤
          (ε / (2 * C)) * (n : ℝ) ^ (1 / 8 : ℝ) := by
      change |Real.log (n : ℝ)| ≤
        (ε / (2 * C)) * |(n : ℝ) ^ (1 / 8 : ℝ)| at hb
      rw [abs_of_pos hlogpos, abs_of_pos hp1] at hb
      exact hb
    have hmul :
        C * (n : ℝ) ^ ((7 : ℝ) / 8) * Real.log (n : ℝ) ≤
          C * (n : ℝ) ^ ((7 : ℝ) / 8) *
            ((ε / (2 * C)) * (n : ℝ) ^ (1 / 8 : ℝ)) := by
      exact mul_le_mul_of_nonneg_left hlogle
        (le_of_lt (mul_pos hC hp7))
    have hpow :
        (n : ℝ) ^ ((7 : ℝ) / 8) *
            (n : ℝ) ^ (1 / 8 : ℝ) = (n : ℝ) := by
      rw [← Real.rpow_add hnpos]
      norm_num
    have hcoeffeq : C * (ε / (2 * C)) = ε / 2 := by
      field_simp [ne_of_gt hC]
    have heq :
        C * (n : ℝ) ^ ((7 : ℝ) / 8) *
            ((ε / (2 * C)) * (n : ℝ) ^ (1 / 8 : ℝ)) =
          (ε / 2) * (n : ℝ) := by
      calc
        C * (n : ℝ) ^ ((7 : ℝ) / 8) *
              ((ε / (2 * C)) * (n : ℝ) ^ (1 / 8 : ℝ))
            =
              (C * (ε / (2 * C))) *
                ((n : ℝ) ^ ((7 : ℝ) / 8) *
                  (n : ℝ) ^ (1 / 8 : ℝ)) := by ring
        _ = (ε / 2) *
              ((n : ℝ) ^ ((7 : ℝ) / 8) *
                (n : ℝ) ^ (1 / 8 : ℝ)) := by rw [hcoeffeq]
        _ = (ε / 2) * (n : ℝ) := by rw [hpow]
    rw [heq] at hmul
    have hhalf : (ε / 2) * (n : ℝ) < ε * (n : ℝ) := by
      nlinarith
    exact lt_of_le_of_lt hmul hhalf
  obtain ⟨N, hN⟩ := eventually_atTop.1 hall
  exact ⟨N, hN⟩

/-- The five-factor anchor decay is also elementary:
`(log x)^2 = o(x^(1/200))`. -/
theorem fiveAnchorDecay_proved : Tasks.FiveAnchorDecayTask := by
  intro C hC ε hε
  have hs : 0 < (1 / 200 : ℝ) := by norm_num
  have hlo :
      (fun x : ℝ => Real.log x ^ (2 : ℝ)) =o[atTop]
        (fun x : ℝ => x ^ (1 / 200 : ℝ)) :=
    isLittleO_log_rpow_rpow_atTop (2 : ℝ) hs
