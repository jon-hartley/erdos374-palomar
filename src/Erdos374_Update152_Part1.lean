namespace RemainingAnalytic20

/-- Finite truncation of the defining conditions of `A`. -/
def Afinite (B : ℕ) : Set ℕ :=
  {m | 1 ≤ m ∧ Squarefree m ∧
    ∀ a : ℕ, 2 ≤ a → a ≤ B → (Nat.gcd m (q a)) ^ 2 ≤ q a}

/-- Manuscript Lemma 3.2 reduced to its finite-condition densities,
uniform omitted-tail bound, and convergence of those finite densities. -/
structure ADensityApproximation where
  delta : ℝ
  delta_pos : 0 < delta
  approximate :
    ∀ ε : ℝ, 0 < ε →
      ∃ B : ℕ, ∃ δB : ℝ,
        HasDensity (Afinite B) δB ∧
        |δB - delta| < ε ∧
        ∀ X : ℕ, proportion (Afinite B \ A) X < ε

/-- Count-form PNT consequence.  This is deliberately stronger-looking than
`PrimeDensityZero` only because it is the form naturally produced by
π(X)=o(X). -/
def PrimeCountDecay : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ X : ℕ, N ≤ X →
    (prefixCount {m : ℕ | m.Prime} X : ℝ) < ε * (X : ℝ)

/-- The precise eventual logarithmic lower bound needed from Lemma 3.1. -/
def LogQGrowth : Prop :=
  ∃ N : ℕ, ∀ a : ℕ, N ≤ a →
    (a : ℝ) / 3 ≤ Real.log (q a : ℝ)

structure PNTConsequences where
  prime_count_decay : PrimeCountDecay
  log_q_growth : LogQGrowth

end RemainingAnalytic20

theorem A_subset_Afinite (B : ℕ) :
    A ⊆ RemainingAnalytic20.Afinite B := by
  intro m hm
  refine ⟨hm.1, hm.2.1, ?_⟩
  intro a ha hB
  exact hm.2.2 a ha

/-- Uniform convergence of the finite-condition approximants proves the
natural density of the full infinite-condition set `A`. -/
theorem A_density_of_approximation
    (H : RemainingAnalytic20.ADensityApproximation) :
    HasDensity A H.delta := by
  intro ε hε
  have he3 : 0 < ε / 3 := by linarith
  obtain ⟨B, δB, hfin, hδ, htail⟩ :=
    H.approximate (ε / 3) he3
  obtain ⟨N, hN⟩ := hfin (ε / 3) he3
  refine ⟨N, ?_⟩
  intro X hX
  have hf := abs_lt.mp (hN X hX)
  have hd := abs_lt.mp hδ
  have htailX := htail X
  have htail0 : 0 ≤ proportion
      (RemainingAnalytic20.Afinite B \ A) X :=
    proportion_nonneg _ _
  have hset :
      A ∩ RemainingAnalytic20.Afinite B = A :=
    Set.inter_eq_left.mpr (A_subset_Afinite B)
  have hpart :=
    proportion_inter_eq_sub A (RemainingAnalytic20.Afinite B) X
  rw [hset] at hpart
  apply abs_lt.mpr
  constructor <;> linarith

theorem prime_zero_of_count_decay
    (H : RemainingAnalytic20.PrimeCountDecay) :
    Tasks.PrimeDensityZero := by
  exact densityZero_of_eventual_count_lt H

theorem factorial_growth_of_log_q
    (H : RemainingAnalytic20.LogQGrowth) :
    Tasks.FactorialClassGrowth := by
  obtain ⟨N, hN⟩ := H
  refine ⟨N, ?_⟩
  intro a ha
  have hqa : 0 < q a := Nat.pos_of_ne_zero (q_ne_zero a)
  have hqaR : (0 : ℝ) < (q a : ℝ) := by
    exact_mod_cast hqa
  calc
    Real.exp ((a : ℝ) / 3)
        ≤ Real.exp (Real.log (q a : ℝ)) :=
      Real.exp_le_exp.mpr (hN a ha)
    _ = (q a : ℝ) := Real.exp_log hqaR

