/-! ## 33. Repair 34: final finite pass — anchor extraction and dyadic transfer

This section supplies the two remaining finite pieces explicitly.

* The anchor extraction follows manuscript (5.4)--(5.6): write
  `m = r P` with `P = P⁺(m)`, use `P² > m` to see that `P` occurs once in the
  upper falling product, force a lower occurrence by parity, and write
  `c = j P + t`, `0 ≤ t < h`.
* The dyadic transfer is stated and proved as the usual contraction argument
  for a positive exponent.

No `sorry` and no new axiom is introduced below.
-/

namespace RemainingAnalytic34

/-- Removing the zero-th factor from a positive falling product. -/
theorem falling_extract_zero
    {m ell : ℕ} (hell : 0 < ell) :
    falling ell m =
      m * (∏ i ∈ (Finset.range ell).filter (fun i => 1 ≤ i), (m - i)) := by
  classical
  unfold falling
  have hfilter :
      (Finset.range ell).filter (fun i => 1 ≤ i) =
        (Finset.range ell).erase 0 := by
    ext i
    simp
    omega
  rw [hfilter]
  have h0 : 0 ∈ Finset.range ell := by simp [hell]
  have hprod :=
    Finset.prod_erase_mul (Finset.range ell) (fun i => m - i) h0
  calc
    ∏ i ∈ Finset.range ell, (m - i)
        = (∏ i ∈ (Finset.range ell).erase 0, (m - i)) * (m - 0) := hprod.symm
    _ = m * (∏ i ∈ (Finset.range ell).erase 0, (m - i)) := by
          simp [mul_comm]

/-- Removing an arbitrary selected factor from a falling product. -/
theorem falling_extract_at
    {c h t : ℕ} (ht : t < h) :
    falling h c =
      (c - t) * (∏ v ∈ (Finset.range h).filter (fun v => v ≠ t), (c - v)) := by
  classical
  unfold falling
  have hfilter :
      (Finset.range h).filter (fun v => v ≠ t) =
        (Finset.range h).erase t := by
    ext v
    simp [and_comm]
  rw [hfilter]
  have htmem : t ∈ Finset.range h := Finset.mem_range.mpr ht
  have hprod :=
    Finset.prod_erase_mul (Finset.range h) (fun v => c - v) htmem
  calc
    ∏ v ∈ Finset.range h, (c - v)
        = (∏ v ∈ (Finset.range h).erase t, (c - v)) * (c - t) := hprod.symm
    _ = (c - t) * (∏ v ∈ (Finset.range h).erase t, (c - v)) := by
          exact Nat.mul_comm _ _

/-- Cofactor information supplied by a large largest-prime factor. -/
theorem largePrime_anchor_data
    {α : ℝ} {m : ℕ}
    (hm : 1 < m) (hα0 : 0 < α) (hαhalf : α < 1 / 2)
    (hLP : LargePrime α m) :
    let P := largestPrime m
    let r := m / P
    m = r * P ∧
    0 < r ∧
    r < P ∧
    (r : ℝ) < (m : ℝ) ^ α ∧
    m.factorization P = 1 := by
  let P := largestPrime m
  let r := m / P
  have hPprime : P.Prime := by
    dsimp [P]
    exact largestPrime_prime hm
  have hPpos : 0 < P := hPprime.pos
  have hPdiv : P ∣ m := by
    dsimp [P]
    exact largestPrime_dvd hm
  have hmr : m = r * P := by
    dsimp [r]
    symm
    exact Nat.div_mul_cancel hPdiv
  have hrpos : 0 < r := by
    by_contra hr
    have hr0 : r = 0 := Nat.eq_zero_of_not_pos hr
    rw [hr0, zero_mul] at hmr
    omega
  have hmR1 : (1 : ℝ) < m := by exact_mod_cast hm
  have hpow_lt :
      (m : ℝ) ^ α < (m : ℝ) ^ (1 - α) :=
    Real.rpow_lt_rpow_of_exponent_lt hmR1 (by linarith)
  have hLP' :
      (m : ℝ) ^ (1 - α) < (P : ℝ) := by
    simpa [LargePrime, P] using hLP
  have hr_lt_pow : (r : ℝ) < (m : ℝ) ^ α := by
    have hpowpos : 0 < (m : ℝ) ^ (1 - α) :=
      Real.rpow_pos_of_pos (by positivity) _
    have hmul :
        (r : ℝ) * (m : ℝ) ^ (1 - α) <
          (r : ℝ) * (P : ℝ) :=
      mul_lt_mul_of_pos_left hLP' (by exact_mod_cast hrpos)
    have hid :
        (m : ℝ) ^ α * (m : ℝ) ^ (1 - α) = (m : ℝ) := by
      calc
        (m : ℝ) ^ α * (m : ℝ) ^ (1 - α)
            = (m : ℝ) ^ (α + (1 - α)) := by
                rw [Real.rpow_add (by positivity : (0 : ℝ) < m)]
        _ = (m : ℝ) := by
              have : α + (1 - α) = (1 : ℝ) := by ring
              rw [this, Real.rpow_one]
    have hrP : (r : ℝ) * (P : ℝ) = (m : ℝ) := by
      exact_mod_cast hmr.symm
    by_contra hnot
    have hge : (m : ℝ) ^ α ≤ (r : ℝ) := le_of_not_gt hnot
    have hle0 :=
      mul_le_mul_of_nonneg_right hge (le_of_lt hpowpos)
    have hle :
        (m : ℝ) ≤ (r : ℝ) * (m : ℝ) ^ (1 - α) := by
      calc
        (m : ℝ) = (m : ℝ) ^ α * (m : ℝ) ^ (1 - α) := hid.symm
        _ ≤ (r : ℝ) * (m : ℝ) ^ (1 - α) := hle0
    rw [hrP] at hmul
    linarith
  have hrP_lt : (r : ℝ) < (P : ℝ) :=
    lt_trans hr_lt_pow (lt_trans hpow_lt hLP')
  have hrP_nat : r < P := by exact_mod_cast hrP_lt
  have hm_lt_P2 : m < P ^ 2 := by
    rw [hmr, pow_two]
    exact (Nat.mul_lt_mul_right hPpos).2 hrP_nat
  have hP2not : ¬ P ^ 2 ∣ m := by
    intro hdiv
    have hle : P ^ 2 ≤ m := Nat.le_of_dvd (by positivity) hdiv
    omega
  have hfac :
      m.factorization P = 1 :=
    factorization_eq_one_of_dvd_not_sq_dvd
      hPprime (Nat.ne_of_gt (by omega)) hPdiv hP2not
  exact ⟨hmr, hrpos, hrP_nat, hr_lt_pow, hfac⟩

/-- Under the Proposition-5.1 parameter inequality, both `α` and `η` are
strictly below `1-α`. -/
theorem anchor_exponent_margins
    {α η : ℝ} (hα : 0 < α) (hη : 0 < η)
    (hcond : 3 * α + 8 * η < 1) :
    α < 1 - α ∧ η < 1 - α := by
  constructor <;> linarith

/-- The largest prime is larger than either short gap. -/
theorem gap_lt_largestPrime
    {α η : ℝ} {m g : ℕ}
    (hm : 1 < m) (hη : 0 < η)
    (hexp : η < 1 - α)
    (hLP : LargePrime α m)
    (hg : (g : ℝ) ≤ (m : ℝ) ^ η) :
    g < largestPrime m := by
  have hmR1 : (1 : ℝ) < m := by exact_mod_cast hm
  have hpows :
      (m : ℝ) ^ η < (m : ℝ) ^ (1 - α) :=
    Real.rpow_lt_rpow_of_exponent_lt hmR1 hexp
  have hlarge :
      (m : ℝ) ^ (1 - α) < (largestPrime m : ℝ) := hLP
  exact_mod_cast lt_of_le_of_lt hg (lt_trans hpows hlarge)

/-- If the upper short interval contributes the largest prime exactly once,
squareness forces a lower-interval occurrence in the four-factor case. -/
theorem largestPrime_dvd_lower_four
    {m b c d : ℕ} {α : ℝ}
    (hm : 1 < m)
    (hLP : LargePrime α m)
    (hfac : m.factorization (largestPrime m) = 1)
    (hrep : FourRep m b c d)
    (hellP : m - d < largestPrime m) :
    largestPrime m ∣ falling (c - b) c := by
  rcases hrep with ⟨hb, hbc, hcd, hdm, hs⟩
  have hp := largestPrime_prime hm
  have hpdiv := largestPrime_dvd hm
  have hu :
      (falling (m - d) m).factorization (largestPrime m) = 1 :=
    falling_factorization_eq_one_of_short hp hpdiv hfac
      (by omega) hellP (by omega)
  have hsred :
      NatSquare (falling (c - b) c * falling (m - d) m) :=
    (four_interval_reduction b c d m hb hbc hcd hdm).mp hs
  by_contra hnot
  have hl0 :
      (falling (c - b) c).factorization (largestPrime m) = 0 :=
    Nat.factorization_eq_zero_of_not_dvd hnot
  have hlne : falling (c - b) c ≠ 0 :=
    Nat.ne_of_gt (falling_pos_of_le (by omega))
  have hune : falling (m - d) m ≠ 0 :=
    Nat.ne_of_gt (falling_pos_of_le (by omega))
  have hprod :
      (falling (c - b) c * falling (m - d) m).factorization
          (largestPrime m) = 1 := by
    rw [Nat.factorization_mul hlne hune]
    simp [hl0, hu]
  exact not_natSquare_of_prime_factorization_one hp hprod hsred

/-- Five-factor analogue; `a < P` removes the squarefree-kernel contribution. -/
theorem largestPrime_dvd_lower_five
    {m a b c d : ℕ}
    (hm : 1 < m)
    (hfac : m.factorization (largestPrime m) = 1)
    (haP : a < largestPrime m)
    (hrep : FiveRep m a b c d)
    (hellP : m - d < largestPrime m) :
    largestPrime m ∣ falling (c - b) c := by
  rcases hrep with ⟨ha, hab, hbc, hcd, hdm, hs⟩
  have hp := largestPrime_prime hm
  have hpdiv := largestPrime_dvd hm
  have hq0 :
      (q a).factorization (largestPrime m) = 0 :=
    q_factorization_eq_zero_of_index_lt_prime hp haP
  have hu :
      (falling (m - d) m).factorization (largestPrime m) = 1 :=
    falling_factorization_eq_one_of_short hp hpdiv hfac
      (by omega) hellP (by omega)
  have hsred :
      NatSquare (q a * falling (c - b) c * falling (m - d) m) :=
    (five_interval_reduction a b c d m ha hab hbc hcd hdm).mp hs
  by_contra hnot
  have hl0 :
      (falling (c - b) c).factorization (largestPrime m) = 0 :=
    Nat.factorization_eq_zero_of_not_dvd hnot
  have hqne : q a ≠ 0 := q_ne_zero a
  have hlne : falling (c - b) c ≠ 0 :=
    Nat.ne_of_gt (falling_pos_of_le (by omega))
  have hune : falling (m - d) m ≠ 0 :=
    Nat.ne_of_gt (falling_pos_of_le (by omega))
  have hprod :
      (q a * falling (c - b) c * falling (m - d) m).factorization
          (largestPrime m) = 1 := by
    rw [Nat.factorization_mul (Nat.mul_ne_zero hqne hlne) hune]
    rw [Nat.factorization_mul hqne hlne]
    simp [hq0, hl0, hu]
  exact not_natSquare_of_prime_factorization_one hp hprod hsred

/-- A prime divisor of a falling product occurs at one of its factors. -/
theorem exists_factor_dvd_of_prime_dvd_falling
    {p h c : ℕ} (hp : p.Prime) (hdiv : p ∣ falling h c) :
    ∃ t : ℕ, t < h ∧ p ∣ c - t := by
  unfold falling at hdiv
  have hp' : Prime p := (Nat.prime_iff).mp hp
  rcases (Prime.dvd_finsetProd_iff hp' (fun t => c - t)).mp hdiv with
    ⟨t, ht, hpt⟩
  exact ⟨t, Finset.mem_range.mp ht, hpt⟩

/-- Turn the selected lower factor into the manuscript variables `j,t`. -/
theorem lower_anchor_coordinates_prime
    {p h c m r : ℕ}
    (hpp : p.Prime) (hrm : m = r * p)
    (hhc : h ≤ c) (hcm : c < m)
    (hdiv : p ∣ falling h c) :
    ∃ j t : ℕ, 0 < j ∧ j < r ∧ t < h ∧ c = j * p + t := by
  obtain ⟨t, hth, hpt⟩ :=
    exists_factor_dvd_of_prime_dvd_falling hpp hdiv
  let j := (c - t) / p
  have hp : 0 < p := hpp.pos
  have htc : t < c := lt_of_lt_of_le hth hhc
  have hsubpos : 0 < c - t := Nat.sub_pos_iff_lt.mpr htc
  have hjp : j * p = c - t := by
    dsimp [j]
    exact Nat.div_mul_cancel hpt
  have hcform : c = j * p + t := by omega
  have hjpos : 0 < j := by
    by_contra hj
    have hj0 : j = 0 := Nat.eq_zero_of_not_pos hj
    rw [hj0, zero_mul] at hjp
    omega
  have hjlt : j < r := by
    have hmul : j * p < r * p := by
      rw [← hrm]
      omega
    exact (Nat.mul_lt_mul_right hp).mp hmul
  exact ⟨j, t, hjpos, hjlt, hth, hcform⟩

/-- Rational evaluation identity behind (5.6). -/
theorem anchor_eval_identity
    {a r j t h ell P c m : ℕ}
    (hP : 0 < P)
    (hhc : h ≤ c) (hellm : ell ≤ m)
    (hm : m = r * P)
    (hc : c = j * P + t)
    (ht : t < h) (hell : 0 < ell) :
    (Tasks.anchorPolynomial a r j t h ell).eval (P : ℚ) * (P : ℚ) ^ 2 =
      ((q a * falling h c * falling ell m : ℕ) : ℚ) := by
  classical
  have hup := falling_extract_zero (m := m) (ell := ell) hell
  have hlow := falling_extract_at (c := c) (h := h) (t := t) ht
  have hct : c - t = j * P := by omega
  have hup' :
      falling ell m =
        (r * P) *
          (∏ i ∈ (Finset.range ell).filter (fun i => 1 ≤ i),
            (r * P - i)) := by
    simpa [hm] using hup
  have hlow' :
      falling h c =
        (j * P) *
          (∏ v ∈ (Finset.range h).filter (fun v => v ≠ t),
            (j * P + t - v)) := by
    simpa [hc, hct] using hlow
  have hprodIeval :
      (∏ i ∈ (Finset.range ell).filter (fun i => 1 ≤ i),
        (Polynomial.C (r : ℚ) * Polynomial.X - Polynomial.C (i : ℚ))).eval (P : ℚ)
      =
      ((∏ i ∈ (Finset.range ell).filter (fun i => 1 ≤ i),
        (r * P - i) : ℕ) : ℚ) := by
    rw [Polynomial.eval_prod, Nat.cast_prod]
    apply Finset.prod_congr rfl
    intro i hi
    have hir : i < ell := Finset.mem_range.mp (Finset.mem_filter.mp hi).1
    have him : i ≤ r * P := by rw [← hm]; omega
    simp [Polynomial.eval_sub, Polynomial.eval_mul, Nat.cast_sub him, Nat.cast_mul]
  have hprodVeval :
      (∏ v ∈ (Finset.range h).filter (fun v => v ≠ t),
        (Polynomial.C (j : ℚ) * Polynomial.X + Polynomial.C (t : ℚ) -
          Polynomial.C (v : ℚ))).eval (P : ℚ)
      =
      ((∏ v ∈ (Finset.range h).filter (fun v => v ≠ t),
        (j * P + t - v) : ℕ) : ℚ) := by
    rw [Polynomial.eval_prod, Nat.cast_prod]
    apply Finset.prod_congr rfl
    intro v hv
    have hvr : v < h := Finset.mem_range.mp (Finset.mem_filter.mp hv).1
    have hvc : v ≤ j * P + t := by rw [← hc]; omega
    simp [Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_mul,
      Nat.cast_sub hvc, Nat.cast_add, Nat.cast_mul]
  rw [hup', hlow']
  unfold Tasks.anchorPolynomial
  simp only [Polynomial.eval_mul, Polynomial.eval_C]
  rw [hprodIeval, hprodVeval]
  push_cast
  ring

/-- A reduced square therefore makes `P` a square argument of the anchor
polynomial. -/
theorem anchor_square_value_of_reduced_square
    {a r j t h ell P c m : ℕ}
    (hP : 0 < P)
    (hhc : h ≤ c) (hellm : ell ≤ m)
    (hm : m = r * P)
    (hc : c = j * P + t)
    (ht : t < h) (hell : 0 < ell)
    (hsq : NatSquare (q a * falling h c * falling ell m)) :
    RemainingAnalytic28.RatSquare
      ((Tasks.anchorPolynomial a r j t h ell).eval (P : ℚ)) := by
  obtain ⟨z, hz⟩ := hsq
  refine ⟨(z : ℚ) / (P : ℚ), ?_⟩
  have hPq : (P : ℚ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hP)
  have hid :=
    anchor_eval_identity (a := a) (r := r) (j := j) (t := t)
      (h := h) (ell := ell) (P := P) (c := c) (m := m)
      hP hhc hellm hm hc ht hell
  rw [hz] at hid
  rw [div_pow]
  apply (mul_left_cancel₀ (show (P : ℚ) ^ 2 ≠ 0 by positivity))
  field_simp [hPq]
  simpa [mul_assoc, mul_comm, mul_left_comm] using hid

/-- Four-factor version (`q 0 = 1`). -/
theorem anchor_square_value_four
    {r j t h ell P c m : ℕ}
    (hP : 0 < P)
    (hhc : h ≤ c) (hellm : ell ≤ m)
    (hm : m = r * P)
    (hc : c = j * P + t)
    (ht : t < h) (hell : 0 < ell)
    (hsq : NatSquare (falling h c * falling ell m)) :
    RemainingAnalytic28.RatSquare
      ((Tasks.anchorPolynomial 0 r j t h ell).eval (P : ℚ)) := by
  have hs :
      NatSquare (q 0 * falling h c * falling ell m) := by
    simpa using hsq
  exact anchor_square_value_of_reduced_square
    hP hhc hellm hm hc ht hell hs

/-- The natural cofactor is bounded by `X^α` on the dyadic block. -/
theorem cofactor_le_Xpow
    {α : ℝ} {m X r : ℕ}
    (hα : 0 < α)
    (hmX : m ≤ X)
    (hrm : (r : ℝ) < (m : ℝ) ^ α) :
    (r : ℝ) ≤ 2 * (X : ℝ) ^ α := by
  have hm0 : (0 : ℝ) ≤ m := by positivity
  have hmXR : (m : ℝ) ≤ X := by exact_mod_cast hmX
  have hpow :
      (m : ℝ) ^ α ≤ (X : ℝ) ^ α :=
    Real.rpow_le_rpow hm0 hmXR (le_of_lt hα)
  have hnon : 0 ≤ (X : ℝ) ^ α := by positivity
  linarith

/-- A gap bounded by `m^η` is bounded by `2 X^η` on `m ≤ X`. -/
theorem gap_le_twice_Xpow
    {η : ℝ} {m X g : ℕ}
    (hη : 0 < η)
    (hmX : m ≤ X)
    (hg : (g : ℝ) ≤ (m : ℝ) ^ η) :
    (g : ℝ) ≤ 2 * (X : ℝ) ^ η := by
  have hm0 : (0 : ℝ) ≤ m := by positivity
  have hmXR : (m : ℝ) ≤ X := by exact_mod_cast hmX
  have hpow :
      (m : ℝ) ^ η ≤ (X : ℝ) ^ η :=
    Real.rpow_le_rpow hm0 hmXR (le_of_lt hη)
  have hnon : 0 ≤ (X : ℝ) ^ η := by positivity
  linarith

/-- Full four-factor endpoint-to-anchor encoding. -/
theorem fourEndpointTupleCover_proved :
    RemainingAnalytic33.FourEndpointTupleCover := by
  intro α η hα hη hcond
  refine ⟨4, ?_⟩
  intro X m hX hmhalf hmX hmNP
  rcases hmNP with
    ⟨hLP, b, c, d, hrep, hnonpair, hhbd, hellbd⟩
  rcases hrep with ⟨hb, hbc, hcd, hdm, hsquare⟩
  have hm : 1 < m := by omega
  have hαhalf : α < 1 / 2 := by linarith
  have hmarg := anchor_exponent_margins hα hη hcond
  let P := largestPrime m
  let r := m / P
  have hdata :
      m = r * P ∧ 0 < r ∧ r < P ∧
      (r : ℝ) < (m : ℝ) ^ α ∧
      m.factorization P = 1 := by
    simpa [P, r] using
      largePrime_anchor_data hm hα hαhalf hLP
  rcases hdata with ⟨hmr, hrpos, hrP, hrpow, hfac⟩
  let h := c - b
  let ell := m - d
  have hhpos : 0 < h := by dsimp [h]; omega
  have hellpos : 0 < ell := by dsimp [ell]; omega
  have hhellP : ell < P := by
    dsimp [ell, P]
    exact gap_lt_largestPrime hm hη hmarg.2 hLP hellbd
  have hPdlow :
      P ∣ falling h c := by
    dsimp [h, ell, P] at *
    exact largestPrime_dvd_lower_four hm hLP hfac
      ⟨hb, hbc, hcd, hdm, hsquare⟩ hhellP
  have hPprime : P.Prime := by
    dsimp [P]
    exact largestPrime_prime hm
  obtain ⟨j, t, hjpos, hjr, hth, hcform⟩ :=
    lower_anchor_coordinates_prime hPprime hmr (by dsimp [h]; omega) (by omega) hPdlow
  let H := max h ell
  let R := r
  let T : RemainingAnalytic32.FourAnchorTuple :=
    { r := r, P := P, j := j, t := t, h := h, ell := ell, Parg := P }
  refine ⟨R, H, T, ?_, hmr, ?_, ?_⟩
  · constructor
    · refine ⟨?_, ?_, rfl, hjpos, hjr, hhpos, ?_, hellpos, ?_, hth, ?_⟩
      · exact hrpos
      · rfl
      · exact le_max_left _ _
      · exact le_max_right _ _
      · apply (Nat.le_div_iff_mul_le hrpos).2
        change P * r ≤ X
        rw [Nat.mul_comm, ← hmr]
        exact hmX
    · simp only [RemainingAnalytic28.AnchorSquareArgs, Finset.mem_filter,
        Finset.mem_Icc]
      refine ⟨⟨hPprime.one_le, ?_⟩, ?_⟩
      · apply (Nat.le_div_iff_mul_le hrpos).2
        change P * r ≤ X
        rw [Nat.mul_comm, ← hmr]
        exact hmX
      · have hsred :
            NatSquare (falling h c * falling ell m) := by
          dsimp [h, ell]
          exact (four_interval_reduction b c d m hb hbc hcd hdm).mp hsquare
        exact anchor_square_value_four
          hPprime.pos
          (by change c - b ≤ c; exact Nat.sub_le _ _)
          (by change m - d ≤ m; exact Nat.sub_le _ _)
          hmr hcform hth hellpos hsred
  · dsimp [R]
    exact cofactor_le_Xpow hα hmX hrpow
  · dsimp [H]
    have hhX :
        (h : ℝ) ≤ 2 * (X : ℝ) ^ η := by
      dsimp [h]
      exact gap_le_twice_Xpow hη hmX hhbd
    have hellX :
        (ell : ℝ) ≤ 2 * (X : ℝ) ^ η := by
      dsimp [ell]
      exact gap_le_twice_Xpow hη hmX hellbd
    rw [Nat.cast_max]
    exact max_le hhX hellX

/-! ### Five-factor bottom-index bound, fully closed -/

/-- `log 2` is positive, used only to absorb the finite initial `a`-range. -/
theorem log_two_pos : 0 < Real.log 2 := Real.log_pos (by norm_num)

/-- Full five-factor bottom-index estimate from `FactorialClassGrowth`. -/
theorem fiveAnchorBottomIndexBound_proved :
    RemainingAnalytic33.FiveAnchorBottomIndexBound := by
  intro hGrowth α η hα hη hcond
  obtain ⟨NG, hG⟩ := hGrowth
  let C : ℝ := max 6 ((NG : ℝ) / Real.log 2)
  have hC : 0 < C := by
    exact lt_of_lt_of_le (by norm_num : (0 : ℝ) < 6) (le_max_left _ _)
  refine ⟨C, hC, 2, ?_⟩
  intro X m a b c d hX hmhalf hmX hrep hh hell
  have hm1 : 1 < m := by omega
  have hX1 : 1 < X := by omega
  have hlogm : 0 < Real.log (m : ℝ) := Real.log_pos (by exact_mod_cast hm1)
  have hlogX : 0 < Real.log (X : ℝ) := Real.log_pos (by exact_mod_cast hX1)
  have hlogle : Real.log (m : ℝ) ≤ Real.log (X : ℝ) := by
    exact Real.strictMonoOn_log.monotoneOn
      (by exact Set.mem_Ioi.mpr (by positivity))
      (by exact Set.mem_Ioi.mpr (by positivity))
      (by exact_mod_cast hmX)
  have hmPow :
      (m : ℝ) ^ η ≤ (X : ℝ) ^ η :=
    Real.rpow_le_rpow (by positivity) (by exact_mod_cast hmX) (le_of_lt hη)
  by_cases haG : NG ≤ a
  · have hlarge :=
      five_index_le_three_gaps_log hm1 hrep (hG a haG)
    have hsum :
        (((c - b) + (m - d) : ℕ) : ℝ) ≤ 2 * (m : ℝ) ^ η := by
      push_cast
      linarith
    have h6 :
        (a : ℝ) ≤ 6 * (X : ℝ) ^ η * Real.log (X : ℝ) := by
      calc
        (a : ℝ)
            ≤ 3 * (((c - b) + (m - d) : ℕ) : ℝ) *
                Real.log (m : ℝ) := hlarge
        _ ≤ 6 * (m : ℝ) ^ η * Real.log (m : ℝ) := by
              have hLm0 : 0 ≤ Real.log (m : ℝ) := le_of_lt hlogm
              nlinarith
        _ ≤ 6 * (X : ℝ) ^ η * Real.log (X : ℝ) := by
              have hXm : 0 ≤ (m : ℝ) ^ η := by positivity
              have hXX : 0 ≤ (X : ℝ) ^ η := by positivity
              nlinarith [mul_le_mul hmPow hlogle
                (le_of_lt hlogm) hXX]
    have h6C : 6 ≤ C := le_max_left _ _
    have hnon : 0 ≤ (X : ℝ) ^ η * Real.log (X : ℝ) := by positivity
    calc
      (a : ℝ) ≤ 6 * ((X : ℝ) ^ η * Real.log (X : ℝ)) := by
        simpa [mul_assoc] using h6
      _ ≤ C * ((X : ℝ) ^ η * Real.log (X : ℝ)) :=
        mul_le_mul_of_nonneg_right h6C hnon
      _ = C * (X : ℝ) ^ η * Real.log (X : ℝ) := by ring
  · have haNG : a < NG := by omega
    have haR : (a : ℝ) ≤ (NG : ℝ) := by exact_mod_cast (Nat.le_of_lt haNG)
    have hlog2X : Real.log 2 ≤ Real.log (X : ℝ) := by
      exact Real.strictMonoOn_log.monotoneOn
        (by exact Set.mem_Ioi.mpr (by norm_num))
        (by exact Set.mem_Ioi.mpr (by positivity))
        (by exact_mod_cast hX)
    have hratio :
        (NG : ℝ) ≤ ((NG : ℝ) / Real.log 2) * Real.log (X : ℝ) := by
      have hlog2 : 0 < Real.log 2 := log_two_pos
      have hcoef0 : 0 ≤ (NG : ℝ) / Real.log 2 := by positivity
      calc
        (NG : ℝ) =
            ((NG : ℝ) / Real.log 2) * Real.log 2 := by
              field_simp [ne_of_gt hlog2]
        _ ≤ ((NG : ℝ) / Real.log 2) * Real.log (X : ℝ) :=
              mul_le_mul_of_nonneg_left hlog2X hcoef0
    have hpow1 : (1 : ℝ) ≤ (X : ℝ) ^ η :=
      Real.one_le_rpow (by exact_mod_cast (show 1 ≤ X by omega)) (le_of_lt hη)
    have hcoef : (NG : ℝ) / Real.log 2 ≤ C := le_max_right _ _
    have hnon : 0 ≤ (X : ℝ) ^ η * Real.log (X : ℝ) := by positivity
    calc
      (a : ℝ) ≤ (NG : ℝ) := haR
      _ ≤ ((NG : ℝ) / Real.log 2) * Real.log (X : ℝ) := hratio
      _ ≤ ((NG : ℝ) / Real.log 2) *
          ((X : ℝ) ^ η * Real.log (X : ℝ)) := by
            have hc0 : 0 ≤ (NG : ℝ) / Real.log 2 := by positivity
            nlinarith
      _ ≤ C * ((X : ℝ) ^ η * Real.log (X : ℝ)) :=
            mul_le_mul_of_nonneg_right hcoef hnon
      _ = C * (X : ℝ) ^ η * Real.log (X : ℝ) := by ring

/-- Eventually `6 m^η log m` lies below `m^(1-α)`. -/
theorem six_gaplog_lt_anchor_power
    {α η : ℝ} (hgap : η < 1 - α) :
    ∃ N : ℕ, ∀ m : ℕ, N ≤ m →
      6 * (m : ℝ) ^ η * Real.log (m : ℝ) <
        (m : ℝ) ^ (1 - α) := by
  let δ : ℝ := (1 - α) - η
  have hδ : 0 < δ := by dsimp [δ]; linarith
  have hlo :
      Real.log =o[atTop] (fun x : ℝ => x ^ δ) :=
    isLittleO_log_rpow_atTop hδ
  have hbR :
      ∀ᶠ x : ℝ in atTop,
        ‖Real.log x‖ ≤ (1 / 12 : ℝ) * ‖x ^ δ‖ :=
    hlo.def (by norm_num)
  have hbN :
      ∀ᶠ n : ℕ in atTop,
        ‖Real.log (n : ℝ)‖ ≤
          (1 / 12 : ℝ) * ‖(n : ℝ) ^ δ‖ :=
    tendsto_natCast_atTop_atTop.eventually hbR
  have htwo : ∀ᶠ n : ℕ in atTop, 2 ≤ n := eventually_ge_atTop 2
  have hall :
      ∀ᶠ n : ℕ in atTop,
        6 * (n : ℝ) ^ η * Real.log (n : ℝ) <
          (n : ℝ) ^ (1 - α) := by
    filter_upwards [hbN, htwo] with n hb hn
    have hn1 : (1 : ℝ) < n := by exact_mod_cast (show 1 < n by omega)
    have hnp : 0 < (n : ℝ) := by positivity
    have hlog : 0 < Real.log (n : ℝ) := Real.log_pos hn1
    have hδp : 0 < (n : ℝ) ^ δ := Real.rpow_pos_of_pos hnp _
    have hηp : 0 < (n : ℝ) ^ η := Real.rpow_pos_of_pos hnp _
    have hble :
        Real.log (n : ℝ) ≤ (1 / 12 : ℝ) * (n : ℝ) ^ δ := by
      simpa [Real.norm_eq_abs, abs_of_pos hlog, abs_of_pos hδp] using hb
    have hid :
