namespace RemainingAnalytic19

/-- Common conclusion of Lemma 4.1. -/
def ValuationMassConclusion (X a b c : ℕ) : Prop :=
  ∃ R : ℕ, 0 < R ∧ Squarefree R ∧
    (∀ p : ℕ, p.Prime → p ∣ R →
      a < p ∧ (falling (c - b) c).factorization p = 1) ∧
    ((c - b : ℕ) : ℝ) / 4096 ≤ Real.log (R : ℝ)

/-- Dense branch of Lemma 4.1 (§4.1). -/
def ValuationOneMassDense : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 1 → ∃ X₀ : ℕ,
    ∀ X a b c : ℕ,
      X₀ ≤ X → a < b → b < c → c ≤ X →
      (X : ℝ) ^ γ ≤ ((c - b : ℕ) : ℝ) →
      (a : ℝ) ≤ 10 * ((c - b : ℕ) : ℝ) * Real.log (X : ℝ) →
      (b : ℝ) ≤
        100 * ((c - b : ℕ) : ℝ) * (Real.log (X : ℝ)) ^ 2 →
      ValuationMassConclusion X a b c

/-- Sparse branch of Lemma 4.1 (§§4.2--4.4), including the reciprocal-prime
equidistribution transfer and the correlated continuous main term. -/
def ValuationOneMassSparse : Prop :=
  ∀ γ : ℝ, 0 < γ → γ < 1 → ∃ X₀ : ℕ,
    ∀ X a b c : ℕ,
      X₀ ≤ X → a < b → b < c → c ≤ X →
      (X : ℝ) ^ γ ≤ ((c - b : ℕ) : ℝ) →
      (a : ℝ) ≤ 10 * ((c - b : ℕ) : ℝ) * Real.log (X : ℝ) →
      100 * ((c - b : ℕ) : ℝ) * (Real.log (X : ℝ)) ^ 2 <
        (b : ℝ) →
      ValuationMassConclusion X a b c

/-- Proposition 3.5 as a reusable bridge: density of A plus cofactor
inheritance imply the chosen large-prime subfamily density. -/
def BDensityBridge : Prop :=
  ∀ δ : ℝ, HasDensity A δ → Tasks.CofactorInheritance →
    HasDensity (B alpha) (densityConstant δ)

/-- Corollary 4.3 bridge.  Its proof is elementary once Lemma 4.1 and the
factorial-class growth estimate are supplied; keeping it explicit isolates
exactly that remaining formalization step. -/
def IntervalComparisonBridge : Prop :=
  Tasks.ValuationOneMass →
  Tasks.FactorialClassGrowth →
  Tasks.IntervalLengthComparison

/-- Four-factor half of Proposition 5.1, before combining the two exponents
into one `AnchorCounts` object. -/
def FourAnchorUniform : Prop :=
  ∀ α η : ℝ, 0 < α → 0 < η → 3 * α + 8 * η < 1 →
    ∃ C : ℝ, 0 < C ∧ ∃ N : ℕ, ∀ X : ℕ, N ≤ X →
      (prefixCount (NonpairedFour α η) X : ℝ) ≤
        C * (X : ℝ) ^
          ((1 : ℝ) / 2 + 3 * α / 2 + 3 * η) *
          Real.log (X : ℝ)

/-- Five-factor half of Proposition 5.1. -/
def FiveAnchorUniform : Prop :=
  ∀ α η : ℝ, 0 < α → 0 < η → 3 * α + 8 * η < 1 →
    ∃ C : ℝ, 0 < C ∧ ∃ N : ℕ, ∀ X : ℕ, N ≤ X →
      (prefixCount (NonpairedFive α η) X : ℝ) ≤
        C * (X : ℝ) ^
          ((1 : ℝ) / 2 + 3 * α / 2 + 4 * η) *
          (Real.log (X : ℝ)) ^ 2

end RemainingAnalytic19

/-- The dense and sparse branches assemble to the exact Lemma 4.1 task. -/
theorem valuationOneMass_of_dense_sparse
    (hD : RemainingAnalytic19.ValuationOneMassDense)
    (hS : RemainingAnalytic19.ValuationOneMassSparse) :
    Tasks.ValuationOneMass := by
  intro γ hγ0 hγ1
  obtain ⟨ND, hND⟩ := hD γ hγ0 hγ1
  obtain ⟨NS, hNS⟩ := hS γ hγ0 hγ1
  refine ⟨max ND NS, ?_⟩
  intro X a b c hX hab hbc hcX hh ha
  have hXD : ND ≤ X := le_trans (le_max_left ND NS) hX
  have hXS : NS ≤ X := le_trans (le_max_right ND NS) hX
  by_cases hdense :
      (b : ℝ) ≤
        100 * ((c - b : ℕ) : ℝ) * (Real.log (X : ℝ)) ^ 2
  · exact hND X a b c hXD hab hbc hcX hh ha hdense
  · have hsparse :
        100 * ((c - b : ℕ) : ℝ) * (Real.log (X : ℝ)) ^ 2 <
          (b : ℝ) := lt_of_not_ge hdense
    exact hNS X a b c hXS hab hbc hcX hh ha hsparse

/-- The two halves of Proposition 5.1 combine to `UniformAnchorSieve`. -/
theorem uniformAnchor_of_four_five
    (h4 : RemainingAnalytic19.FourAnchorUniform)
    (h5 : RemainingAnalytic19.FiveAnchorUniform) :
    Tasks.UniformAnchorSieve := by
  intro α η hα hη hcond
  obtain ⟨C4, hC4, N4, hN4⟩ := h4 α η hα hη hcond
  obtain ⟨C5, hC5, N5, hN5⟩ := h5 α η hα hη hcond
  refine ⟨C4, C5, hC4, hC5, max N4 N5, ?_⟩
  intro X hX
  have hX4 : N4 ≤ X := le_trans (le_max_left N4 N5) hX
  have hX5 : N5 ≤ X := le_trans (le_max_right N4 N5) hX
  exact ⟨hN4 X hX4, hN5 X hX5⟩

